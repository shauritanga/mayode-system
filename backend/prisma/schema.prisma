  REQUESTED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Warehouse {
  id         String   @id @default(uuid())
  /// Owning cooperative; null = platform warehouse (Super Admin's own stock).
  mamcosId   String?  @map("mamcos_id")
  name       String
  location   String?
  capacityKg Float?   @map("capacity_kg")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  mamcos            Mamcos?            @relation(fields: [mamcosId], references: [id])
  keepers           WarehouseKeeper[]
  movements         StockMovement[]
  saleOrders        SaleOrder[]
  lots              Lot[]
  inventoryRecords  InventoryRecord[]
  collectionCentres CollectionCentre[]
  stockBatches      StockBatch[]
  goodsReceipts     GoodsReceipt[]
  processingRuns    ProcessingRun[]
  opsDispatches     OpsDispatch[]
  stockCounts       StockCount[]

  @@index([mamcosId])
  @@map("warehouses")
}

/// Assigns a user as keeper of one warehouse; keepers only act on that warehouse's orders.
model WarehouseKeeper {
  id          String   @id @default(uuid())
  warehouseId String   @map("warehouse_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user      User      @relation("WarehouseKeeperUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, userId])
  @@index([userId])
  @@map("warehouse_keepers")
}

/// Append-only. on-hand = IN + ADJUST - OUT; reserved = RESERVE - UNRESERVE; available = on-hand - reserved.
model StockMovement {
  id              String            @id @default(uuid())
  warehouseId     String            @map("warehouse_id")
  type            StockMovementType
  quantityKg      Float             @map("quantity_kg")
  refType         String?           @map("ref_type")
  refId           String?           @map("ref_id")
  note            String?
  createdByUserId String?           @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId, createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

model SaleOrder {
  id                      String          @id @default(uuid())
  /// Customer-facing reference the buyer shows the warehouse keeper.
  reference               String          @unique
  mamcosId                String?         @map("mamcos_id")
  buyerId                 String          @map("buyer_id")
  warehouseId             String          @map("warehouse_id")
  lotId                   String          @map("lot_id")
  quantityKg              Float           @map("quantity_kg")
  pricePerKg              Float           @map("price_per_kg")
  fairtradePremium        Float?          @map("fairtrade_premium")
  riceVariety             String?         @map("rice_variety")
  /// Grade the buyer bought; always the lot's grade, so the keeper loads exactly this rice.
  grade                   String?
  packaging               String?
  status                  SaleOrderStatus @default(RESERVED)
  needsTransport          Boolean         @default(false) @map("needs_transport")
  /// Approved credit term: stock may leave before payment is received.
  creditTermDays          Int?            @map("credit_term_days")
  creditApprovedByUserId  String?         @map("credit_approved_by_user_id")
  /// Manager override that allowed release while unpaid.
  releaseApprovedByUserId String?         @map("release_approved_by_user_id")
  releaseApprovedAt       DateTime?       @map("release_approved_at")
  notes                   String?
  saleId                  String?         @unique @map("sale_id")
  /// Buyer order / purchase agreement this reservation delivers against.
  buyerOrderId            String?         @map("buyer_order_id")
  agreementId             String?         @map("agreement_id")
  createdByUserId         String          @map("created_by_user_id")
  confirmedByUserId       String?         @map("confirmed_by_user_id")
  confirmedAt             DateTime?       @map("confirmed_at")
  releasedByUserId        String?         @map("released_by_user_id")
  releasedAt              DateTime?       @map("released_at")
  cancelledByUserId       String?         @map("cancelled_by_user_id")
  cancelledAt             DateTime?       @map("cancelled_at")
  cancelReason            String?         @map("cancel_reason")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  buyer     Buyer            @relation(fields: [buyerId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lot       Lot              @relation(fields: [lotId], references: [id])
  sale      Sale?            @relation(fields: [saleId], references: [id])
  events    SaleOrderEvent[]
  loads     OrderLoad[]

  @@index([mamcosId, status])
  @@index([warehouseId, status])
  @@map("sale_orders")
}

/// Who did what, when, to a sale order. Never updated or deleted.
model SaleOrderEvent {
  id          String           @id @default(uuid())
  orderId     String           @map("order_id")
  type        String // e.g. order.reserved, order.confirmed, order.released, delivery.assigned
  actorUserId String?          @map("actor_user_id")
  fromStatus  SaleOrderStatus? @map("from_status")
  toStatus    SaleOrderStatus? @map("to_status")
  note        String?
  data        Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  order SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("sale_order_events")
}

/// Atomic per-scope, per-year counter for sale-order references (upsert + increment).
model ReferenceCounter {
  key   String @id
  value Int    @default(0)

  @@map("reference_counters")
}

/// One truck loaded for a sale order. Buyers usually collect a large order over several trips, so
/// each trip is weighed on its own, and carries its own vehicle and delivery progress.
model OrderLoad {
  id              String         @id @default(uuid())
  saleOrderId     String         @map("sale_order_id")
  sequence        Int
  /// Weighbridge weight actually loaded; the stock ledger moves by this figure.
  weightKg        Float          @map("weight_kg")
  bagCount        Int?           @map("bag_count")
  vehiclePlate    String         @map("vehicle_plate")
  driverName      String         @map("driver_name")
  driverPhone     String?        @map("driver_phone")
  mode            DeliveryMode
  transporterName String?        @map("transporter_name")
  fee             Float?
  destination     String?
  status          DeliveryStatus @default(ASSIGNED)
  notes           String?
  loadedByUserId  String         @map("loaded_by_user_id")
  loadedAt        DateTime       @default(now()) @map("loaded_at")
  departedAt      DateTime?      @map("departed_at")
  deliveredAt     DateTime?      @map("delivered_at")
  receivedBy      String?        @map("received_by")
  proofNote       String?        @map("proof_note")

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  @@unique([saleOrderId, sequence])
  @@map("order_loads")
}

// ============================================================
// MAYODE OPERATIONS: products, warehouse batches, processing, customer
// orders, invoices, payments, dispatch, and Mayode Farms field work.
// Quantities are always in kilograms; stock is the sum of ledger rows.
// ============================================================

enum ProductCategory {
  PADDY
  PROCESSED
  BROKEN
  BYPRODUCT
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum ReceiptSource {
  MAYODE_FARM
  EXTERNAL_FARMER
}

enum ReceiptStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum InspectionResult {
  NOT_REQUIRED
  PASSED
  PARTIAL
  FAILED
}

enum LedgerType {
  RECEIPT
  PROCESS_OUT
  PROCESS_IN
  DISPATCH
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  WRITE_OFF
}

enum ProcessingKind {
  MILLING
  PACKAGING
}

enum ProcessingStatus {
  COMPLETED
  REVERSED
}

enum OutputKind {
  PRODUCT
  BROKEN
  BRAN
  HUSK
  OTHER
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
  CONVERTED
}

enum OpsOrderStatus {
  PENDING_ACCOUNTS_REVIEW
  RETURNED_TO_SALES
  APPROVED_FOR_INVOICING
  INVOICED
  CANCELLED
  COMPLETED
}

enum PayState {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum FulfilState {
  NOT_AUTHORIZED
  AUTHORIZED
  SHORTAGE
  ALLOCATED
  PARTIALLY_DISPATCHED
  DISPATCHED
}

enum OpsInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum OpsPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum OpsPaymentMethod {
  CONTROL_NUMBER
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  OTHER
}

enum OpsDispatchStatus {
  PREPARED
  RELEASED
  CANCELLED
}

enum OpsDeliveryState {
  NOT_DELIVERED
  DELIVERED
  EXCEPTION
}

enum FarmTaskType {
  TASK
  INSPECTION
}

enum FarmTaskStatus {
  ASSIGNED
  ACKNOWLEDGED
  IN_PROGRESS
  PENDING_REVIEW
  RETURNED
  REJECTED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FarmInputType {
  SEED
  FERTILIZER
  PESTICIDE
  HERBICIDE
  FUEL
  OTHER
}

enum InputMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum HarvestStatus {
  DRAFT
  SUBMITTED
  CLOSED
}

/// What Mayode sells and stores. Brands and sizes are data, never code.
model Product {
  id             String          @id @default(uuid())
  mamcosId       String?         @map("mamcos_id")
  code           String          @unique
  name           String
  brand          String?
  riceVariety    String?         @map("rice_variety")
  category       ProductCategory
  grade          String?
  packSizeKg     Float?          @map("pack_size_kg")
  unit           String          @default("kg")
  unitPrice      Float?          @map("unit_price")
  taxRatePercent Float           @default(0) @map("tax_rate_percent")
  reorderLevelKg Float?          @map("reorder_level_kg")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  batches        StockBatch[]
  receipts       GoodsReceipt[]
  outputs        ProcessingOutput[]
  quotationLines QuotationLine[]
  orderLines     OpsOrderLine[]

  @@index([mamcosId, category])
  @@map("products")
}

model Customer {
  id             String       @id @default(uuid())
  mamcosId       String?      @map("mamcos_id")
  reference      String       @unique
  type           CustomerType
  /// Full name for an individual, registered name for a business.
  name           String
  phone          String
  email          String?
  address        String?
  idNumber       String?      @map("id_number")
  contactPerson  String?      @map("contact_person")
  businessRegNo  String?      @map("business_reg_no")
  tin            String?
  vrn            String?
  billingAddress String?      @map("billing_address")
  notes          String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  quotations Quotation[]
  orders     OpsOrder[]

  @@index([mamcosId, name])
  @@index([phone])
  @@map("customers")
}

/// One identifiable quantity of rice: a delivery received, or something produced by processing.
model StockBatch {
  id                    String         @id @default(uuid())
  mamcosId              String?        @map("mamcos_id")
  reference             String         @unique
  productId             String         @map("product_id")
  warehouseId           String         @map("warehouse_id")
  /// Bay or stack inside the warehouse.
  storageLocation       String?        @map("storage_location")
  riceVariety           String?        @map("rice_variety")
  grade                 String?
  /// Set for paddy received from a farmer or Mayode farm.
  receiptId             String?        @unique @map("receipt_id")
  /// Set for rice produced by a processing run.
  processingRunId       String?        @map("processing_run_id")
  outputKind            OutputKind?    @map("output_kind")
  ownerType             StockOwnerType @default(COOPERATIVE) @map("owner_type")
  ownerFarmerId         String?        @map("owner_farmer_id")
  stockStatus           StockStatus    @default(AVAILABLE) @map("stock_status")
  statusReason          String?        @map("status_reason")
  statusChangedByUserId String?        @map("status_changed_by_user_id")
  statusChangedAt       DateTime?      @map("status_changed_at")
  /// What one kilogram cost the cooperative (TZS). Null = cost not set, so the batch is not valued in the books.
  unitCost              Float?         @map("unit_cost")
  createdAt             DateTime       @default(now()) @map("created_at")

  product         Product            @relation(fields: [productId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  receipt         GoodsReceipt?      @relation(fields: [receiptId], references: [id])
  run             ProcessingRun?     @relation("RunOutputs", fields: [processingRunId], references: [id])
  ledger          StockLedgerEntry[]
  statusEvents    StockStatusEvent[]
  stockCountLines StockCountLine[]
  inputs          ProcessingInput[]
  allocations     OrderAllocation[]
  dispatches      OpsDispatchLine[]

  @@index([productId, warehouseId])
  @@index([mamcosId])
  @@index([mamcosId, stockStatus])
  @@index([ownerType, ownerFarmerId])
  @@map("stock_batches")
}

enum StockCountStatus {
  COUNTING
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model StockCount {
  id               String           @id @default(uuid())
  mamcosId         String?          @map("mamcos_id")
  reference        String           @unique
  warehouseId      String           @map("warehouse_id")
  status           StockCountStatus @default(COUNTING)
  blind            Boolean          @default(true)
  note             String?
  createdByUserId  String           @map("created_by_user_id")
  approvedByUserId String?          @map("approved_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  submittedAt      DateTime?        @map("submitted_at")
  approvedAt       DateTime?        @map("approved_at")
  warehouse        Warehouse        @relation(fields: [warehouseId], references: [id])
  lines            StockCountLine[]

  @@index([mamcosId, status])
  @@index([warehouseId, createdAt])
  @@map("stock_counts")
}

model StockCountLine {
  id              String     @id @default(uuid())
  countId         String     @map("count_id")
  batchId         String     @map("batch_id")
  systemKg        Float      @map("system_kg")
  countedKg       Float?     @map("counted_kg")
  note            String?
  countedByUserId String?    @map("counted_by_user_id")
  countedAt       DateTime?  @map("counted_at")
  count           StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  batch           StockBatch @relation(fields: [batchId], references: [id])

  @@unique([countId, batchId])
  @@index([batchId])
  @@map("stock_count_lines")
}

enum StockOwnerType {
  COOPERATIVE
  FARMER
  CUSTOMER
  OTHER
}

enum StockStatus {
  AVAILABLE
  QUARANTINED
  DAMAGED
  REJECTED
}

model StockStatusEvent {
  id              String       @id @default(uuid())
  batchId         String       @map("batch_id")
  fromStatus      StockStatus? @map("from_status")
  toStatus        StockStatus  @map("to_status")
  reason          String
  createdByUserId String       @map("created_by_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  batch           StockBatch   @relation(fields: [batchId], references: [id])

  @@index([batchId, createdAt])
  @@map("stock_status_events")
}

/// The source of truth for physical stock. Rows are only ever added; a mistake is corrected by a new row.
model StockLedgerEntry {
  id               String     @id @default(uuid())
  batchId          String     @map("batch_id")
  warehouseId      String     @map("warehouse_id")
  type             LedgerType
  /// Signed: positive adds to the warehouse, negative removes.
  quantityKg       Float      @map("quantity_kg")
  refType          String?    @map("ref_type")
  refId            String?    @map("ref_id")
  reason           String?
  approvedByUserId String?    @map("approved_by_user_id")
  reversalOfId     String?    @unique @map("reversal_of_id")
  createdByUserId  String?    @map("created_by_user_id")
  createdAt        DateTime   @default(now()) @map("created_at")

  batch StockBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([warehouseId, createdAt])
  @@index([refType, refId])
  @@map("stock_ledger")
}

model GoodsReceipt {
  id                String           @id @default(uuid())
  mamcosId          String?          @map("mamcos_id")
  reference         String           @unique
  warehouseId       String           @map("warehouse_id")
  productId         String           @map("product_id")
  sourceType        ReceiptSource    @map("source_type")
  farmerId          String?          @map("farmer_id")
  /// Walk-in seller who is not a registered farmer.
  sellerName        String?          @map("seller_name")
  sellerPhone       String?          @map("seller_phone")
  farmId            String?          @map("farm_id")
  plotId            String?          @map("plot_id")
  cropCycleId       String?          @map("crop_cycle_id")
  harvestRecordId   String?          @map("harvest_record_id")
  harvestBatchRef   String?          @map("harvest_batch_ref")
  riceVariety       String?          @map("rice_variety")
  /// TZS per kg the cooperative pays. Set = the cooperative is buying this rice (it owns it and the purchase is booked); empty = held for the farmer.
  pricePerKg        Float?           @map("price_per_kg")
  /// Set when another record already booked this rice in the accounts (a farmer delivery), so the receipt must not book it again.
  valuedBySource    String?          @map("valued_by_source")
  receivedAt        DateTime         @map("received_at")
  grossKg           Float            @map("gross_kg")
  bags              Int?
  bagWeightKg       Float?           @map("bag_weight_kg")
  moisturePct       Float?           @map("moisture_pct")
  qualityGrade      String?          @map("quality_grade")
  inspection        InspectionResult @default(NOT_REQUIRED)
  rejectedKg        Float            @default(0) @map("rejected_kg")
  inspectionNotes   String?          @map("inspection_notes")
  notes             String?
  attachments       String[]
  status            ReceiptStatus    @default(DRAFT)
  receivedByUserId  String           @map("received_by_user_id")
  confirmedByUserId String?          @map("confirmed_by_user_id")
  confirmedAt       DateTime?        @map("confirmed_at")
  cancelReason      String?          @map("cancel_reason")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])
  farmer    Farmer?        @relation(fields: [farmerId], references: [id])
  farm      Farm?          @relation(fields: [farmId], references: [id])
  plot      Plot?          @relation(fields: [plotId], references: [id])
  cropCycle CropCycle?     @relation(fields: [cropCycleId], references: [id])
  harvest   HarvestRecord? @relation(fields: [harvestRecordId], references: [id])
  batch     StockBatch?

  @@index([mamcosId, status])
  @@index([farmerId])
  @@index([harvestRecordId])
  @@map("goods_receipts")
}

/// One milling or packaging job: batches in, products out, and whatever was lost.
model ProcessingRun {
  id               String           @id @default(uuid())
  mamcosId         String?          @map("mamcos_id")
  reference        String           @unique
  kind             ProcessingKind
  warehouseId      String           @map("warehouse_id")
  processedAt      DateTime         @map("processed_at")
  machine          String?
  operatorName     String?          @map("operator_name")
  operatorUserId   String?          @map("operator_user_id")
  inputKg          Float            @map("input_kg")
  outputKg         Float            @map("output_kg")
  /// Input minus every recorded output: unexplained loss or gain.
  lossKg           Float            @map("loss_kg")
  lossNote         String?          @map("loss_note")
  status           ProcessingStatus @default(COMPLETED)
  reversedAt       DateTime?        @map("reversed_at")
  reversedByUserId String?          @map("reversed_by_user_id")
  reverseReason    String?          @map("reverse_reason")
  createdByUserId  String           @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  inputs    ProcessingInput[]
  outputs   ProcessingOutput[]
  batches   StockBatch[]       @relation("RunOutputs")

  @@index([mamcosId, processedAt])
  @@map("processing_runs")
}

model ProcessingInput {
  id         String @id @default(uuid())
  runId      String @map("run_id")
  batchId    String @map("batch_id")
  quantityKg Float  @map("quantity_kg")

  run   ProcessingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  batch StockBatch    @relation(fields: [batchId], references: [id])

  @@index([runId])
  @@index([batchId])
  @@map("processing_inputs")
}

model ProcessingOutput {
  id                  String     @id @default(uuid())
  runId               String     @map("run_id")
  batchId             String?    @map("batch_id")
  productId           String?    @map("product_id")
  kind                OutputKind
  quantityKg          Float      @map("quantity_kg")
  destinationLocation String?    @map("destination_location")
  note                String?

  run     ProcessingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id])

  @@index([runId])
  @@map("processing_outputs")
}

model Quotation {
  id              String          @id @default(uuid())
  mamcosId        String?         @map("mamcos_id")
  reference       String          @unique
  customerId      String          @map("customer_id")
  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?       @map("valid_until")
  deliveryMode    String?         @map("delivery_mode")
  deliveryNote    String?         @map("delivery_note")
  notes           String?
  subtotal        Float           @default(0)
  discountTotal   Float           @default(0) @map("discount_total")
  taxTotal        Float           @default(0) @map("tax_total")
  total           Float           @default(0)
  /// Delivery charge from the AMCOS's Settings when the quotation is for delivery; already inside subtotal and total.
  deliveryFee     Float           @default(0) @map("delivery_fee")
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  customer Customer        @relation(fields: [customerId], references: [id])
  lines    QuotationLine[]
  order    OpsOrder?

  @@index([mamcosId, status])
  @@map("quotations")
}

model QuotationLine {
  id              String @id @default(uuid())
  quotationId     String @map("quotation_id")
  productId       String @map("product_id")
  quantity        Float
  unitPrice       Float  @map("unit_price")
  discountPercent Float  @default(0) @map("discount_percent")
  taxRatePercent  Float  @default(0) @map("tax_rate_percent")
  lineTotal       Float  @map("line_total")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_lines")
}

model OpsOrder {
  id                    String         @id @default(uuid())
  mamcosId              String?        @map("mamcos_id")
  reference             String         @unique
  customerId            String         @map("customer_id")
  quotationId           String?        @unique @map("quotation_id")
  status                OpsOrderStatus @default(PENDING_ACCOUNTS_REVIEW)
  paymentStatus         PayState       @default(UNPAID) @map("payment_status")
  fulfilState           FulfilState    @default(NOT_AUTHORIZED) @map("fulfil_state")
  deliveryMode          String?        @map("delivery_mode")
  deliveryNote          String?        @map("delivery_note")
  notes                 String?
  subtotal              Float          @default(0)
  discountTotal         Float          @default(0) @map("discount_total")
  taxTotal              Float          @default(0) @map("tax_total")
  total                 Float          @default(0)
  amountPaid            Float          @default(0) @map("amount_paid")
  createdByUserId       String         @map("created_by_user_id")
  reviewedByUserId      String?        @map("reviewed_by_user_id")
  reviewDecision        String?        @map("review_decision")
  reviewComment         String?        @map("review_comment")
  reviewedAt            DateTime?      @map("reviewed_at")
  authorizedByUserId    String?        @map("authorized_by_user_id")
  authorizedAt          DateTime?      @map("authorized_at")
  /// Set when accounts released goods before full payment.
  authorizationOverride String?        @map("authorization_override")
  shortageNote          String?        @map("shortage_note")
  /// Delivery charge taken from the AMCOS's Settings when the order is for delivery; already inside subtotal and total.
  deliveryFee           Float          @default(0) @map("delivery_fee")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  customer    Customer          @relation(fields: [customerId], references: [id])
  quotation   Quotation?        @relation(fields: [quotationId], references: [id])
  lines       OpsOrderLine[]
  events      OpsOrderEvent[]
  invoices    OpsInvoice[]
  payments    OpsPayment[]
  allocations OrderAllocation[]
  dispatches  OpsDispatch[]

  @@index([mamcosId, status])
  @@index([customerId])
  @@map("ops_orders")
}

model OpsOrderLine {
  id              String @id @default(uuid())
  orderId         String @map("order_id")
  productId       String @map("product_id")
  quantity        Float
  unitPrice       Float  @map("unit_price")
  discountPercent Float  @default(0) @map("discount_percent")
  taxRatePercent  Float  @default(0) @map("tax_rate_percent")
  lineTotal       Float  @map("line_total")
  dispatchedQty   Float  @default(0) @map("dispatched_qty")

  order         OpsOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id])
  allocations   OrderAllocation[]
  dispatchLines OpsDispatchLine[]

  @@index([orderId])
  @@map("ops_order_lines")
}

/// Who did what to an order, and when. Never updated or deleted.
model OpsOrderEvent {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  type        String
  actorUserId String?  @map("actor_user_id")
  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  order OpsOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("ops_order_events")
}

/// Stock set aside for an order line. Reserved = quantity - dispatched - released.
model OrderAllocation {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  orderLineId     String   @map("order_line_id")
  batchId         String   @map("batch_id")
  warehouseId     String   @map("warehouse_id")
  quantityKg      Float    @map("quantity_kg")
  dispatchedKg    Float    @default(0) @map("dispatched_kg")
  releasedKg      Float    @default(0) @map("released_kg")
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  order OpsOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line  OpsOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  batch StockBatch   @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([orderId])
  @@map("order_allocations")
}

model OpsInvoice {
  id                  String           @id @default(uuid())
  mamcosId            String?          @map("mamcos_id")
  invoiceNumber       String           @unique @map("invoice_number")
  orderId             String           @map("order_id")
  customerId          String           @map("customer_id")
  customerName        String           @map("customer_name")
  customerDetails     Json             @map("customer_details")
  status              OpsInvoiceStatus @default(ISSUED)
  subtotal            Float
  discountTotal       Float            @map("discount_total")
  taxTotal            Float            @map("tax_total")
  total               Float
  amountPaid          Float            @default(0) @map("amount_paid")
  invoiceDate         DateTime         @default(now()) @map("invoice_date")
  dueDate             DateTime?        @map("due_date")
  paymentInstructions String?          @map("payment_instructions")
  controlNumber       String?          @unique @map("control_number")
  controlNumberAt     DateTime?        @map("control_number_at")
  controlNumberSource String?          @map("control_number_source")
  voidReason          String?          @map("void_reason")
  issuedByUserId      String           @map("issued_by_user_id")
  sharedAt            DateTime?        @map("shared_at")
  createdAt           DateTime         @default(now()) @map("created_at")

  order    OpsOrder         @relation(fields: [orderId], references: [id])
  lines    OpsInvoiceLine[]
  payments OpsPayment[]

  @@index([orderId])
  @@index([mamcosId, status])
  @@map("ops_invoices")
}

model OpsInvoiceLine {
  id              String  @id @default(uuid())
  invoiceId       String  @map("invoice_id")
  description     String
  brand           String?
  quantity        Float
  unit            String
  unitPrice       Float   @map("unit_price")
  discountPercent Float   @default(0) @map("discount_percent")
  taxRatePercent  Float   @default(0) @map("tax_rate_percent")
  lineTotal       Float   @map("line_total")

  invoice OpsInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("ops_invoice_lines")
}

/// Money received against an invoice. A provider reference can only ever be recorded once.
model OpsPayment {
  id                String           @id @default(uuid())
  mamcosId          String?          @map("mamcos_id")
  invoiceId         String           @map("invoice_id")
  orderId           String           @map("order_id")
  amount            Float
  method            OpsPaymentMethod
  provider          String           @default("MANUAL")
  providerReference String           @map("provider_reference")
  status            OpsPaymentStatus @default(PENDING)
  paidAt            DateTime?        @map("paid_at")
  source            String           @default("MANUAL") // CALLBACK, RECONCILED or MANUAL
  payerName         String?          @map("payer_name")
  rawPayload        Json?            @map("raw_payload")
  recordedByUserId  String?          @map("recorded_by_user_id")
  confirmedByUserId String?          @map("confirmed_by_user_id")
  rejectReason      String?          @map("reject_reason")
  createdAt         DateTime         @default(now()) @map("created_at")

  invoice       OpsInvoice   @relation(fields: [invoiceId], references: [id])
  order         OpsOrder     @relation(fields: [orderId], references: [id])
  /// The money account this moved through; null = not assigned to one.
  cashAccountId String?      @map("cash_account_id")
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([orderId])
  @@map("ops_payments")
}

model OpsDispatch {
  id                 String            @id @default(uuid())
  mamcosId           String?           @map("mamcos_id")
  reference          String            @unique
  orderId            String            @map("order_id")
  invoiceId          String?           @map("invoice_id")
  warehouseId        String            @map("warehouse_id")
  status             OpsDispatchStatus @default(PREPARED)
  vehiclePlate       String            @map("vehicle_plate")
  driverName         String            @map("driver_name")
  driverPhone        String?           @map("driver_phone")
  transporter        String?
  dispatchAt         DateTime          @map("dispatch_at")
  releasedAt         DateTime?         @map("released_at")
  releasingOfficerId String            @map("releasing_officer_id")
  supervisorUserId   String?           @map("supervisor_user_id")
  supervisorName     String?           @map("supervisor_name")
  destination        String?
  notes              String?
  attachments        String[]
  releaseNoteNumber  String?           @unique @map("release_note_number")
  shareToken         String?           @unique @map("share_token")
  deliveryState      OpsDeliveryState  @default(NOT_DELIVERED) @map("delivery_state")
  deliveredAt        DateTime?         @map("delivered_at")
  receivedBy         String?           @map("received_by")
  deliveryNote       String?           @map("delivery_note")
  cancelReason       String?           @map("cancel_reason")
  createdAt          DateTime          @default(now()) @map("created_at")

  order     OpsOrder          @relation(fields: [orderId], references: [id])
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id])
  lines     OpsDispatchLine[]

  @@index([orderId])
  @@index([mamcosId, status])
  @@map("ops_dispatches")
}

model OpsDispatchLine {
  id          String @id @default(uuid())
  dispatchId  String @map("dispatch_id")
  orderLineId String @map("order_line_id")
  productId   String @map("product_id")
  batchId     String @map("batch_id")
  quantityKg  Float  @map("quantity_kg")
  packages    Int?

  dispatch  OpsDispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  orderLine OpsOrderLine @relation(fields: [orderLineId], references: [id])
  batch     StockBatch   @relation(fields: [batchId], references: [id])

  @@index([dispatchId])
  @@index([batchId])
  @@map("ops_dispatch_lines")
}

/// Stock sent between two warehouses; it is in transit until the other end receives it.
model StockTransfer {
  id               String    @id @default(uuid())
  mamcosId         String?   @map("mamcos_id")
  reference        String    @unique
  batchId          String    @map("batch_id")
  fromWarehouseId  String    @map("from_warehouse_id")
  toWarehouseId    String    @map("to_warehouse_id")
  quantityKg       Float     @map("quantity_kg")
  status           String    @default("IN_TRANSIT") // IN_TRANSIT, RECEIVED, CANCELLED
  receivedKg       Float?    @map("received_kg")
  note             String?
  sentByUserId     String    @map("sent_by_user_id")
  receivedByUserId String?   @map("received_by_user_id")
  sentAt           DateTime  @default(now()) @map("sent_at")
  receivedAt       DateTime? @map("received_at")

  @@index([mamcosId, status])
  @@map("stock_transfers")
}

// ---------------- Mayode Farms ----------------

model FarmTask {
  id                  String         @id @default(uuid())
  mamcosId            String?        @map("mamcos_id")
  reference           String         @unique
  type                FarmTaskType   @default(TASK)
  farmId              String         @map("farm_id")
  plotId              String?        @map("plot_id")
  cropCycleId         String?        @map("crop_cycle_id")
  activityType        String         @map("activity_type")
  title               String
  instructions        String?
  assigneeUserId      String         @map("assignee_user_id")
  assignedByUserId    String         @map("assigned_by_user_id")
  /// The person who reviews the work; never the assignee.
  reviewerUserId      String?        @map("reviewer_user_id")
  plannedStart        DateTime?      @map("planned_start")
  deadline            DateTime?
  expectedOutput      String?        @map("expected_output")
  requiredInputs      String?        @map("required_inputs")
  priority            TaskPriority   @default(NORMAL)
  attachments         String[]
  requireGps          Boolean        @default(true) @map("require_gps")
  geofenceM           Int            @default(300) @map("geofence_m")
  status              FarmTaskStatus @default(ASSIGNED)
  parentTaskId        String?        @map("parent_task_id")
  inspectionObjective String?        @map("inspection_objective")
  reviewDecision      String?        @map("review_decision")
  reviewComment       String?        @map("review_comment")
  reviewedAt          DateTime?      @map("reviewed_at")
  completedAt         DateTime?      @map("completed_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  farm           Farm                @relation(fields: [farmId], references: [id])
  plot           Plot?               @relation(fields: [plotId], references: [id])
  cropCycle      CropCycle?          @relation(fields: [cropCycleId], references: [id])
  parent         FarmTask?           @relation("FollowUps", fields: [parentTaskId], references: [id])
  followUps      FarmTask[]          @relation("FollowUps")
  checkIns       TaskCheckIn[]
  reports        TaskReport[]
  events         TaskEvent[]
  inspection     InspectionReport?
  inputMovements FarmInputMovement[]

  @@index([assigneeUserId, status])
  @@index([mamcosId, status])
  @@index([farmId, plotId])
  @@map("farm_tasks")
}

/// GPS evidence of a visit. Written once; there is no way to edit it.
model TaskCheckIn {
  id             String   @id @default(uuid())
  taskId         String   @map("task_id")
  userId         String   @map("user_id")
  kind           String   @default("CHECK_IN") // CHECK_IN or CHECK_OUT
  latitude       Float
  longitude      Float
  accuracyM      Float?   @map("accuracy_m")
  /// The phone's clock (may be offline) versus when the server received it.
  deviceTime     DateTime @map("device_time")
  serverTime     DateTime @default(now()) @map("server_time")
  referenceLat   Float?   @map("reference_lat")
  referenceLon   Float?   @map("reference_lon")
  distanceM      Float?   @map("distance_m")
  withinGeofence Boolean? @map("within_geofence")
  photoUrls      String[] @map("photo_urls")
  note           String?
  clientKey      String?  @unique @map("client_key")

  task FarmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, serverTime])
  @@map("task_check_ins")
}

/// What the worker says was done. Each resubmission after a return is a new row.
model TaskReport {
  id                String    @id @default(uuid())
  taskId            String    @map("task_id")
  submittedByUserId String    @map("submitted_by_user_id")
  actualStart       DateTime? @map("actual_start")
  actualEnd         DateTime? @map("actual_end")
  workDoneQty       Float?    @map("work_done_qty")
  workDoneUnit      String?   @map("work_done_unit")
  equipment         String?
  observations      String?
  incompleteReason  String?   @map("incomplete_reason")
  photoUrls         String[]  @map("photo_urls")
  inputs            Json?
  submittedAt       DateTime  @default(now()) @map("submitted_at")

  task FarmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_reports")
}

model TaskEvent {
  id          String   @id @default(uuid())
  taskId      String   @map("task_id")
  type        String
  actorUserId String?  @map("actor_user_id")
  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  task FarmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_events")
}

model InspectionReport {
  id              String   @id @default(uuid())
  taskId          String   @unique @map("task_id")
  cropCondition   String?  @map("crop_condition")
  growthStage     String?  @map("growth_stage")
  pests           String?
  diseases        String?
  soilWater       String?  @map("soil_water")
  observations    String?
  photoUrls       String[] @map("photo_urls")
  recommendations Json?
  submittedAt     DateTime @default(now()) @map("submitted_at")

  task FarmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("inspection_reports")
}

model FarmInputItem {
  id           String        @id @default(uuid())
  mamcosId     String?       @map("mamcos_id")
  name         String
  type         FarmInputType
  unit         String        @default("kg")
  unitCost     Float?        @map("unit_cost")
  reorderLevel Float?        @map("reorder_level")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")

  movements FarmInputMovement[]

  @@unique([mamcosId, name])
  @@map("farm_input_items")
}

model FarmInputMovement {
  id              String            @id @default(uuid())
  itemId          String            @map("item_id")
  type            InputMovementType
  /// Signed: stock in is positive, use is negative.
  quantity        Float
  taskId          String?           @map("task_id")
  farmId          String?           @map("farm_id")
  plotId          String?           @map("plot_id")
  cropCycleId     String?           @map("crop_cycle_id")
  employeeUserId  String?           @map("employee_user_id")
  note            String?
  createdByUserId String            @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  item FarmInputItem @relation(fields: [itemId], references: [id])
  task FarmTask?     @relation(fields: [taskId], references: [id])

  @@index([itemId])
  @@index([taskId])
  @@index([plotId, cropCycleId])
  @@map("farm_input_movements")
}

model HarvestRecord {
  id                String        @id @default(uuid())
  mamcosId          String?       @map("mamcos_id")
  reference         String        @unique
  batchRef          String        @unique @map("batch_ref")
  farmId            String        @map("farm_id")
  plotId            String?       @map("plot_id")
  cropCycleId       String        @map("crop_cycle_id")
  riceVariety       String?       @map("rice_variety")
  harvestDate       DateTime      @map("harvest_date")
  estimatedKg       Float?        @map("estimated_kg")
  actualKg          Float         @map("actual_kg")
  unit              String        @default("kg")
  team              String?
  responsibleUserId String?       @map("responsible_user_id")
  qualityNotes      String?       @map("quality_notes")
  destination       String        @default("WAREHOUSE")
  /// Declared when the load leaves the field for the warehouse.
  transportedKg     Float         @default(0) @map("transported_kg")
  transportNote     String?       @map("transport_note")
  status            HarvestStatus @default(SUBMITTED)
  createdByUserId   String        @map("created_by_user_id")
  createdAt         DateTime      @default(now()) @map("created_at")

  farm      Farm           @relation(fields: [farmId], references: [id])
  plot      Plot?          @relation(fields: [plotId], references: [id])
  cropCycle CropCycle      @relation(fields: [cropCycleId], references: [id])
  receipts  GoodsReceipt[]

  @@index([mamcosId, harvestDate])
  @@index([cropCycleId])
  @@map("harvest_records")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A farmer asking to be counted as a member of an AMCOS. Approval (by that AMCOS's admin) sets farmers.mamcos_id.
/// One pending request per farmer is enforced by a partial unique index in the migration.
model AmcosJoinRequest {
  id             String            @id @default(uuid())
  farmerId       String            @map("farmer_id")
  mamcosId       String            @map("mamcos_id")
  status         JoinRequestStatus @default(PENDING)
  decidedById    String?           @map("decided_by_id")
  decidedAt      DateTime?         @map("decided_at")
  rejectedReason String?           @map("rejected_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  mamcos Mamcos @relation(fields: [mamcosId], references: [id], onDelete: Restrict)

  @@index([mamcosId, status])
  @@index([farmerId])
  @@map("amcos_join_requests")
}

enum EquipmentType {
  TRACTOR
  POWER_TILLER
  COMBINE_HARVESTER
  THRESHER
  TRANSPLANTER
  SPRAYER
  TRUCK
  OTHER
}

enum EquipmentOwnership {
  AMCOS
  EXTERNAL
}

enum MachineryActivityType {
  PLOUGHING
  HARROWING
  LEVELLING
  TRANSPLANTING
  SPRAYING
  HARVESTING
  THRESHING
  TRANSPORT
  OTHER
}

enum MachineryActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityFeeStatus {
  NOT_APPLICABLE
  PENDING
  PAID
}

/// A machine the AMCOS works with: its own, or one owned by someone else and registered with the AMCOS, whose use
/// earns the AMCOS a contribution (fee_per_hectare is the default; each activity records the amount actually due).
model AmcosEquipment {
  id                    String             @id @default(uuid())
  mamcosId              String             @map("mamcos_id")
  name                  String
  /// Legacy fixed kind, kept so older records and reports still read; the AMCOS's own list (typeRef) is what screens show.
  type                  EquipmentType
  typeId                String?            @map("type_id")
  registrationNo        String?            @map("registration_no")
  ownership             EquipmentOwnership @default(AMCOS)
  ownerName             String?            @map("owner_name")
  ownerPhone            String?            @map("owner_phone")
  /// This tool's own contribution rate per hectare; null uses the AMCOS default rate.
  feePerHectare         Decimal?           @map("fee_per_hectare") @db.Decimal(12, 2)
  /// One-off fee for registering a tool owned by someone else; always 0 for the AMCOS's own tools.
  registrationFee       Decimal            @default(0) @map("registration_fee") @db.Decimal(12, 2)
  registrationFeeStatus ActivityFeeStatus  @default(NOT_APPLICABLE) @map("registration_fee_status")
  registrationFeePaidOn DateTime?          @map("registration_fee_paid_on") @db.Date
  isActive              Boolean            @default(true) @map("is_active")
  notes                 String?
  createdById           String?            @map("created_by_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  mamcos     Mamcos              @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  typeRef    AmcosEquipmentType? @relation(fields: [typeId], references: [id], onDelete: Restrict)
  activities MachineryActivity[]
  asset      Asset?

  @@unique([mamcosId, name])
  @@index([mamcosId, isActive])
  @@map("amcos_equipment")
}

/// One job done by a machine: ploughing, harvesting … Fees count toward AMCOS income only while the job is COMPLETED.
model MachineryActivity {
  id           String                  @id @default(uuid())
  mamcosId     String                  @map("mamcos_id")
  activityDate DateTime                @map("activity_date") @db.Date
  type         MachineryActivityType
  equipmentId  String                  @map("equipment_id")
  operatorName String?                 @map("operator_name")
  /// Optional link to the irrigation block worked; blockId is null for work done outside the scheme.
  blockId      String?                 @map("block_id")
  location     String?
  hectares     Decimal                 @db.Decimal(8, 2)
  feeAmount    Decimal                 @default(0) @map("fee_amount") @db.Decimal(12, 2)
  feeStatus    ActivityFeeStatus       @default(NOT_APPLICABLE) @map("fee_status")
  feePaidOn    DateTime?               @map("fee_paid_on") @db.Date
  status       MachineryActivityStatus @default(COMPLETED)
  notes        String?
  createdById  String?                 @map("created_by_id")
  updatedById  String?                 @map("updated_by_id")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  mamcos    Mamcos           @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  equipment AmcosEquipment   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  block     IrrigationBlock? @relation(fields: [blockId], references: [id], onDelete: Restrict)

  @@index([mamcosId, activityDate])
  @@index([equipmentId])
  @@index([blockId])
  @@map("machinery_activities")
}

enum CommunicationChannel {
  SMS
  EMAIL
  BOTH
}

enum CommunicationAudience {
  ALL
  SELECTED
  CANAL
  BLOCK
  BOARD
  STAFF
}

enum CommunicationStatus {
  SENDING
  COMPLETED
  INTERRUPTED
}

enum MessageChannel {
  SMS
  EMAIL
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  SIMULATED
  FAILED
  SKIPPED
}

/// A message an AMCOS admin sent to its farmers. One row per send; each farmer/channel outcome is a CommunicationRecipient.
model Communication {
  id              String                @id @default(uuid())
  mamcosId        String                @map("mamcos_id")
  channel         CommunicationChannel
  audience        CommunicationAudience
  /// Set for CANAL and BLOCK audiences.
  canalId         String?               @map("canal_id")
  blockId         String?               @map("block_id")
  /// Plain-words snapshot of who it went to, e.g. "Canal 1 · Block 3".
  audienceLabel   String?               @map("audience_label")
  subject         String?
  body            String
  status          CommunicationStatus   @default(SENDING)
  totalRecipients Int                   @default(0) @map("total_recipients")
  sentCount       Int                   @default(0) @map("sent_count")
  /// Recorded but not actually delivered, because the SMS or email provider is not configured.
  simulatedCount  Int                   @default(0) @map("simulated_count")
  failedCount     Int                   @default(0) @map("failed_count")
  skippedCount    Int                   @default(0) @map("skipped_count")
  sentById        String?               @map("sent_by_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  completedAt     DateTime?             @map("completed_at")

  mamcos     Mamcos                   @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  recipients CommunicationRecipient[]

  @@index([mamcosId, createdAt])
  @@map("communications")
}

model CommunicationRecipient {
  id              String                @id @default(uuid())
  communicationId String                @map("communication_id")
  /// Farmers and board members. Staff recipients have userId instead (a CHECK in the migration needs one of the two).
  farmerId        String?               @map("farmer_id")
  userId          String?               @map("user_id")
  recipientName   String?               @map("recipient_name")
  /// FARMER, BOARD or STAFF.
  recipientKind   String                @default("FARMER") @map("recipient_kind")
  channel         MessageChannel
  address         String?
  status          MessageDeliveryStatus @default(PENDING)
  error           String?
  sentAt          DateTime?             @map("sent_at")

  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  farmer        Farmer?       @relation(fields: [farmerId], references: [id], onDelete: Restrict)

  @@unique([communicationId, farmerId, channel], map: "communication_recipients_unique_per_channel")
  @@index([communicationId, status])
  @@index([farmerId])
  @@map("communication_recipients")
}

enum AssetCategory {
  MACHINERY_VEHICLE
  BUILDING_WAREHOUSE
  MILL_PROCESSING
  IRRIGATION_STRUCTURE
  SOLAR_POWER
  MEASURING_EQUIPMENT
  TOOLS
  OFFICE_IT
  FURNITURE
  OTHER
}

enum AssetFundingSource {
  AMCOS_FUNDS
  MEMBER_CONTRIBUTIONS
  GRANT
  LOAN
  DONATION
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  UNDER_REPAIR
}

enum AssetStatus {
  IN_USE
  IDLE
  DISPOSED
}

enum AssetMaintenanceKind {
  SERVICE
  REPAIR
  INSPECTION
  CALIBRATION
  PEST_CONTROL
  FUEL
}

enum AssetDisposalMethod {
  SOLD
  SCRAPPED
  LOST_STOLEN
  DONATED
}

/// Something the AMCOS owns and keeps on its books: machines, buildings, mills, tools. Depreciated straight-line and posted to the ledger.
model Asset {
  id                  String             @id @default(uuid())
  mamcosId            String             @map("mamcos_id")
  tag                 String
  name                String
  category            AssetCategory
  make                String?
  model               String?
  serialNo            String?            @map("serial_no")
  purchaseDate        DateTime           @map("purchase_date") @db.Date
  cost                Decimal            @db.Decimal(14, 2)
  fundingSource       AssetFundingSource @default(AMCOS_FUNDS) @map("funding_source")
  supplier            String?
  location            String?
  condition           AssetCondition     @default(GOOD)
  status              AssetStatus        @default(IN_USE)
  usefulLifeYears     Int                @map("useful_life_years")
  salvageValue        Decimal            @default(0) @map("salvage_value") @db.Decimal(14, 2)
  depreciationStart   DateTime           @map("depreciation_start") @db.Date
  custodianName       String?            @map("custodian_name")
  custodianUserId     String?            @map("custodian_user_id")
  warrantyExpiresOn   DateTime?          @map("warranty_expires_on") @db.Date
  insuranceExpiresOn  DateTime?          @map("insurance_expires_on") @db.Date
  serviceIntervalDays Int?               @map("service_interval_days")
  nextServiceDue      DateTime?          @map("next_service_due") @db.Date
  equipmentId         String?            @unique @map("equipment_id")
  notes               String?
  postedPurchase      Boolean            @default(false) @map("posted_purchase")
  createdById         String?            @map("created_by_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  archivedAt          DateTime?          @map("archived_at")

  mamcos       Mamcos                  @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  equipment    AmcosEquipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  maintenance  AssetMaintenance[]
  custodyLog   AssetCustodyLog[]
  disposal     AssetDisposal?
  depreciation AssetDepreciationLine[]

  @@unique([mamcosId, tag])
  @@index([mamcosId, status])
  @@index([mamcosId, category])
  @@map("assets")
}

model AssetMaintenance {
  id          String               @id @default(uuid())
  assetId     String               @map("asset_id")
  kind        AssetMaintenanceKind
  doneOn      DateTime             @map("done_on") @db.Date
  cost        Decimal              @default(0) @db.Decimal(14, 2)
  performedBy String?              @map("performed_by")
  notes       String?
  nextDueOn   DateTime?            @map("next_due_on") @db.Date
  posted      Boolean              @default(false)
  createdById String?              @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, doneOn])
  @@map("asset_maintenance")
}

/// Who held the asset and when. Append-only.
model AssetCustodyLog {
  id         String   @id @default(uuid())
  assetId    String   @map("asset_id")
  fromName   String?  @map("from_name")
  toName     String   @map("to_name")
  toUserId   String?  @map("to_user_id")
  assignedOn DateTime @map("assigned_on") @db.Date
  assignedBy String?  @map("assigned_by")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([assetId, assignedOn])
  @@map("asset_custody_log")
}

model AssetDisposal {
  id           String              @id @default(uuid())
  assetId      String              @unique @map("asset_id")
  disposedOn   DateTime            @map("disposed_on") @db.Date
  method       AssetDisposalMethod
  proceeds     Decimal             @default(0) @db.Decimal(14, 2)
  reason       String?
  bookValue    Decimal             @map("book_value") @db.Decimal(14, 2)
  gainLoss     Decimal             @map("gain_loss") @db.Decimal(14, 2)
  posted       Boolean             @default(false)
  approvedById String?             @map("approved_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@map("asset_disposals")
}

model AssetDepreciationRun {
  id       String   @id @default(uuid())
  mamcosId String   @map("mamcos_id")
  period   String
  total    Decimal  @db.Decimal(14, 2)
  postedAt DateTime @default(now()) @map("posted_at")
  postedBy String?  @map("posted_by")

  mamcos Mamcos                  @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  lines  AssetDepreciationLine[]

  @@unique([mamcosId, period])
  @@map("asset_depreciation_runs")
}

model AssetDepreciationLine {
  id      String  @id @default(uuid())
  runId   String  @map("run_id")
  assetId String  @map("asset_id")
  amount  Decimal @db.Decimal(14, 2)

  run   AssetDepreciationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  asset Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([runId, assetId])
  @@index([assetId])
  @@map("asset_depreciation_lines")
}

enum DueCategory {
  LEVY
  MEMBERSHIP_FEE
  CANAL_CLEANING
  FERTILISER
  HARVEST_FEE
  OTHER
}

enum DueBasis {
  PER_HECTARE
  FLAT
}

enum DuePaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  HARVEST_DEDUCTION
}

enum DueStatus {
  ACTIVE
  CANCELLED
}

/// A charge the AMCOS sets once (a levy, the membership fee, canal cleaning) and then applies to its farmers.
model FarmerDueType {
  id          String      @id @default(uuid())
  mamcosId    String      @map("mamcos_id")
  name        String
  category    DueCategory
  basis       DueBasis
  rate        Decimal     @db.Decimal(14, 2)
  season      String?
  dueDate     DateTime?   @map("due_date") @db.Date
  isActive    Boolean     @default(true) @map("is_active")
  notes       String?
  createdById String?     @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  mamcos Mamcos      @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  dues   FarmerDue[]

  @@unique([mamcosId, name])
  @@map("farmer_due_types")
}

/// One amount a farmer owes the AMCOS. Balance = amount − waived − payments that are not voided.
model FarmerDue {
  id           String      @id @default(uuid())
  mamcosId     String      @map("mamcos_id")
  typeId       String?     @map("type_id")
  farmerId     String      @map("farmer_id")
  category     DueCategory
  description  String
  hectares     Decimal?    @db.Decimal(8, 2)
  itemName     String?     @map("item_name")
  quantity     Decimal?    @db.Decimal(12, 2)
  unit         String?
  unitPrice    Decimal?    @map("unit_price") @db.Decimal(14, 2)
  amount       Decimal     @db.Decimal(14, 2)
  waivedAmount Decimal     @default(0) @map("waived_amount") @db.Decimal(14, 2)
  waivedReason String?     @map("waived_reason")
  status       DueStatus   @default(ACTIVE)
  cancelReason String?     @map("cancel_reason")
  issuedOn     DateTime    @map("issued_on") @db.Date
  dueDate      DateTime?   @map("due_date") @db.Date
  postedIssue  Boolean     @default(false) @map("posted_issue")
  /// When the "due today" SMS went to the farmer (and a digest to their leaders); null until then.
  dueReminderSentAt DateTime? @map("due_reminder_sent_at")
  createdById  String?     @map("created_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  mamcos   Mamcos         @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  type     FarmerDueType? @relation(fields: [typeId], references: [id], onDelete: Restrict)
  farmer   Farmer         @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  payments DuePayment[]

  @@unique([typeId, farmerId])
  @@index([mamcosId, status])
  @@index([farmerId])
  @@index([mamcosId, dueDate])
  @@map("farmer_dues")
}

model DuePayment {
  id           String           @id @default(uuid())
  mamcosId     String           @map("mamcos_id")
  dueId        String           @map("due_id")
  farmerId     String           @map("farmer_id")
  receiptNo    String           @map("receipt_no")
  amount       Decimal          @db.Decimal(14, 2)
  paidOn       DateTime         @map("paid_on") @db.Date
  method       DuePaymentMethod
  reference    String?
  note         String?
  recordedById String?          @map("recorded_by_id")
  voidedAt     DateTime?        @map("voided_at")
  voidReason   String?          @map("void_reason")
  voidedById   String?          @map("voided_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")

  mamcos        Mamcos       @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  due           FarmerDue    @relation(fields: [dueId], references: [id], onDelete: Restrict)
  farmer        Farmer       @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  /// The money account this moved through; null = not assigned to one.
  cashAccountId String?      @map("cash_account_id")
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, receiptNo])
  @@index([dueId])
  @@index([mamcosId, paidOn])
  @@map("due_payments")
}

/// The member who really owns a hectare that is registered in a relative's name. History: a row is closed, never deleted.
model IrrigationHectareGuardian {
  id           String    @id @default(uuid())
  allocationId String    @map("allocation_id")
  guardianId   String    @map("guardian_id")
  startedOn    DateTime  @map("started_on") @db.Date
  endedOn      DateTime? @map("ended_on") @db.Date
  endReason    String?   @map("end_reason")
  note         String?
  createdById  String?   @map("created_by_id")
  endedById    String?   @map("ended_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  allocation IrrigationHectareAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  guardian   Farmer                      @relation("FarmerGuardianships", fields: [guardianId], references: [id], onDelete: Restrict)

  @@index([allocationId])
  @@index([guardianId, endedOn])
  @@map("irrigation_hectare_guardians")
}

// ============================================================
// PAYROLL (AMCOS staff and leaders)
// ============================================================

/// DRAFT (compiled, adjustable) -> SUBMITTED (the Accountant reconciled it) -> APPROVED (the Manager checked the money and authorised it) -> POSTED (paid and booked).
enum PayrollRunStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
}

enum PayrollPayMethod {
  CASH
  MOBILE_MONEY
  BANK
}

enum PayrollTier {
  CORE_ADMIN
  FIELD_LEADERSHIP
  SUPPORT
}

enum WageType {
  MONTHLY
  DAILY
  PIECE
}

/// The budget line a wage is charged to, each with its own ledger account.
enum CostCenter {
  ADMIN_OVERHEAD
  FACILITY_MAINTENANCE
  SECURITY
  IRRIGATION_OPS
  WAREHOUSE_OPS
}

/// What a stipend depends on: nothing, the gate opener's logged water days, or the chairman's own water-log entries.
enum ComplianceKind {
  NONE
  WATER_LOG
  CHAIRMAN_LOG
}

/// A job title the AMCOS defined: which tier it belongs to, which budget line it is charged to, how it is paid, and what verifies it.
model PayrollJobTitle {
  id         String         @id @default(uuid())
  mamcosId   String         @map("mamcos_id")
  name       String
  tier       PayrollTier
  costCenter CostCenter     @map("cost_center")
  wageType   WageType       @map("wage_type")
  compliance ComplianceKind @default(NONE)
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")

  mamcos Mamcos @relation(fields: [mamcosId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, name])
  @@map("payroll_job_titles")
}

/// A person the AMCOS pays: a staff member or leader with a login, or a support worker without one. Every payee has a worker ID,
/// a phone number and payout details; pay terms take effect only after a Manager verifies them.
model PayrollPayee {
  id             String         @id @default(uuid())
  mamcosId       String         @map("mamcos_id")
  userId         String?        @map("user_id")
  workerCode     String         @map("worker_code")
  /// Name for a worker without a login; people with a login are named from their account.
  fullName       String?        @map("full_name")
  phone          String?
  idType         String?        @map("id_type")
  idNumber       String?        @map("id_number")
  payoutMethod   String?        @map("payout_method")
  payoutAccount  String?        @map("payout_account")
  payoutName     String?        @map("payout_name")
  titleId        String?        @map("title_id")
  /// What they are paid as, e.g. Cashier or Canal leader C01.
  title          String
  tier           PayrollTier    @default(CORE_ADMIN)
  costCenter     CostCenter     @default(ADMIN_OVERHEAD) @map("cost_center")
  wageType       WageType       @default(MONTHLY) @map("wage_type")
  compliance     ComplianceKind @default(NONE)
  /// The fixed monthly salary (MONTHLY only).
  monthlySalary  Decimal        @map("monthly_salary") @db.Decimal(14, 2)
  /// The daily rate (DAILY) or the price per unit (PIECE).
  rate           Decimal?       @db.Decimal(14, 2)
  pieceUnit      String?        @map("piece_unit")
  startDate      DateTime       @map("start_date") @db.Date
  contractEnd    DateTime?      @map("contract_end") @db.Date
  isActive       Boolean        @default(true) @map("is_active")
  /// Set by a Manager (not the person who added them). Changing the pay or payout account clears it until verified again.
  verifiedById   String?        @map("verified_by_id")
  verifiedAt     DateTime?      @map("verified_at")
  createdById    String?        @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  mamcos      Mamcos              @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  user        User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  lines       PayrollLine[]
  attendance  PayrollAttendance[]
  outputs     PayrollOutput[]

  @@unique([mamcosId, userId])
  @@unique([mamcosId, workerCode])
  @@unique([mamcosId, phone])
  @@map("payroll_payees")
}

/// A day a daily-wage worker worked (a whole day, or half a day), recorded by their supervisor.
model PayrollAttendance {
  id           String       @id @default(uuid())
  mamcosId     String       @map("mamcos_id")
  payeeId      String       @map("payee_id")
  date         DateTime     @db.Date
  fraction     Decimal      @default(1) @db.Decimal(3, 2)
  note         String?
  recordedById String       @map("recorded_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  payee PayrollPayee @relation(fields: [payeeId], references: [id], onDelete: Restrict)

  @@unique([payeeId, date])
  @@index([mamcosId, date])
  @@map("payroll_attendance")
}

/// Work a piece-rate worker did on a day (bags sorted, loads carried), recorded by their supervisor.
model PayrollOutput {
  id           String       @id @default(uuid())
  mamcosId     String       @map("mamcos_id")
  payeeId      String       @map("payee_id")
  date         DateTime     @db.Date
  quantity     Decimal      @db.Decimal(12, 2)
  note         String?
  recordedById String       @map("recorded_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")

  payee PayrollPayee @relation(fields: [payeeId], references: [id], onDelete: Restrict)

  @@index([payeeId, date])
  @@index([mamcosId, date])
  @@map("payroll_outputs")
}

/// The most a budget line may cost in one month's payroll. A run over its limit cannot be submitted or approved.
model PayrollBudget {
  mamcosId     String     @map("mamcos_id")
  costCenter   CostCenter @map("cost_center")
  monthlyLimit Decimal    @map("monthly_limit") @db.Decimal(14, 2)
  updatedById  String?    @map("updated_by_id")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")

  @@id([mamcosId, costCenter])
  @@map("payroll_budgets")
}

/// One month's pay run. A DRAFT can be edited freely; POSTED pays it and writes the AMCOS ledger, and is then final.
model PayrollRun {
  id              String            @id @default(uuid())
  mamcosId        String            @map("mamcos_id")
  /// YYYY-MM
  period          String
  status          PayrollRunStatus  @default(DRAFT)
  totalGross      Decimal           @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalDeductions Decimal           @default(0) @map("total_deductions") @db.Decimal(14, 2)
  totalNet        Decimal           @default(0) @map("total_net") @db.Decimal(14, 2)
  payMethod       PayrollPayMethod? @map("pay_method")
  paidOn          DateTime?         @map("paid_on") @db.Date
  note            String?
  createdById     String?           @map("created_by_id")
  postedById      String?           @map("posted_by_id")
  postedAt        DateTime?         @map("posted_at")
  submittedById   String?           @map("submitted_by_id")
  submittedAt     DateTime?         @map("submitted_at")
  approvedById    String?           @map("approved_by_id")
  approvedAt      DateTime?         @map("approved_at")
  approveNote     String?           @map("approve_note")
  /// The money account the Manager authorised this run to be paid from; its balance covered the run when approved.
  approvedCashAccountId String?     @map("approved_cash_account_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  mamcos        Mamcos        @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  lines         PayrollLine[]
  /// The money account this moved through; null = not assigned to one.
  cashAccountId String?       @map("cash_account_id")
  cashAccount   CashAccount?  @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, period])
  @@map("payroll_runs")
}

/// What one person is paid in one run. Name and title are copied so a payslip never changes after the fact.
model PayrollLine {
  id            String  @id @default(uuid())
  runId         String  @map("run_id")
  payeeId       String  @map("payee_id")
  name          String
  title         String
  gross         Decimal @db.Decimal(14, 2)
  deductions    Decimal @default(0) @db.Decimal(14, 2)
  deductionNote String? @map("deduction_note")
  net           Decimal @db.Decimal(14, 2)
  tier          PayrollTier    @default(CORE_ADMIN)
  costCenter    CostCenter     @default(ADMIN_OVERHEAD) @map("cost_center")
  wageType      WageType       @default(MONTHLY) @map("wage_type")
  /// Days worked (DAILY) or units done (PIECE).
  units         Decimal?       @db.Decimal(12, 2)
  rate          Decimal?       @db.Decimal(14, 2)
  /// How the gross was worked out, in words: "22 days x 15,000" or "21 of 24 water logs (87.5%)".
  basis         String?
  /// 0 to 1: the share of a compliance-linked stipend earned.
  complianceFactor Decimal?    @map("compliance_factor") @db.Decimal(5, 4)

  run   PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  payee PayrollPayee @relation(fields: [payeeId], references: [id], onDelete: Restrict)

  @@unique([runId, payeeId])
  @@map("payroll_lines")
}

enum ChargeBasis {
  FLAT
  PER_HECTARE
  PER_KG
  PERCENT
}

enum ChargeCategory {
  WAREHOUSE
  PENALTY
}

/// A fee the AMCOS sets once on its Settings page and every screen then takes from here: milling, storage, delivery, late penalty.
/// (Membership fee, levies and canal cleaning are FarmerDueType rows; tool fees and VAT are Mamcos columns; Settings edits those too.)
model AmcosCharge {
  id          String         @id @default(uuid())
  mamcosId    String         @map("mamcos_id")
  code        String
  name        String
  category    ChargeCategory
  basis       ChargeBasis
  amount      Decimal        @default(0) @db.Decimal(14, 2)
  /// Days after which a late-payment penalty starts (penalty only).
  graceDays   Int            @default(0) @map("grace_days")
  isActive    Boolean        @default(false) @map("is_active")
  updatedById String?        @map("updated_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  mamcos Mamcos @relation(fields: [mamcosId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, code])
  @@map("amcos_charges")
}

/// A kind of machine or tool the AMCOS has (tractor, thresher, water pump…), kept in its Settings.
model AmcosEquipmentType {
  id          String   @id @default(uuid())
  mamcosId    String   @map("mamcos_id")
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  mamcos    Mamcos           @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  equipment AmcosEquipment[]

  @@map("amcos_equipment_types")
}

enum CashAccountKind {
  CASH
  BANK
  MOBILE_MONEY
}

enum CashTransferStatus {
  POSTED
  CANCELLED
}

/// A named place the AMCOS keeps money: the cash box, a bank account, a mobile money wallet.
model CashAccount {
  id            String          @id @default(uuid())
  mamcosId      String          @map("mamcos_id")
  name          String
  kind          CashAccountKind
  /// The bank or mobile network, e.g. CRDB or M-Pesa.
  provider      String?
  accountNumber String?         @map("account_number")
  /// The account used when money moves by this kind of payment and no account is picked.
  isDefault     Boolean         @default(false) @map("is_default")
  isActive      Boolean         @default(true) @map("is_active")
  notes         String?
  createdById   String?         @map("created_by_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  mamcos           Mamcos            @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  entries          LedgerEntry[]
  transfersOut     CashTransfer[]    @relation("TransferFrom")
  transfersIn      CashTransfer[]    @relation("TransferTo")
  cashTransactions CashTransaction[]
  payrollRuns      PayrollRun[]
  duePayments      DuePayment[]
  opsPayments      OpsPayment[]
  invoices         Invoice[]
  bills            Bill[]
  statements       BankStatement[]
  farmerPayouts    FarmerPayout[]

  @@index([mamcosId, isActive])
  @@map("cash_accounts")
}

/// Money moved from one account to another (null on either side = money not assigned to an account yet).
model CashTransfer {
  id            String             @id @default(uuid())
  mamcosId      String             @map("mamcos_id")
  number        String
  fromAccountId String?            @map("from_account_id")
  toAccountId   String?            @map("to_account_id")
  amount        Decimal            @db.Decimal(14, 2)
  transferDate  DateTime           @map("transfer_date") @db.Date
  note          String?
  status        CashTransferStatus @default(POSTED)
  cancelledAt   DateTime?          @map("cancelled_at")
  cancelledById String?            @map("cancelled_by_id")
  cancelReason  String?            @map("cancel_reason")
  createdById   String?            @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")

  mamcos Mamcos       @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  from   CashAccount? @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  to     CashAccount? @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, number])
  @@index([mamcosId, transferDate])
  @@map("cash_transfers")
}

/// Money paid to a farmer (or a walk-in seller) for paddy the cooperative bought. Clears what the cooperative owes them.
model FarmerPayout {
  id            String    @id @default(uuid())
  mamcosId      String    @map("mamcos_id")
  /// PAY-2026-000001, running per cooperative and year.
  number        String
  farmerId      String?   @map("farmer_id")
  /// For a seller who is not a registered farmer; exactly one of farmerId and sellerName is set.
  sellerName    String?   @map("seller_name")
  amount        Decimal   @db.Decimal(14, 2)
  paidOn        DateTime  @map("paid_on") @db.Date
  /// How it was paid; informational, the money account is what moves the cash.
  method        String    @default("CASH")
  reference     String?
  note          String?
  cashAccountId String?   @map("cash_account_id")
  voidedAt      DateTime? @map("voided_at")
  voidedById    String?   @map("voided_by_id")
  voidReason    String?   @map("void_reason")
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  mamcos      Mamcos       @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  farmer      Farmer?      @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, number])
  @@index([mamcosId, farmerId])
  @@map("farmer_payouts")
}

// ============================================================
// AMCOS BOARD
// ============================================================

enum BoardPosition {
  CHAIRPERSON
  VICE_CHAIRPERSON
  SECRETARY
  TREASURER
  MEMBER
}

enum BoardMemberStatus {
  ACTIVE
  ENDED
}

/// A registered farmer sitting on the AMCOS board. Partial unique indexes (raw SQL in the migration): one ACTIVE seat per farmer,
/// and one ACTIVE holder for each officer post (everything except MEMBER).
model BoardMember {
  id          String            @id @default(uuid())
  mamcosId    String            @map("mamcos_id")
  farmerId    String            @map("farmer_id")
  position    BoardPosition     @default(MEMBER)
  termStart   DateTime          @map("term_start") @db.Date
  termEnd     DateTime?         @map("term_end") @db.Date
  status      BoardMemberStatus @default(ACTIVE)
  notes       String?
  endedOn     DateTime?         @map("ended_on") @db.Date
  endReason   String?           @map("end_reason")
  createdById String?           @map("created_by_id")
  endedById   String?           @map("ended_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  mamcos Mamcos @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Restrict)

  @@index([mamcosId, status])
  @@index([farmerId])
  @@map("board_members")
}

// ============================================================
// FARMER LOCAL VERIFICATION (Tier 3: farmers without NIDA, voter ID or driver's license)
// ============================================================

enum LocalVerificationMethod {
  VILLAGE_LETTER
  LOCAL_VOTER_ID
  GUARANTOR
}

/// How a farmer with no national ID was vouched for locally: a village/street government letter (Barua ya Utambulisho),
/// a local voter ID, or the sign-off of a current Block or Canal Chairman. A record stays until it is revoked.
model FarmerLocalVerification {
  id                    String                        @id @default(uuid())
  farmerId              String                        @map("farmer_id")
  method                LocalVerificationMethod
  /// Letter reference number, or the local voter ID number.
  reference             String?
  letterDocumentUrl     String?                       @map("letter_document_url")
  guarantorFarmerId     String?                       @map("guarantor_farmer_id")
  /// The chairman's post when they signed (a leadership can end later; this keeps what was true then).
  guarantorPosition     IrrigationLeadershipPosition? @map("guarantor_position")
  guarantorLeadershipId String?                       @map("guarantor_leadership_id")
  notes                 String?
  recordedById          String?                       @map("recorded_by_id")
  createdAt             DateTime                      @default(now()) @map("created_at")
  revokedAt             DateTime?                     @map("revoked_at")
  revokedById           String?                       @map("revoked_by_id")
  revokedReason         String?                       @map("revoked_reason")

  farmer    Farmer  @relation("LocalVerificationFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  guarantor Farmer? @relation("LocalVerificationGuarantor", fields: [guarantorFarmerId], references: [id], onDelete: Restrict)

  @@index([farmerId, revokedAt])
  @@map("farmer_local_verifications")
}

// ============================================================
// OVERDUE-DEBT FARMS (block, AMCOS administration, M-LAX)
// ============================================================

enum FarmAdminStatus {
  NORMAL
  UNDER_AMCOS
  MLAX_NOTICE
  AT_MLAX
}

/// UNDER_AMCOS, MLAX_NOTICE and AT_MLAX are the open stages; the rest are how a case ended.
enum FarmDefaultCaseStatus {
  UNDER_AMCOS
  MLAX_NOTICE
  AT_MLAX
  RECLAIMED
  TAKEN_OVER
  LEASED_ON_MLAX
  CLOSED
}

/// A farmer whose debt stayed unpaid past the grace period: their farms are blocked and run by the AMCOS. A partial unique
/// index (raw SQL in the migration) allows one open case per farmer.
model FarmDefaultCase {
  id              String                @id @default(uuid())
  mamcosId        String                @map("mamcos_id")
  farmerId        String                @map("farmer_id")
  status          FarmDefaultCaseStatus @default(UNDER_AMCOS)
  openedOn        DateTime              @map("opened_on") @db.Date
  graceDays       Int                   @map("grace_days")
  debtAtOpen      Decimal               @map("debt_at_open") @db.Decimal(14, 2)
  penaltyDueId    String?               @map("penalty_due_id")
  noticeSentAt    DateTime?             @map("notice_sent_at")
  noticeDeadline  DateTime?             @map("notice_deadline")
  atMlaxAt        DateTime?             @map("at_mlax_at")
  resolvedOn      DateTime?             @map("resolved_on")
  resolvedNote    String?               @map("resolved_note")
  takenByFarmerId String?               @map("taken_by_farmer_id")
  takenFarmIds    String[]              @map("taken_farm_ids")
  createdById     String?               @map("created_by_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  mamcos Mamcos             @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  farmer Farmer             @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  events FarmDefaultEvent[]

  @@index([mamcosId, status])
  @@index([farmerId])
  @@map("farm_default_cases")
}

model FarmDefaultEvent {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  kind      String
  note      String?
  actorId   String?  @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  case FarmDefaultCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("farm_default_events")
}

/// The AMCOS's own record of a farm rented through M-LAX: who, which hectare, when, for how long, on what terms and why.
/// It deliberately holds no money (no rent, deposit, commission or payout), so it can be shown to the cooperative as it is.
/// Names are copied at the time of the rental so the record stays readable if a profile changes later.
model AmcosRentalRecord {
  id              String    @id @default(uuid())
  listingId       String    @unique @map("listing_id")
  mamcosId        String    @map("mamcos_id")
  farmId          String    @map("farm_id")
  farmCode        String    @map("farm_code")
  hectareId       String?   @map("hectare_id")
  hectareCode     String?   @map("hectare_code")
  ownerFarmerId   String    @map("owner_farmer_id")
  ownerName       String    @map("owner_name")
  tenantFarmerId  String    @map("tenant_farmer_id")
  tenantName      String    @map("tenant_name")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  durationMonths  Int       @map("duration_months")
  seasonCount     Int?      @map("season_count")
  reason          String?
  terms           String
  /// ACTIVE until the end date passes (shown as ENDED then), or TERMINATED if the rental was cancelled early.
  status          String    @default("ACTIVE")
  terminatedAt    DateTime? @map("terminated_at")
  witnessNote     String?   @map("witness_note")
  witnessNoteById String?   @map("witness_note_by_id")
  witnessNoteAt   DateTime? @map("witness_note_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  listing  LandListing        @relation(fields: [listingId], references: [id])
  hectare  IrrigationHectare? @relation(fields: [hectareId], references: [id])
  disputes Dispute[]

  @@index([mamcosId, status])
  @@index([hectareId])
  @@map("amcos_rental_records")
}

enum HarvestRateScope {
  AMCOS
  CANAL
  BLOCK
}

enum HarvestRateStatus {
  PENDING_APPROVAL
  ACTIVE
  SUPERSEDED
  REJECTED
}

/// The per-hectare harvest fee. One AMCOS-wide rate, which a canal or a block may override. A proposed rate takes effect only
/// when someone other than the proposer approves it; approving replaces the previous active rate of the same scope (kept as SUPERSEDED).
model HarvestFeeRate {
  id             String            @id @default(uuid())
  mamcosId       String            @map("mamcos_id")
  scope          HarvestRateScope
  canalId        String?           @map("canal_id")
  blockId        String?           @map("block_id")
  ratePerHectare Decimal           @map("rate_per_hectare") @db.Decimal(14, 2)
  status         HarvestRateStatus @default(PENDING_APPROVAL)
  note           String?
  requestedById  String            @map("requested_by_id")
  decidedById    String?           @map("decided_by_id")
  decidedAt      DateTime?         @map("decided_at")
  decisionNote   String?           @map("decision_note")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  canal IrrigationCanal? @relation(fields: [canalId], references: [id], onDelete: Restrict)
  block IrrigationBlock? @relation(fields: [blockId], references: [id], onDelete: Restrict)

  @@index([mamcosId, status])
  @@index([canalId])
  @@index([blockId])
  @@map("harvest_fee_rates")
}

// ============================================================
// GOVERNANCE MEETINGS (board meetings and the General Meeting / Mkutano Mkuu)
// ============================================================

enum MeetingKind {
  BOARD
  AGM
}

/// SCHEDULED -> CHECK_IN (members check in) -> IN_SESSION (needs quorum) -> CLOSED (minutes locked); or CANCELLED.
enum MeetingStatus {
  SCHEDULED
  CHECK_IN
  IN_SESSION
  CLOSED
  CANCELLED
}

model AmcosMeeting {
  id             String        @id @default(uuid())
  mamcosId       String        @map("mamcos_id")
  kind           MeetingKind
  title          String
  agenda         String
  venue          String
  scheduledAt    DateTime      @map("scheduled_at")
  /// Share of the invited people who must check in before the meeting can start.
  quorumPercent  Int           @map("quorum_percent")
  /// How many people were invited when the meeting was scheduled (board members, or all members for a general meeting).
  invitedCount   Int           @map("invited_count")
  status         MeetingStatus @default(SCHEDULED)
  startedAt      DateTime?     @map("started_at")
  closedAt       DateTime?     @map("closed_at")
  minutes        String?
  cancelReason   String?       @map("cancel_reason")
  reminderSentAt DateTime?     @map("reminder_sent_at")
  createdById    String?       @map("created_by_id")
  closedById     String?       @map("closed_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  mamcos      Mamcos              @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  attendances MeetingAttendance[]
  resolutions MeetingResolution[]

  @@index([mamcosId, scheduledAt])
  @@map("amcos_meetings")
}

model MeetingAttendance {
  id           String   @id @default(uuid())
  meetingId    String   @map("meeting_id")
  farmerId     String   @map("farmer_id")
  checkedInAt  DateTime @default(now()) @map("checked_in_at")
  /// SELF (the member checked in on their phone) or OFFICE (staff marked them present).
  method       String
  recordedById String?  @map("recorded_by_id")

  meeting AmcosMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  farmer  Farmer       @relation(fields: [farmerId], references: [id], onDelete: Restrict)

  @@unique([meetingId, farmerId])
  @@map("meeting_attendances")
}

/// A resolution passed at a meeting. Append-only: once logged it is never edited or deleted, so it locks in policy.
model MeetingResolution {
  id           String   @id @default(uuid())
  meetingId    String   @map("meeting_id")
  number       Int
  title        String
  text         String
  outcome      String   @default("PASSED")
  votesFor     Int?     @map("votes_for")
  votesAgainst Int?     @map("votes_against")
  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  meeting AmcosMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, number])
  @@map("meeting_resolutions")
}

// ============================================================
// EMANCIPATION: a dependent registered with a guardian becomes an independent member
// ============================================================

enum EmancipationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model IrrigationEmancipationRequest {
  id            String             @id @default(uuid())
  allocationId  String             @map("allocation_id")
  hectareId     String             @map("hectare_id")
  /// The member the hectare is registered to (the dependent who is coming of age).
  holderId      String             @map("holder_id")
  guardianId    String             @map("guardian_id")
  status        EmancipationStatus @default(PENDING_APPROVAL)
  note          String?
  requestedById String?            @map("requested_by_id")
  decidedById   String?            @map("decided_by_id")
  decidedAt     DateTime?          @map("decided_at")
  decisionNote  String?            @map("decision_note")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  hectare IrrigationHectare @relation(fields: [hectareId], references: [id], onDelete: Restrict)

  @@index([holderId])
  @@index([guardianId])
  @@map("irrigation_emancipation_requests")
}

// ============================================================
// HARVEST PASSES, ARRIVALS, INCIDENTS AND THE DAILY RECONCILIATION
// ============================================================

enum HarvestPassStatus {
  ISSUED
  USED
  VOID
}

/// Issued for a hectare the moment its harvest fee is fully paid (and the holder has no active loan). The short code is texted to the
/// farmer, the block leader and any combine operator on site. One per hectare per harvest; a VOID pass is a hold set by the office.
model HarvestPass {
  id          String            @id @default(uuid())
  mamcosId    String            @map("mamcos_id")
  typeId      String            @map("type_id")
  blockId     String            @map("block_id")
  hectareId   String            @map("hectare_id")
  farmerId    String            @map("farmer_id")
  code        String            @unique
  status      HarvestPassStatus @default(ISSUED)
  issuedAt    DateTime          @default(now()) @map("issued_at")
  usedAt      DateTime?         @map("used_at")
  usedById    String?           @map("used_by_id")
  /// CODE (the operator gave the SMS code) or CHAIRMAN (the block leader signed the plot off in the system).
  usedVia     String?           @map("used_via")
  arrivalId   String?           @map("arrival_id")
  voidedAt    DateTime?         @map("voided_at")
  voidedById  String?           @map("voided_by_id")
  voidReason  String?           @map("void_reason")

  @@unique([typeId, hectareId])
  @@index([mamcosId, blockId])
  @@index([farmerId])
  @@map("harvest_passes")
}

/// A combine harvester logged into a block (by the operator or the block leader) and out again.
model HarvestArrival {
  id            String    @id @default(uuid())
  mamcosId      String    @map("mamcos_id")
  blockId       String    @map("block_id")
  operatorName  String    @map("operator_name")
  operatorPhone String?   @map("operator_phone")
  machine       String?
  note          String?
  loggedById    String    @map("logged_by_id")
  arrivedAt     DateTime  @default(now()) @map("arrived_at")
  departedAt    DateTime? @map("departed_at")
  departedById  String?   @map("departed_by_id")

  @@index([mamcosId, blockId, departedAt])
  @@map("harvest_arrivals")
}

enum HarvestIncidentStatus {
  OPEN
  RESOLVED
}

/// A harvester stopped at an uncleared plot, or a dispute raised in a block; the canal leader resolves it. Never edited, only resolved.
model HarvestIncident {
  id           String                @id @default(uuid())
  mamcosId     String                @map("mamcos_id")
  blockId      String                @map("block_id")
  hectareId    String?               @map("hectare_id")
  /// BLOCKED (an uncleared plot was presented for harvest) or DISPUTE (raised by hand).
  kind         String
  description  String
  status       HarvestIncidentStatus @default(OPEN)
  raisedById   String                @map("raised_by_id")
  resolvedById String?               @map("resolved_by_id")
  resolvedAt   DateTime?             @map("resolved_at")
  resolution   String?
  createdAt    DateTime              @default(now()) @map("created_at")

  @@index([mamcosId, status])
  @@index([blockId])
  @@map("harvest_incidents")
}

/// How collected harvest fees are ring-fenced: this share goes to the maintenance fund, the rest to operations. Set by the Manager.
model HarvestFundSplit {
  mamcosId           String   @id @map("mamcos_id")
  maintenancePercent Int      @map("maintenance_percent")
  updatedById        String?  @map("updated_by_id")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("harvest_fund_splits")
}

/// The Accountant's daily sign-off: what was collected that day and how it divides between operations and maintenance.
model HarvestReconciliation {
  id                 String   @id @default(uuid())
  mamcosId           String   @map("mamcos_id")
  day                DateTime @db.Date
  paymentsCount      Int      @map("payments_count")
  collected          Decimal  @db.Decimal(14, 2)
  operating          Decimal  @db.Decimal(14, 2)
  maintenance        Decimal  @db.Decimal(14, 2)
  maintenancePercent Int      @map("maintenance_percent")
  note               String?
  reconciledById     String   @map("reconciled_by_id")
  reconciledAt       DateTime @default(now()) @map("reconciled_at")

  @@unique([mamcosId, day])
  @@map("harvest_reconciliations")
}

// ============================================================
// INFRASTRUCTURE TENDERS AND CONTRACTORS
// ============================================================

enum ContractorKind {
  COMPANY
  INDIVIDUAL
  MEMBER_GROUP
}

enum ContractorStatus {
  PENDING
  VETTED
  REJECTED
  SUSPENDED
}

/// An outside company, person or member group that may bid for maintenance contracts. Signs in with its own login (userId);
/// can bid only once an AMCOS Procurement Officer, Manager or Super Admin has vetted it.
model Contractor {
  id              String           @id @default(uuid())
  userId          String           @unique @map("user_id")
  kind            ContractorKind
  name            String
  contactPerson   String?          @map("contact_person")
  phone           String
  email           String?
  tin             String?
  businessRegNo   String?          @map("business_reg_no")
  /// For a member group: the member number of a registered AMCOS member who stands behind it.
  memberNumber    String?          @map("member_number")
  address         String?
  equipment       String?
  equipmentCount  Int              @default(0) @map("equipment_count")
  yearsExperience Int              @default(0) @map("years_experience")
  payoutMethod    String?          @map("payout_method")
  payoutAccount   String?          @map("payout_account")
  payoutName      String?          @map("payout_name")
  status          ContractorStatus @default(PENDING)
  vettedById      String?          @map("vetted_by_id")
  vettedAt        DateTime?        @map("vetted_at")
  vettingNote     String?          @map("vetting_note")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  bids    TenderBid[]
  tenders Tender[]

  @@index([status])
  @@map("contractors")
}

enum TenderCategory {
  CANAL_CLEARING
  DESILTING
  ROAD_GRADING
  DRAINAGE_REPAIR
  OTHER
}

/// DRAFT -> OPEN (published, bids sealed) -> EVALUATION (bids opened, ranked, recommended) -> AWARDED (Manager signed off)
/// -> COMPLETED (every milestone paid). CANCELLED from any step before COMPLETED.
enum TenderStatus {
  DRAFT
  OPEN
  EVALUATION
  AWARDED
  COMPLETED
  CANCELLED
}

model Tender {
  id                String         @id @default(uuid())
  mamcosId          String         @map("mamcos_id")
  reference         String
  title             String
  scope             String
  category          TenderCategory
  canalId           String?        @map("canal_id")
  blockIds          String[]       @map("block_ids")
  budgetCeiling     Decimal        @map("budget_ceiling") @db.Decimal(14, 2)
  opensAt           DateTime       @map("opens_at")
  closesAt          DateTime       @map("closes_at")
  requiredEquipment Int            @default(1) @map("required_equipment")
  /// Evaluation weights (sum 100): price, equipment offered, years of experience, past performance on MAYOData.
  wPrice            Int            @map("w_price")
  wEquipment        Int            @map("w_equipment")
  wExperience       Int            @map("w_experience")
  wPerformance      Int            @map("w_performance")
  status            TenderStatus   @default(DRAFT)
  publishedAt       DateTime?      @map("published_at")
  bidsOpenedAt      DateTime?      @map("bids_opened_at")
  bidsOpenedById    String?        @map("bids_opened_by_id")
  recommendedBidId  String?        @map("recommended_bid_id")
  recommendedById   String?        @map("recommended_by_id")
  recommendedAt     DateTime?      @map("recommended_at")
  recommendNote     String?        @map("recommend_note")
  approvedById      String?        @map("approved_by_id")
  approvedAt        DateTime?      @map("approved_at")
  awardedBidId      String?        @map("awarded_bid_id")
  contractorId      String?        @map("contractor_id")
  contractPrice     Decimal?       @map("contract_price") @db.Decimal(14, 2)
  /// 1 to 5, given by the Manager when the work is complete; feeds the contractor's past-performance score.
  rating            Int?
  completedAt       DateTime?      @map("completed_at")
  cancelReason      String?        @map("cancel_reason")
  createdById       String         @map("created_by_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  mamcos     Mamcos           @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  contractor Contractor?      @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  bids       TenderBid[]
  milestones TenderMilestone[]
  events     TenderEvent[]

  @@unique([mamcosId, reference])
  @@index([status, closesAt])
  @@map("tenders")
}

enum BidStatus {
  SUBMITTED
  WITHDRAWN
}

model TenderBid {
  id                 String     @id @default(uuid())
  tenderId           String     @map("tender_id")
  contractorId       String     @map("contractor_id")
  /// Anonymous label shown to evaluators until a bid is recommended.
  code               String
  price              Decimal    @db.Decimal(14, 2)
  technicalProposal  String     @map("technical_proposal")
  equipmentOffered   Int        @map("equipment_offered")
  completionDays     Int        @map("completion_days")
  documentUrls       String[]   @map("document_urls")
  status             BidStatus  @default(SUBMITTED)
  submittedAt        DateTime   @default(now()) @map("submitted_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  tender     Tender     @relation(fields: [tenderId], references: [id], onDelete: Restrict)
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  @@unique([tenderId, contractorId])
  @@unique([tenderId, code])
  @@map("tender_bids")
}

/// PENDING (work under way) -> SUBMITTED (contractor says it is done) -> SIGNED_OFF (a canal or block chairman inspected it)
/// -> APPROVED (Manager approved the payment) -> PAID (Accountant paid and booked it). A chairman may send it back to PENDING.
enum MilestoneStatus {
  PENDING
  SUBMITTED
  SIGNED_OFF
  APPROVED
  PAID
}

model TenderMilestone {
  id             String          @id @default(uuid())
  tenderId       String          @map("tender_id")
  number         Int
  title          String
  percent        Int
  /// Worked out when the contract is awarded: share of the contract price.
  amount         Decimal?        @db.Decimal(14, 2)
  status         MilestoneStatus @default(PENDING)
  submittedAt    DateTime?       @map("submitted_at")
  submitNote     String?         @map("submit_note")
  evidenceUrls   String[]        @map("evidence_urls")
  reworkNote     String?         @map("rework_note")
  signedOffById  String?         @map("signed_off_by_id")
  signedOffAt    DateTime?       @map("signed_off_at")
  signOffNote    String?         @map("sign_off_note")
  approvedById   String?         @map("approved_by_id")
  approvedAt     DateTime?       @map("approved_at")
  paidById       String?         @map("paid_by_id")
  paidAt         DateTime?       @map("paid_at")
  paidMethod     String?         @map("paid_method")
  paidReference  String?         @map("paid_reference")

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Restrict)

  @@unique([tenderId, number])
  @@map("tender_milestones")
}

/// The tender's record: every step, by whom and when. Append-only (the database refuses changes), so nothing can be rewritten.
model TenderEvent {
  id        String   @id @default(uuid())
  tenderId  String   @map("tender_id")
  kind      String
  actorId   String?  @map("actor_id")
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Restrict)

  @@index([tenderId, createdAt])
  @@map("tender_events")
}

// ============================================================
// WATER: irrigation schedules and the daily log that stipends are checked against
// ============================================================

/// When water is to run on a canal (or one block of it): the weekdays (0 = Sunday), the period, and the gate opener responsible.
model WaterSchedule {
  id               String    @id @default(uuid())
  mamcosId         String    @map("mamcos_id")
  canalId          String    @map("canal_id")
  blockId          String?   @map("block_id")
  weekdays         Int[]
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  gateOpenerPayeeId String?  @map("gate_opener_payee_id")
  note             String?
  isActive         Boolean   @default(true) @map("is_active")
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([mamcosId, canalId])
  @@map("water_schedules")
}

/// One entry in the water log: the gate opened and closed on a day, who did it, who recorded it, and any water issue (leak, shortage, dispute, blockage).
model WaterLog {
  id                String    @id @default(uuid())
  mamcosId          String    @map("mamcos_id")
  canalId           String    @map("canal_id")
  blockId           String?   @map("block_id")
  date              DateTime  @db.Date
  openedAt          DateTime? @map("opened_at")
  closedAt          DateTime? @map("closed_at")
  /// The gate opener on duty (a payroll payee); the person recording may be the chairman.
  gateOpenerPayeeId String?   @map("gate_opener_payee_id")
  loggedById        String    @map("logged_by_id")
  scheduleId        String?   @map("schedule_id")
  note              String?
  /// LEAK, SHORTAGE, DISPUTE, BLOCKAGE or OTHER; null when nothing went wrong.
  issueType         String?   @map("issue_type")
  issueNote         String?   @map("issue_note")
  issueStatus       String?   @map("issue_status")
  resolvedById      String?   @map("resolved_by_id")
  resolvedAt        DateTime? @map("resolved_at")
  resolution        String?
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([mamcosId, date])
  @@index([canalId, date])
  @@index([gateOpenerPayeeId, date])
  @@map("water_logs")
}

// ============================================================
// STAFF TASKS: cash drawer, input distribution, purchase orders, maintenance schedules
// ============================================================

/// The Cashier's end-of-day tally: what was collected (from the receipts they issued), the cash actually counted, and the difference.
/// The Accountant receives it. One per cashier per day.
model CashDrawerClose {
  id             String    @id @default(uuid())
  mamcosId       String    @map("mamcos_id")
  day            DateTime  @db.Date
  cashierId      String    @map("cashier_id")
  paymentsCount  Int       @map("payments_count")
  expectedCash   Decimal   @map("expected_cash") @db.Decimal(14, 2)
  expectedMobile Decimal   @map("expected_mobile") @db.Decimal(14, 2)
  expectedBank   Decimal   @map("expected_bank") @db.Decimal(14, 2)
  countedCash    Decimal   @map("counted_cash") @db.Decimal(14, 2)
  /// Counted cash minus expected cash: negative = short, positive = over.
  variance       Decimal   @db.Decimal(14, 2)
  note           String?
  status         String    @default("SUBMITTED")
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  receivedById   String?   @map("received_by_id")
  receivedAt     DateTime? @map("received_at")
  receiveNote    String?   @map("receive_note")

  @@unique([mamcosId, day, cashierId])
  @@index([mamcosId, status])
  @@map("cash_drawer_closes")
}

/// Inputs (fertilizer, seed, chemicals) handed to a farmer: stock goes out, the cost is charged to the farmer, and the farmer
/// acknowledges receipt with a code sent to their phone (their digital signature).
model InputIssue {
  id          String    @id @default(uuid())
  mamcosId    String    @map("mamcos_id")
  reference   String
  farmerId    String    @map("farmer_id")
  itemId      String    @map("item_id")
  itemName    String    @map("item_name")
  quantity    Float
  unit        String
  unitPrice   Decimal   @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal   @db.Decimal(14, 2)
  dueId       String?   @map("due_id")
  /// The farmer's Farm IDs when the inputs were issued.
  farmIds     String[]  @map("farm_ids")
  dueDate     DateTime? @map("due_date") @db.Date
  ackCodeHash String    @map("ack_code_hash")
  /// PENDING until the farmer gives the code; then ACKNOWLEDGED.
  ackStatus   String    @default("PENDING") @map("ack_status")
  ackAt       DateTime? @map("ack_at")
  ackById     String?   @map("ack_by_id")
  /// Wrong codes tried since the code was last sent; after 5 the code is locked until the office sends a new one.
  ackAttempts Int       @default(0) @map("ack_attempts")
  note        String?
  issuedById  String    @map("issued_by_id")
  issuedAt    DateTime  @default(now()) @map("issued_at")

  @@unique([mamcosId, reference])
  @@index([mamcosId, ackStatus])
  @@index([farmerId])
  @@map("input_issues")
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// A purchase order to a supplier. The Procurement Officer drafts it; a Manager approves it (so procurement never approves its own spending);
/// delivery receipts record what arrived, which brings stock in.
model PurchaseOrder {
  id           String              @id @default(uuid())
  mamcosId     String              @map("mamcos_id")
  number       String
  supplierId   String              @map("supplier_id")
  status       PurchaseOrderStatus @default(DRAFT)
  expectedOn   DateTime?           @map("expected_on") @db.Date
  note         String?
  totalAmount  Decimal             @map("total_amount") @db.Decimal(14, 2)
  createdById  String              @map("created_by_id")
  approvedById String?             @map("approved_by_id")
  approvedAt   DateTime?           @map("approved_at")
  cancelReason String?             @map("cancel_reason")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  lines    PurchaseOrderLine[]
  receipts DeliveryReceipt[]

  @@unique([mamcosId, number])
  @@index([mamcosId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  itemName    String   @map("item_name")
  /// When the line is a farm input, delivery adds to that input's stock.
  inputItemId String?  @map("input_item_id")
  unit        String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  received    Decimal  @default(0) @db.Decimal(12, 2)

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines DeliveryReceiptLine[]

  @@map("purchase_order_lines")
}

model DeliveryReceipt {
  id           String   @id @default(uuid())
  mamcosId     String   @map("mamcos_id")
  orderId      String   @map("order_id")
  number       String
  receivedOn   DateTime @map("received_on") @db.Date
  /// The supplier's own delivery note number.
  deliveryNote String?  @map("delivery_note")
  note         String?
  receivedById String   @map("received_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  order PurchaseOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines DeliveryReceiptLine[]

  @@unique([mamcosId, number])
  @@map("delivery_receipts")
}

model DeliveryReceiptLine {
  id          String   @id @default(uuid())
  receiptId   String   @map("receipt_id")
  orderLineId String   @map("order_line_id")
  quantity    Decimal  @db.Decimal(12, 2)

  receipt   DeliveryReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine PurchaseOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@map("delivery_receipt_lines")
}

enum MaintenanceTarget {
  CANAL
  BLOCK
  GATE
  EQUIPMENT
  OTHER
}

/// A recurring maintenance job: desilting a canal every season, greasing a water gate every month, servicing a pump. Each time it is done
/// the next due date moves on.
model MaintenanceSchedule {
  id           String            @id @default(uuid())
  mamcosId     String            @map("mamcos_id")
  title        String
  target       MaintenanceTarget
  canalId      String?           @map("canal_id")
  blockId      String?           @map("block_id")
  assetId      String?           @map("asset_id")
  location     String?
  intervalDays Int               @map("interval_days")
  nextDueOn    DateTime          @map("next_due_on") @db.Date
  lastDoneOn   DateTime?         @map("last_done_on") @db.Date
  isActive     Boolean           @default(true) @map("is_active")
  createdById  String?           @map("created_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")

  logs MaintenanceLog[]

  @@index([mamcosId, nextDueOn])
  @@map("maintenance_schedules")
}

model MaintenanceLog {
  id         String   @id @default(uuid())
  scheduleId String   @map("schedule_id")
  doneOn     DateTime @map("done_on") @db.Date
  doneById   String   @map("done_by_id")
  note       String?
  cost       Decimal? @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  schedule MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([scheduleId, doneOn])
  @@map("maintenance_logs")
}
