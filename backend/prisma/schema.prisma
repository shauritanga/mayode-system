// ============================================================
// MAYODE GROUP Integrated System — Prisma Database Schema
// ============================================================
// PostgreSQL. GPS boundaries stored as GeoJSON (Json), so no
// PostGIS extension is required.
// Covers: Users, Farmers, Farms, Plots, MAMCOS, Crop Cycles,
//         Verification, Documents, Notifications,
//         Payments, Inventory, Buyers, M-LAX Marketplace
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// CORE: User & Authentication
// ============================================================

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phone         String   @unique
  passwordHash  String   @map("password_hash")
  role          UserRole
  isActive      Boolean  @default(true) @map("is_active")
  language      String   @default("sw") // sw = Swahili, en = English
  pushToken     String?  @map("push_token")  // Expo Push Notification Token
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  farmer          Farmer?
  fieldOfficer    FieldOfficer?
  mamcosSecretary MamcosSecretary?
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  memberships     Membership[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================================================
// CORE: Farmer Profile
// ============================================================

model Farmer {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  controlNumber   String   @unique @map("control_number") // Auto-generated: MYD-00001
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  dateOfBirth     DateTime? @map("date_of_birth")
  gender          Gender?
  nationalId      String?  @unique @map("national_id")
  photoUrl        String?  @map("photo_url")
  village         String?
  ward            String?
  district        String?  @default("Mbarali")
  region          String?  @default("Mbeya")
  familySize      Int?     @map("family_size")

  // Extended profile (rice-production platform)
  email                  String?
  residenceLatitude      Float?           @map("residence_latitude")
  residenceLongitude     Float?           @map("residence_longitude")
  educationLevel         EducationLevel?  @map("education_level")
  farmingExperienceYears Int?             @map("farming_experience_years")
  dependents             Int?

  // Verification workflow
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedById       String?            @map("verified_by_id")
  verifiedAt         DateTime?          @map("verified_at")

  membershipDate  DateTime @default(now()) @map("membership_date")
  creditScore     Float    @default(0) @map("credit_score")
  isBlacklisted   Boolean  @default(false) @map("is_blacklisted")
  blacklistReason String?  @map("blacklist_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mamcosId          String?            @map("mamcos_id")
  mamcos            Mamcos?            @relation(fields: [mamcosId], references: [id])
  farms             Farm[]
  cropCycles        CropCycle[]
  payments          Payment[]          @relation("FarmerPayments")
  landListings      LandListing[]      @relation("LandOwner")
  rentals           LandListing[]      @relation("LandRenter")
  tractorBookings   TractorBooking[]
  inventoryRecords  InventoryRecord[]
  loanRecords       LoanRecord[]
  household         Household?
  documents         Document[]
  verifications     FarmerVerification[]
  memberships          Membership[]
  farmOwnerships       FarmOwnership[]          @relation("LegalOwner")
  leasesAsOwner        FarmLease[]              @relation("LeaseOwner")
  leasesAsRenter       FarmLease[]              @relation("LeaseRenter")
  seasonalAssignments  SeasonalFarmAssignment[] @relation("ActiveFarmer")
  rewardWins           RewardWinner[]
  activities           Activity[]

  @@map("farmers")
}

// ============================================================
// CORE: Field Officer
// ============================================================

model FieldOfficer {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  employeeCode    String   @unique @map("employee_code")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  assignedArea    String?  @map("assigned_area")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmVerifications   FarmVerification[]
  farmerVerifications FarmerVerification[]
  activityLogs        ActivityLog[]

  @@map("field_officers")
}

// ============================================================
// CORE: MAMCOS (Cooperative Schemes)
// ============================================================

model Mamcos {
  id              String   @id @default(uuid())
  name            String   @unique
  location        String?
  district        String?  @default("Mbarali")
  totalHectares   Float?   @map("total_hectares")
  chairmanName    String?  @map("chairman_name")
  chairmanPhone   String?  @map("chairman_phone")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  secretary       MamcosSecretary?
  farmers         Farmer[]
  farms           Farm[]
  farmingSeasons  FarmingSeason[]
  registryRecords FarmRegistryRecord[]

  @@map("mamcos")
}

model MamcosSecretary {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  mamcosId        String   @unique @map("mamcos_id")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  stabilityBonus  Float    @default(0) @map("stability_bonus")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mamcos Mamcos @relation(fields: [mamcosId], references: [id])

  @@map("mamcos_secretaries")
}

// ============================================================
// CORE: Farm (Multi-farm per farmer)
// ============================================================

model Farm {
  id                String    @id @default(uuid())
  farmCode          String    @unique @map("farm_code") // e.g., FP-JD-01
  farmerId          String    @map("farmer_id")
  mamcosId          String?   @map("mamcos_id")
  name              String
  plotNumber        String?   @map("plot_number")
  blockNumber       String?   @map("block_number")
  section           String?
  village           String?
  ward              String?
  district          String?
  region            String?
  socialHectares    Float     @map("social_hectares")   // The "social" unit
  actualAcres       Float?    @map("actual_acres")      // GPS-verified actual size
  grade             FarmGrade @default(B)
  vichuguuCount     Int       @default(0) @map("vichuguu_count")
  hasIrrigation     Boolean   @default(false) @map("has_irrigation")
  nearRoad          Boolean   @default(false) @map("near_road")
  soilCondition     String?   @map("soil_condition")
  photoUrls         String[]  @map("photo_urls")

  // Extended farm characteristics
  ownershipType     OwnershipType? @map("ownership_type")
  ownerName         String?        @map("owner_name")
  ownerPhone        String?        @map("owner_phone")
  landTenure        String?        @map("land_tenure")
  soilType          String?        @map("soil_type")
  soilFertility     String?        @map("soil_fertility")
  waterSource       String?        @map("water_source")
  irrigationMethod  String?        @map("irrigation_method")
  accessibility     String?
  previousCrops     String[]       @map("previous_crops")
  isVerified        Boolean   @default(false) @map("is_verified")
  isAvailableForRent Boolean  @default(false) @map("is_available_for_rent")
  isLeased          Boolean   @default(false) @map("is_leased")
  leaseLockedUntil  DateTime? @map("lease_locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // GPS Boundary (stored as GeoJSON polygon via PostGIS)
  // We store coordinates as JSON since Prisma doesn't natively support PostGIS geometry
  boundaryCoordinates Json?   @map("boundary_coordinates")
  centerLatitude      Float?  @map("center_latitude")
  centerLongitude     Float?  @map("center_longitude")

  // Relations
  farmer            Farmer             @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  mamcos            Mamcos?            @relation(fields: [mamcosId], references: [id])
  plots               Plot[]
  cropCycles          CropCycle[]
  landListings        LandListing[]
  verifications       FarmVerification[]
  inventoryRecords    InventoryRecord[]
  documents           Document[]
  ownerships          FarmOwnership[]
  leases              FarmLease[]
  seasonalAssignments SeasonalFarmAssignment[]
  alerts              FarmAlert[]
  photos              FarmPhoto[]
  fieldSurveys        FarmFieldSurvey[]

  @@map("farms")
}

model FarmVerification {
  id              String   @id @default(uuid())
  farmId          String   @map("farm_id")
  fieldOfficerId  String   @map("field_officer_id")
  verifiedAt      DateTime @default(now()) @map("verified_at")
  gpsVerified     Boolean  @default(false) @map("gps_verified")
  neighborLeft    String?  @map("neighbor_left")
  neighborRight   String?  @map("neighbor_right")
  mamcosApproved  Boolean  @default(false) @map("mamcos_approved")
  photoProofUrl   String?  @map("photo_proof_url")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  farm         Farm         @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldOfficer FieldOfficer @relation(fields: [fieldOfficerId], references: [id])

  @@map("farm_verifications")
}

// ============================================================
// PRODUCTION: Crop Cycle & Activity Tracking
// ============================================================

model CropCycle {
  id              String         @id @default(uuid())
  farmId          String         @map("farm_id")
  plotId          String?        @map("plot_id")       // Farm → Plot → CropCycle (Phase 1+)
  farmerId        String         @map("farmer_id")
  season          String                               // e.g., "2025/2026 Main"
  riceVariety     String?        @map("rice_variety")
  plantingDate    DateTime?      @map("planting_date")
  expectedHarvest DateTime?      @map("expected_harvest")
  harvestDate     DateTime?      @map("harvest_date")
  estimatedYieldKg Float?        @map("estimated_yield_kg")
  actualYieldKg   Float?         @map("actual_yield_kg")
  status          CropCycleStatus @default(PLANNED)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  farm       Farm          @relation(fields: [farmId], references: [id])
  plot       Plot?         @relation(fields: [plotId], references: [id])
  farmer     Farmer        @relation(fields: [farmerId], references: [id])
  activities ActivityLog[]
  costs      InputCost[]
  revenues   Revenue[]

  @@map("crop_cycles")
}

model ActivityLog {
  id              String       @id @default(uuid())
  cropCycleId     String       @map("crop_cycle_id")
  fieldOfficerId  String?      @map("field_officer_id")
  activityType    ActivityType @map("activity_type")
  activityDate    DateTime     @map("activity_date")
  description     String?
  inputsUsed      Json?        @map("inputs_used")  // { name, quantity, unit }
  laborWorkers    Int?         @map("labor_workers")
  laborHours      Float?       @map("labor_hours")
  photoUrls       String[]     @map("photo_urls")
  gpsLatitude     Float?       @map("gps_latitude")
  gpsLongitude    Float?       @map("gps_longitude")
  createdAt       DateTime     @default(now()) @map("created_at")

  // Relations
  cropCycle    CropCycle     @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  fieldOfficer FieldOfficer? @relation(fields: [fieldOfficerId], references: [id])

  @@map("activity_logs")
}

// ============================================================
// FINANCE: Cost & Revenue Tracking
// ============================================================

model InputCost {
  id            String        @id @default(uuid())
  cropCycleId   String        @map("crop_cycle_id")
  category      CostCategory
  itemName      String        @map("item_name")
  quantity      Float?
  unit          String?                              // kg, liters, bags, etc.
  unitPrice     Float?        @map("unit_price")
  totalCost     Float         @map("total_cost")     // In TZS
  supplier      String?
  receiptUrl    String?       @map("receipt_url")
  dateIncurred  DateTime      @map("date_incurred")
  createdAt     DateTime      @default(now()) @map("created_at")

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@map("input_costs")
}

model Revenue {
  id              String      @id @default(uuid())
  cropCycleId     String      @map("crop_cycle_id")
  revenueType     RevenueType @map("revenue_type")
  quantityKg      Float       @map("quantity_kg")
  pricePerKg      Float       @map("price_per_kg")
  totalRevenue    Float       @map("total_revenue")   // In TZS
  fairtradePremium Float?     @map("fairtrade_premium")
  buyerId         String?     @map("buyer_id")
  saleDate        DateTime    @map("sale_date")
  createdAt       DateTime    @default(now()) @map("created_at")

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  buyer     Buyer?    @relation(fields: [buyerId], references: [id])

  @@map("revenues")
}

// ============================================================
// FINANCE: Payments & Escrow
// ============================================================

model Payment {
  id              String        @id @default(uuid())
  farmerId        String        @map("farmer_id")
  membershipId    String?       @map("membership_id")
  amount          Float                                // In TZS
  paymentType     PaymentType   @map("payment_type")
  status          PaymentStatus
  mpesaRef        String?       @map("mpesa_ref")
  orderReference  String?       @map("order_reference") // ClickPesa order reference
  loanDeduction   Float?        @map("loan_deduction")
  netAmount       Float?        @map("net_amount")
  description     String?
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  farmer     Farmer      @relation("FarmerPayments", fields: [farmerId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@map("payments")
}

model LoanRecord {
  id                String   @id @default(uuid())
  farmerId          String   @map("farmer_id")
  lenderName        String   @map("lender_name")
  originalAmount    Float    @map("original_amount")
  amountOwed        Float    @map("amount_owed")
  repaymentSchedule String?  @map("repayment_schedule")
  autoDeductPercent Float?   @map("auto_deduct_percent")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  farmer Farmer @relation(fields: [farmerId], references: [id])

  @@map("loan_records")
}

// ============================================================
// INVENTORY: Traceability & Chain of Custody
// ============================================================

model InventoryRecord {
  id              String          @id @default(uuid())
  farmId          String          @map("farm_id")
  farmerId        String          @map("farmer_id")
  lotNumber       String?         @map("lot_number")
  weightKg        Float           @map("weight_kg")
  qualityGrade    String?         @map("quality_grade")
  trackingCode    String          @unique @map("tracking_code")
  warehouseLocation String?       @map("warehouse_location")
  receivedDate    DateTime        @map("received_date")
  status          InventoryStatus @default(RECEIVED)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  farm    Farm   @relation(fields: [farmId], references: [id])
  farmer  Farmer @relation(fields: [farmerId], references: [id])
  lot     Lot?   @relation(fields: [lotNumber], references: [lotNumber])

  @@map("inventory_records")
}

model Lot {
  id              String   @id @default(uuid())
  lotNumber       String   @unique @map("lot_number")  // e.g., LOT-2025-001
  totalWeightKg   Float    @map("total_weight_kg")
  riceVariety     String?  @map("rice_variety")
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryRecords InventoryRecord[]
  sales            Sale[]

  @@map("lots")
}

// ============================================================
// BUYERS & SALES
// ============================================================

model Buyer {
  id                    String   @id @default(uuid())
  name                  String
  fairtradeCertNumber   String?  @unique @map("fairtrade_cert_number")
  contactPerson         String?  @map("contact_person")
  contactEmail          String?  @map("contact_email")
  contactPhone          String?  @map("contact_phone")
  isCertified           Boolean  @default(false) @map("is_certified")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  sales    Sale[]
  revenues Revenue[]

  @@map("buyers")
}

model Sale {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique @map("invoice_number")
  buyerId         String   @map("buyer_id")
  lotId           String   @map("lot_id")
  riceVariety     String?  @map("rice_variety")
  quantityKg      Float    @map("quantity_kg")
  packaging       String?
  pricePerKg      Float    @map("price_per_kg")
  fairtradePremium Float?  @map("fairtrade_premium")
  totalRevenue    Float    @map("total_revenue")
  paymentReceived Boolean  @default(false) @map("payment_received")
  paymentDate     DateTime? @map("payment_date")
  saleDate        DateTime @map("sale_date")
  createdAt       DateTime @default(now()) @map("created_at")

  buyer Buyer @relation(fields: [buyerId], references: [id])
  lot   Lot   @relation(fields: [lotId], references: [id])

  @@map("sales")
}

// ============================================================
// M-LAX: Land Listing & Marketplace
// ============================================================

model LandListing {
  id                  String       @id @default(uuid())
  farmId              String       @map("farm_id")
  ownerId             String       @map("owner_id")
  renterId            String?      @map("renter_id")
  askingPrice         Float        @map("asking_price")       // In TZS
  suggestedPrice      Float?       @map("suggested_price")
  finalPrice          Float?       @map("final_price")
  dealType            DealType     @default(STANDARD) @map("deal_type")
  commissionRate      Float        @map("commission_rate")
  commissionAmount    Float?       @map("commission_amount")
  leaseStatus         LeaseStatus  @default(DRAFT) @map("lease_status")
  leaseDurationMonths Int          @map("lease_duration_months")
  leaseStartDate      DateTime?    @map("lease_start_date")
  leaseEndDate        DateTime?    @map("lease_end_date")
  isFlashDeal         Boolean      @default(false) @map("is_flash_deal")
  preferredRenterCode String?      @map("preferred_renter_code")
  isMultiYear         Boolean      @default(false) @map("is_multi_year")
  pricingModel        String?      @map("pricing_model")     // "fixed", "step_up", "rice_linked"
  autoDropPrice       Float?       @map("auto_drop_price")   // Flexible pricing auto-drop
  autoDropDays        Int?         @map("auto_drop_days")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // Relations
  farm   Farm   @relation(fields: [farmId], references: [id])
  owner  Farmer @relation("LandOwner", fields: [ownerId], references: [id])
  renter Farmer? @relation("LandRenter", fields: [renterId], references: [id])
  escrowPayments EscrowPayment[]

  @@map("land_listings")
}

// ============================================================
// M-LAX: Tractor & Equipment Booking
// ============================================================

model TractorOwner {
  id              String   @id @default(uuid())
  name            String
  phone           String
  location        String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tractors Tractor[]

  @@map("tractor_owners")
}

model Tractor {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  registrationNo  String   @unique @map("registration_no")
  model           String?
  horsePower      Int?     @map("horse_power")
  isAvailable     Boolean  @default(true) @map("is_available")
  location        String?
  pricePerHectare Float?   @map("price_per_hectare")   // Base price in TZS
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner    TractorOwner     @relation(fields: [ownerId], references: [id])
  bookings TractorBooking[]

  @@map("tractors")
}

model TractorBooking {
  id              String        @id @default(uuid())
  tractorId       String        @map("tractor_id")
  farmerId        String        @map("farmer_id")
  hectares        Float
  terrainGrade    FarmGrade     @map("terrain_grade")
  basePrice       Float         @map("base_price")
  terrainSurcharge Float?       @map("terrain_surcharge")
  totalPrice      Float         @map("total_price")
  commissionRate  Float         @map("commission_rate")
  commissionAmount Float        @map("commission_amount")
  status          BookingStatus @default(PENDING)
  scheduledDate   DateTime      @map("scheduled_date")
  completedAt     DateTime?     @map("completed_at")
  farmerConfirmed Boolean       @default(false) @map("farmer_confirmed")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tractor Tractor @relation(fields: [tractorId], references: [id])
  farmer  Farmer  @relation(fields: [farmerId], references: [id])

  @@map("tractor_bookings")
}

// ============================================================
// ESCROW & TRUST
// ============================================================

model EscrowPayment {
  id              String        @id @default(uuid())
  listingId       String        @map("listing_id")
  amount          Float
  status          PaymentStatus
  mpesaRef        String?       @map("mpesa_ref")
  depositedAt     DateTime?     @map("deposited_at")
  releasedAt      DateTime?     @map("released_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  listing LandListing @relation(fields: [listingId], references: [id])

  @@map("escrow_payments")
}

// ============================================================
// MARKET DATA
// ============================================================

model MarketPrice {
  id        String   @id @default(uuid())
  commodity String                  // e.g., "rice_sack_100kg"
  price     Float                   // In TZS
  market    String?                 // e.g., "Mafinga"
  source    String?
  recordedAt DateTime @map("recorded_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("market_prices")
}

// ============================================================
// AUDIT & SYSTEM
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String                    // e.g., "farmer.create", "payment.release"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SmsLog {
  id        String   @id @default(uuid())
  phone     String
  message   String
  type      String                  // "payment_confirmation", "alert", "notification"
  status    String   @default("pending")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sms_logs")
}

// ============================================================
// LOCATION: Tanzania Administrative Hierarchy (seeded from data.xlsx)
// ADM1 = Region, ADM2 = District, ADM3 = Ward
// ============================================================

model Region {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]

  @@map("regions")
}

model District {
  id       String @id @default(cuid())
  name     String
  regionId String @map("region_id")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  wards    Ward[]

  @@unique([name, regionId])
  @@map("districts")
}

model Ward {
  id         String   @id @default(cuid())
  name       String
  districtId String   @map("district_id")
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([name, districtId])
  @@map("wards")
}

// ============================================================
// PRODUCTION PLATFORM: Plots, Verification, Household, Documents
// ============================================================

model Plot {
  id                  String   @id @default(uuid())
  plotCode            String   @unique @map("plot_code")   // e.g., FP-JD-01-P1
  farmId              String   @map("farm_id")
  name                String?
  sizeAcres           Float?   @map("size_acres")
  soilCondition       String?  @map("soil_condition")
  irrigationStatus    String?  @map("irrigation_status")
  currentStage        String?  @map("current_stage")       // denormalized from active CropCycle
  boundaryCoordinates Json?    @map("boundary_coordinates")
  centerLatitude      Float?   @map("center_latitude")
  centerLongitude     Float?   @map("center_longitude")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  farm       Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropCycles CropCycle[]

  @@map("plots")
}

model FarmerVerification {
  id                String             @id @default(uuid())
  farmerId          String             @map("farmer_id")
  fieldOfficerId    String             @map("field_officer_id")
  status            VerificationStatus
  gpsVerified       Boolean            @default(false) @map("gps_verified")
  documentsReviewed Boolean            @default(false) @map("documents_reviewed")
  notes             String?
  rejectionReason   String?            @map("rejection_reason")
  gpsLatitude       Float?             @map("gps_latitude")
  gpsLongitude      Float?             @map("gps_longitude")
  verifiedAt        DateTime           @default(now()) @map("verified_at")

  farmer       Farmer       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  fieldOfficer FieldOfficer @relation(fields: [fieldOfficerId], references: [id])

  @@index([farmerId])
  @@map("farmer_verifications")
}

model Household {
  id                  String  @id @default(uuid())
  farmerId            String  @unique @map("farmer_id")
  householdSize       Int?    @map("household_size")
  dependents          Int?
  adultsCount         Int?    @map("adults_count")
  childrenCount       Int?    @map("children_count")
  primaryIncomeSource String? @map("primary_income_source")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("households")
}

model Document {
  id           String       @id @default(uuid())
  type         DocumentType
  fileUrl      String       @map("file_url")
  fileName     String       @map("file_name")
  mimeType     String?      @map("mime_type")
  sizeBytes    Int?         @map("size_bytes")
  farmerId     String?      @map("farmer_id")
  farmId       String?      @map("farm_id")
  uploadedById String?      @map("uploaded_by_id")
  verified     Boolean      @default(false)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  farmer Farmer? @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm   Farm?   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([farmId])
  @@map("documents")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String                          // e.g., "verification.pending", "activity.delayed"
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// Lightweight audit trail of farmer-facing actions, shown as the "Recent
// Activities" feed on the mobile dashboard (farm/plot/document events).
model Activity {
  id        String   @id @default(uuid())
  farmerId  String   @map("farmer_id")
  type      String                          // e.g., "farm.created", "plot.mapped"
  title     String
  subtitle  String?
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId, createdAt])
  @@map("activities")
}

// ============================================================
// SEASONS, OWNERSHIP, LEASES & SEASONAL ASSIGNMENTS
// ============================================================

model FarmingSeason {
  id                    String              @id @default(uuid())
  name                  String              @unique // e.g., "2026/2027 Masika"
  mamcosId              String?             @map("mamcos_id")
  region                String?
  crop                  String?
  startDate             DateTime            @map("start_date")
  endDate               DateTime            @map("end_date")
  registrationOpenDate  DateTime?           @map("registration_open_date")
  registrationCloseDate DateTime?           @map("registration_close_date")
  verificationDeadline  DateTime?           @map("verification_deadline")
  status                FarmingSeasonStatus @default(DRAFT)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  mamcos          Mamcos?                  @relation(fields: [mamcosId], references: [id])
  memberships     Membership[]
  leases          FarmLease[]
  assignments     SeasonalFarmAssignment[]
  rewardCampaigns RewardCampaign[]

  @@map("farming_seasons")
}

// Legal owner record — independent of who farms the land in a season.
model FarmOwnership {
  id                 String             @id @default(uuid())
  farmId             String             @map("farm_id")
  ownerFarmerId      String?            @map("owner_farmer_id")
  ownerName          String?            @map("owner_name")
  ownerPhone         String?            @map("owner_phone")
  source             OwnershipSource    @default(OWNER)
  confirmationStatus VerificationStatus @default(PENDING) @map("confirmation_status")
  confirmedAt        DateTime?          @map("confirmed_at")
  verifiedByUserId   String?            @map("verified_by_user_id")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  farm        Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ownerFarmer Farmer? @relation("LegalOwner", fields: [ownerFarmerId], references: [id])

  @@index([farmId])
  @@map("farm_ownerships")
}

model FarmLease {
  id                        String             @id @default(uuid())
  farmId                    String             @map("farm_id")
  ownerFarmerId             String?            @map("owner_farmer_id")
  renterFarmerId            String?            @map("renter_farmer_id")
  renterName                String?            @map("renter_name")
  renterPhone               String             @map("renter_phone")
  farmingSeasonId           String             @map("farming_season_id")
  leaseStartDate            DateTime           @map("lease_start_date")
  leaseEndDate              DateTime           @map("lease_end_date")
  ownerConfirmationStatus   VerificationStatus @default(PENDING) @map("owner_confirmation_status")
  renterConfirmationStatus  VerificationStatus @default(PENDING) @map("renter_confirmation_status")
  officerConfirmationStatus VerificationStatus @default(PENDING) @map("officer_confirmation_status")
  status                    LeaseStatus        @default(PENDING_VERIFICATION)
  notes                     String?
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  farm          Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ownerFarmer   Farmer?       @relation("LeaseOwner", fields: [ownerFarmerId], references: [id])
  renterFarmer  Farmer?       @relation("LeaseRenter", fields: [renterFarmerId], references: [id])
  farmingSeason FarmingSeason @relation(fields: [farmingSeasonId], references: [id])
  assignments   SeasonalFarmAssignment[]

  @@index([farmId, farmingSeasonId])
  @@index([renterPhone])
  @@map("farm_leases")
}

// Who actively farms a given farm in a given season (owner or verified renter).
model SeasonalFarmAssignment {
  id              String             @id @default(uuid())
  farmId          String             @map("farm_id")
  farmingSeasonId String             @map("farming_season_id")
  activeFarmerId  String             @map("active_farmer_id")
  leaseId         String?            @map("lease_id")
  assignmentType  AssignmentType     @map("assignment_type")
  status          VerificationStatus @default(PENDING)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  farm          Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmingSeason FarmingSeason @relation(fields: [farmingSeasonId], references: [id])
  activeFarmer  Farmer        @relation("ActiveFarmer", fields: [activeFarmerId], references: [id])
  lease         FarmLease?    @relation(fields: [leaseId], references: [id])

  // One primary seasonal operator per farm and season (data-integrity rule).
  @@unique([farmId, farmingSeasonId])
  @@map("seasonal_farm_assignments")
}

// ============================================================
// MEMBERSHIP (free registration, paid analytics)
// ============================================================

model MembershipPlan {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  priceTzs     Float    @map("price_tzs")
  durationType MembershipDurationType @default(SEASON) @map("duration_type")
  features     String[]
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("membership_plans")
}

model Membership {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  farmerId         String?          @map("farmer_id")
  planId           String           @map("plan_id")
  farmingSeasonId  String?          @map("farming_season_id")
  status           MembershipStatus @default(PAYMENT_PENDING)
  paymentStatus    PaymentStatus    @default(PENDING) @map("payment_status")
  paymentReference String?          @map("payment_reference")
  orderReference   String?          @unique @map("order_reference") // ClickPesa order reference
  amountTzs        Float?           @map("amount_tzs")
  startDate        DateTime?        @map("start_date")
  endDate          DateTime?        @map("end_date")
  activatedAt      DateTime?        @map("activated_at")
  expiryReminderSentAt DateTime?    @map("expiry_reminder_sent_at")
  approvedByUserId String?          @map("approved_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmer        Farmer?        @relation(fields: [farmerId], references: [id])
  plan          MembershipPlan @relation(fields: [planId], references: [id])
  farmingSeason FarmingSeason? @relation(fields: [farmingSeasonId], references: [id])
  payments      Payment[]

  @@index([userId, status])
  @@map("memberships")
}

// ============================================================
// FARM-ACTION ALERTS (free preview, premium recommendation)
// ============================================================

model FarmAlert {
  id                 String        @id @default(uuid())
  farmId             String        @map("farm_id")
  plotId             String?       @map("plot_id")
  farmerId           String?       @map("farmer_id") // active/target farmer
  farmingSeasonId    String?       @map("farming_season_id")
  cropCycleId        String?       @map("crop_cycle_id")
  category           AlertCategory
  urgency            AlertUrgency  @default(MEDIUM)
  title              String
  // Shown to everyone (free preview): what & where, no diagnosis.
  previewMessage     String        @map("preview_message")
  // Premium-only: stripped from API responses for non-members.
  recommendation     String?
  actionDetails      String?       @map("action_details")
  expectedActionDate DateTime?     @map("expected_action_date")
  // Dedupe key so the generator doesn't repeat the same open alert.
  dedupeKey          String?       @map("dedupe_key")
  status             AlertStatus   @default(OPEN)
  completedAt        DateTime?     @map("completed_at")
  completedByUserId  String?       @map("completed_by_user_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([farmId, status])
  @@map("farm_alerts")
}

// ============================================================
// FARMER REWARDS & INCENTIVES (auditable selection)
// ============================================================

model RewardCampaign {
  id                   String               @id @default(uuid())
  name                 String
  description          String?
  sponsor              String?
  rewardType           RewardType           @map("reward_type")
  rewardQuantity       Int                  @default(1) @map("reward_quantity") // per winner
  numberOfWinners      Int                  @default(1) @map("number_of_winners")
  farmingSeasonId      String?              @map("farming_season_id")
  eligibleCooperatives String[]             @map("eligible_cooperatives")
  eligibilityStartDate DateTime?            @map("eligibility_start_date")
  eligibilityEndDate   DateTime?            @map("eligibility_end_date")
  selectionMethod      SelectionMethod      @default(RANDOM) @map("selection_method")
  status               RewardCampaignStatus @default(DRAFT)

  // Auditable selection record (prompt §16): reproducible from seed + snapshot.
  selectionSeed             String?  @map("selection_seed")
  selectionAlgorithmVersion String?  @map("selection_algorithm_version")
  eligibleSnapshot          Json?    @map("eligible_snapshot") // farmer ids considered
  selectedAt                DateTime? @map("selected_at")
  createdByUserId           String?  @map("created_by_user_id")
  approvedByUserId          String?  @map("approved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farmingSeason FarmingSeason? @relation(fields: [farmingSeasonId], references: [id])
  winners       RewardWinner[]

  @@map("reward_campaigns")
}

model RewardWinner {
  id         String             @id @default(uuid())
  campaignId String             @map("campaign_id")
  farmerId   String             @map("farmer_id")
  farmId     String?            @map("farm_id")
  rewardType RewardType         @map("reward_type")
  quantity   Int                @default(1)
  status     RewardWinnerStatus @default(SELECTED)
  notifiedAt DateTime?          @map("notified_at")
  confirmedAt DateTime?         @map("confirmed_at")
  notes      String?
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  campaign RewardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  farmer   Farmer         @relation(fields: [farmerId], references: [id])

  // One award per farmer per campaign (no duplicate winners).
  @@unique([campaignId, farmerId])
  @@index([farmerId])
  @@map("reward_winners")
}

// ============================================================
// AMCOS-FIRST FARM REGISTRY (pre-registration before owner has an account)
// ============================================================

// A farm pre-registered by a cooperative (prompt2 §2, §22). It exists before the
// owner has an account; when the owner registers and confirms, it is materialized
// into a real Farm (`farmId` links the two).
model FarmRegistryRecord {
  id               String   @id @default(uuid())
  sourceMamcosId   String?  @map("source_mamcos_id")
  sourceOfficerId  String?  @map("source_officer_id") // user id who entered it
  ownerName        String   @map("owner_name")
  ownerPhone       String   @map("owner_phone")
  ownerNationalId  String?  @map("owner_national_id")
  name             String?
  plotNumber       String?  @map("plot_number")
  block            String?
  canal            String?
  scheme           String?
  section          String?
  village          String?
  ward             String?
  district         String?
  region           String?
  farmSizeHectares Float?   @map("farm_size_hectares")
  status           FarmRegistryStatus @default(OWNER_CONFIRMATION_PENDING)
  notes            String?
  farmId           String?  @unique @map("farm_id") // set once claimed/materialized
  claimedByFarmerId String? @map("claimed_by_farmer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  mamcos Mamcos? @relation(fields: [sourceMamcosId], references: [id])

  @@index([ownerPhone, status])
  @@map("farm_registry_records")
}

// ============================================================
// FARM MEDIA & FIELD DATA (for the printable analytics report)
// ============================================================

model FarmPhoto {
  id           String   @id @default(uuid())
  farmId       String   @map("farm_id")
  url          String
  caption      String?
  latitude     Float?
  longitude    Float?
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@map("farm_photos")
}

// One field visit's data (owner comment §2.6 / prompt2 §15): GPS, soil, road &
// water access, and physical characteristics collected by a MAYODE officer.
model FarmFieldSurvey {
  id                  String         @id @default(uuid())
  farmId              String         @map("farm_id")
  surveyedById        String?        @map("surveyed_by_id")
  surveyDate          DateTime       @default(now()) @map("survey_date")
  source              FarmDataSource @default(FIELD_OFFICER)

  // Soil
  soilPh            Float?  @map("soil_ph")
  soilTexture       String? @map("soil_texture")
  soilOrganicMatter Float?  @map("soil_organic_matter") // %
  soilNotes         String? @map("soil_notes")

  // Road & water access
  roadDistanceMeters  Int?    @map("road_distance_meters")
  roadAccessQuality   String? @map("road_access_quality") // GOOD | FAIR | POOR
  waterSource         String? @map("water_source")
  waterDistanceMeters Int?    @map("water_distance_meters")
  waterReliability    String? @map("water_reliability")

  // Physical
  slope        String?
  floodRisk    String? @map("flood_risk")
  observations String?
  latitude     Float?
  longitude    Float?

  createdAt DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@map("farm_field_surveys")
}

