model Role {
  id          String    @id @default(uuid())
  // Unique per scope: platform roles (mamcosId null) are checked in RolesService,
  // cooperative roles by the composite index below.
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  systemRole  UserRole? @map("system_role")
  isActive    Boolean   @default(true) @map("is_active")
  // Cooperative this role belongs to. Null = platform role, managed by Super Admin.
  mamcosId    String?   @map("mamcos_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  mamcos      Mamcos?          @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       User[]

  @@unique([mamcosId, name])
  @@map("roles")
}

model Resource {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at")

