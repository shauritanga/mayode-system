// ============================================================
// MAYODE GROUP Integrated System — Prisma Database Schema
// ============================================================
// PostgreSQL. GPS boundaries stored as GeoJSON (Json), so no
// PostGIS extension is required.
// Covers: Users, Farmers, Farms, Plots, MAMCOS, Crop Cycles,
//         Verification, Documents, Notifications,
//         Payments, Inventory, Buyers, M-LAX Marketplace
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// CORE: User & Authentication
// ============================================================

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  phone              String    @unique
  passwordHash       String    @map("password_hash")
  firstName          String?   @map("first_name")
  lastName           String?   @map("last_name")
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  language           String    @default("sw") // sw = Swahili, en = English
  pushToken          String?   @map("push_token") // Expo Push Notification Token
  profilePhotoUrl    String?   @map("profile_photo_url")
  lastLoginAt        DateTime? @map("last_login_at")
  /// Last time the mobile app synced its offline data to the server.
  lastSyncAt         DateTime? @map("last_sync_at")
  /// Set when staff are given a temporary password; cleared once they choose their own.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  roleId   String? @map("role_id")
  // Cooperative this account belongs to (staff/admin accounts created inside an
  // AMCOS). Null = platform account. Farmer/staff profiles may also carry an
  // AMCOS; JwtStrategy resolves the effective tenant from all three.
  mamcosId String? @map("mamcos_id")

  // Relations
  mamcos        Mamcos?           @relation("UserMamcos", fields: [mamcosId], references: [id], onDelete: SetNull)
  farmer        Farmer?
  mamcosStaff   MamcosStaff?
  payrollPayees PayrollPayee[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  memberships   Membership[]
  dispatches    Dispatch[]
  keeperOf      WarehouseKeeper[] @relation("WarehouseKeeperUser")
  customRole    Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([mamcosId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// One-time sign-in code sent by SMS. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("LOGIN")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

model PartnerApiKey {
  id          String              @id @default(uuid())
  partnerName String              @map("partner_name")
  keyPrefix   String              @unique @map("key_prefix")
  keyHash     String              @map("key_hash")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  lastUsedAt  DateTime?           @map("last_used_at")
  requests    PartnerApiRequest[]

  @@map("partner_api_keys")
}

model PartnerApiRequest {
  id           String        @id @default(uuid())
  apiKeyId     String        @map("api_key_id")
  farmerId     String?       @map("farmer_id")
  endpoint     String
  ipAddress    String?       @map("ip_address")
  responseCode Int           @map("response_code")
  createdAt    DateTime      @default(now()) @map("created_at")
  apiKey       PartnerApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([farmerId, createdAt])
  @@map("partner_api_requests")
}

// ============================================================
// CORE: Farmer Profile
// ============================================================

model Farmer {
  id            String        @id @default(uuid())
  userId        String        @unique @map("user_id")
  controlNumber String        @unique @map("control_number") // Auto-generated: MYD-00001
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  dateOfBirth   DateTime?     @map("date_of_birth")
  gender        Gender?
  /// The NIDA number, when the farmer has one (kept for national referencing); see idType/idNumber for the primary ID.
  nationalId    String?       @unique @map("national_id")
  /// The primary ID the farmer registered with. NIDA is optional; a voter ID or driver's license is accepted instead.
  idType        FarmerIdType? @map("id_type")
  idNumber      String?       @map("id_number")
  photoUrl      String?       @map("photo_url")
  village       String?
  ward          String?
  district      String?       @default("Mbarali")
  region        String?       @default("Mbeya")
  familySize    Int?          @map("family_size")

  // Extended profile (rice-production platform)
  email                  String?
  residenceLatitude      Float?          @map("residence_latitude")
  residenceLongitude     Float?          @map("residence_longitude")
  educationLevel         EducationLevel? @map("education_level")
  farmingExperienceYears Int?            @map("farming_experience_years")
  dependents             Int?

  // Verification workflow
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedById       String?            @map("verified_by_id")
  verifiedAt         DateTime?          @map("verified_at")

  // Which field officer is responsible for following up on this farmer —
  // loose id reference (no @relation), matching the verifiedById convention
  // above. Powers the "pending tasks per officer" admin view.
  assignedOfficerId     String? @map("assigned_officer_id")
  /// Field officer who registered this farmer (loose id reference to MamcosStaff).
  registeredByOfficerId String? @map("registered_by_officer_id")

  membershipDate   DateTime  @default(now()) @map("membership_date")
  creditScore      Float     @default(0) @map("credit_score")
  dataShareConsent Boolean   @default(false) @map("data_share_consent")
  /// Agreed to receive weather alerts on WhatsApp.
  whatsappOptIn    Boolean   @default(false) @map("whatsapp_opt_in")
  consentedAt      DateTime? @map("consented_at")
  isBlacklisted    Boolean   @default(false) @map("is_blacklisted")
  blacklistReason  String?   @map("blacklist_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  user                      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  localVerifications        FarmerLocalVerification[]      @relation("LocalVerificationFarmer")
  guaranteedVerifications   FarmerLocalVerification[]      @relation("LocalVerificationGuarantor")
  mamcosId                  String?                        @map("mamcos_id")
  farmerDues                FarmerDue[]
  guardianships             IrrigationHectareGuardian[]    @relation("FarmerGuardianships")
  duePayments               DuePayment[]
  mamcos                    Mamcos?                        @relation(fields: [mamcosId], references: [id])
  farms                     Farm[]
  cropCycles                CropCycle[]
  payments                  Payment[]                      @relation("FarmerPayments")
  landListings              LandListing[]                  @relation("LandOwner")
  rentals                   LandListing[]                  @relation("LandRenter")
  previousRentals           LandListing[]                  @relation("LandPreviousRenter")
  landCodeClaims            LandListing[]                  @relation("LandCodeHolder")
  landCodeAttempts          LandListingCodeAttempt[]
  subLeasesAsOriginalRenter LandListingSubLease[]          @relation("SubLeaseOriginalRenter")
  subLeasesAsNewRenter      LandListingSubLease[]          @relation("SubLeaseNewRenter")
  ownershipTransfersFrom    LandListingOwnershipTransfer[] @relation("TransferFromOwner")
  ownershipTransfersTo      LandListingOwnershipTransfer[] @relation("TransferToOwner")
  escrowPayouts             EscrowPayment[]
  landListingOffers         LandListingOffer[]
  landListingImprovements   LandListingImprovement[]
  tractorBookings           TractorBooking[]
  inventoryRecords          InventoryRecord[]
  loanRecords               LoanRecord[]
  loanApplications          LoanApplication[]
  insuranceApplications     InsuranceApplication[]
  household                 Household?
  documents                 Document[]
  verifications             FarmerVerification[]
  memberships               Membership[]
  memberContributions       MemberContribution[]
  farmOwnerships            FarmOwnership[]                @relation("LegalOwner")
  leasesAsOwner             FarmLease[]                    @relation("LeaseOwner")
  leasesAsRenter            FarmLease[]                    @relation("LeaseRenter")
  seasonalAssignments       SeasonalFarmAssignment[]       @relation("ActiveFarmer")
  rewardWins                RewardWinner[]
  activities                Activity[]
  officerVisits             FieldOfficerVisit[]
  saleApportionments        SaleApportionment[]
  voteResponses             VoteResponse[]
  consentRecords            ConsentRecord[]
  questionnaires            FarmerQuestionnaire[]
  insurancePolicies         InsurancePolicy[]
  goodsReceipts             GoodsReceipt[]
  irrigationAllocations     IrrigationHectareAllocation[]
  irrigationTransfersFrom   IrrigationAllocationTransfer[] @relation("TransferFromFarmer")
  irrigationTransfersTo     IrrigationAllocationTransfer[] @relation("TransferToFarmer")
  irrigationLeaderships     IrrigationLeadership[]
  boardSeats                BoardMember[]
  meetingAttendances        MeetingAttendance[]
  farmDefaultCases          FarmDefaultCase[]
  joinRequests              AmcosJoinRequest[]
  communicationReceipts     CommunicationRecipient[]

  farmerPayouts FarmerPayout[]

  @@map("farmers")
}

// ============================================================
// CORE: Field Officer
// ============================================================

enum MamcosStaffRole {
  SECRETARY
  FIELD_OFFICER
}

// A staff member belonging to one AMCOS, with a role. Unifies what used to
// be two separate tables (FieldOfficer, MamcosSecretary) so a future staff
// role is just a new enum value, not a new model. "One secretary per AMCOS"
// is enforced via a partial unique index added by raw SQL in the migration
// (mamcos_id WHERE role = 'SECRETARY') — Prisma's schema DSL can't express
// partial indexes, so it isn't declared here, but the DB still enforces it.
model MamcosStaff {
  id             String          @id @default(uuid())
  userId         String          @unique @map("user_id")
  // Nullable: existing officers predate AMCOS scoping.
  mamcosId       String?         @map("mamcos_id")
  role           MamcosStaffRole
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  // Field-officer only.
  employeeCode   String?         @unique @map("employee_code")
  assignedArea   String?         @map("assigned_area")
  region         String?
  district       String?
  // Secretary only.
  stabilityBonus Float           @default(0) @map("stability_bonus")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mamcos              Mamcos?              @relation(fields: [mamcosId], references: [id])
  farmVerifications   FarmVerification[]
  farmerVerifications FarmerVerification[]
  activityLogs        ActivityLog[]
  visits              FieldOfficerVisit[]
  facilitatedListings LandListing[]

  @@index([mamcosId])
  @@map("mamcos_staff")
}

// ============================================================
// CORE: MAMCOS (Cooperative Schemes)
// ============================================================

model Mamcos {
  id                  String   @id @default(uuid())
  amcosMeetings       AmcosMeeting[]
  tenders             Tender[]
  payrollJobTitles    PayrollJobTitle[]
  name                String   @unique
  /// Short code a farmer types on sign-up to ask to join this AMCOS (e.g. MDB-4F2A91).
  code                String?  @unique
  location            String?
  district            String?  @default("Mbarali")
  totalHectares       Float?   @map("total_hectares")
  chairmanName        String?  @map("chairman_name")
  chairmanPhone       String?  @map("chairman_phone")
  /// What a tool owned by someone else pays once to be registered with this AMCOS (TZS). Null/0 = no fee.
  /// Tax identity and VAT status, printed on invoices and used by the VAT return.
  tin                 String?
  vrn                 String?
  vatRegistered       Boolean  @default(false) @map("vat_registered")
  /// Standard VAT rate in percent (Tanzania: 18).
  vatRate             Decimal  @default(18) @map("vat_rate") @db.Decimal(5, 2)
  toolRegistrationFee Decimal? @map("tool_registration_fee") @db.Decimal(12, 2)
  /// What any tool, owned by the AMCOS or not, contributes per hectare it works (TZS), unless the tool has its own rate.
  toolFeePerHectare   Decimal? @map("tool_fee_per_hectare") @db.Decimal(12, 2)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  premiumFundEntries PremiumFundEntry[]
  projects           CommunityProject[]
  meetings           MeetingRecord[]
  votes              Vote[]

  // Relations
  staff                 MamcosStaff[]
  accounts              User[]                 @relation("UserMamcos")
  roles                 Role[]
  farmers               Farmer[]
  farms                 Farm[]
  farmingSeasons        FarmingSeason[]
  registryRecords       FarmRegistryRecord[]
  riceProtocols         RiceProtocol[]
  irrigationSchemes     IrrigationScheme[]
  joinRequests          AmcosJoinRequest[]
  equipment             AmcosEquipment[]
  communications        Communication[]
  boardMembers          BoardMember[]
  farmDefaultCases      FarmDefaultCase[]
  ledgerEntries         LedgerEntry[]
  charges               AmcosCharge[]
  equipmentTypes        AmcosEquipmentType[]
  cashAccounts          CashAccount[]
  cashTransfers         CashTransfer[]
  suppliers             Supplier[]
  farmerPayouts         FarmerPayout[]
  accountingLock        AccountingLock?
  bankStatements        BankStatement[]
  cashTransactions      CashTransaction[]
  invoices              Invoice[]
  bills                 Bill[]
  machineryActivities   MachineryActivity[]
  aggregationCentres    AggregationCentre[]
  buyers                Buyer[]
  warehouses            Warehouse[]
  collectionCentres     CollectionCentre[]
  memberContributions   MemberContribution[]
  reserveAllocations    ReserveAllocation[]
  budgets               Budget[]
  assets                Asset[]
  assetDepreciationRuns AssetDepreciationRun[]
  payrollPayees         PayrollPayee[]
  payrollRuns           PayrollRun[]
  farmerDueTypes        FarmerDueType[]
  farmerDues            FarmerDue[]
  duePayments           DuePayment[]

  @@map("mamcos")
}

model IrrigationScheme {
  id               String   @id @default(uuid())
  mamcosId         String?  @map("mamcos_id")
  name             String
  schemeType       String?  @map("scheme_type")
  coverageHectares Float?   @map("coverage_hectares")
  waterSource      String?  @map("water_source")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  // Irrigation Scheme Management (canals → blocks → hectare units)
  code                       String?          @unique
  region                     String?
  district                   String?
  ward                       String?
  village                    String?
  description                String?
  establishedOn              DateTime?        @map("established_on") @db.Date
  status                     IrrigationStatus @default(ACTIVE)
  /// Planning targets used for setup alerts; they never block data entry except maxBlocksPerCanal / hectaresPerBlock.
  plannedCanalCount          Int              @default(6) @map("planned_canal_count")
  minBlocksPerCanal          Int              @default(15) @map("min_blocks_per_canal")
  maxBlocksPerCanal          Int              @default(16) @map("max_blocks_per_canal")
  hectaresPerBlock           Decimal          @default(30) @map("hectares_per_block") @db.Decimal(8, 2)
  /// Allocation policy: null = a member may hold any number of hectares.
  maxHectaresPerFarmer       Int?             @map("max_hectares_per_farmer")
  requireAllocationApproval  Boolean          @default(false) @map("require_allocation_approval")
  /// Transfers wait for the receiving member to accept (SMS + app) before any approval or execution.
  requireRecipientAcceptance Boolean          @default(true) @map("require_recipient_acceptance")
  /// A new allocation made by anyone but the block's own chairman waits for the block or canal chairman to confirm the farmer is the real cultivator. Skipped for a block with no chairman.
  requireChairmanVerification Boolean         @default(true) @map("require_chairman_verification")
  createdById                String?          @map("created_by_id")
  updatedById                String?          @map("updated_by_id")
  updatedAt                  DateTime         @default(now()) @updatedAt @map("updated_at")

  mamcos    Mamcos?              @relation(fields: [mamcosId], references: [id])
  canals    IrrigationCanal[]
  documents IrrigationDocument[]

  @@index([mamcosId])
  @@map("irrigation_schemes")
}

enum IrrigationStatus {
  PLANNED
  ACTIVE
  UNDER_MAINTENANCE
  INACTIVE
}

/// Which side of its canal a block lies on, looking downstream.
enum IrrigationBlockSide {
  LEFT
  RIGHT
}

model IrrigationCanal {
  id                  String           @id @default(uuid())
  schemeId            String           @map("scheme_id")
  canalNumber         Int              @map("canal_number")
  code                String
  name                String
  status              IrrigationStatus @default(ACTIVE)
  description         String?
  lengthKm            Decimal?         @map("length_km") @db.Decimal(8, 2)
  headworks           String?
  infrastructureNotes String?          @map("infrastructure_notes")
  createdById         String?          @map("created_by_id")
  updatedById         String?          @map("updated_by_id")
  archivedAt          DateTime?        @map("archived_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  scheme       IrrigationScheme       @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  blocks       IrrigationBlock[]
  leaderships  IrrigationLeadership[]
  documents    IrrigationDocument[]
  harvestRates HarvestFeeRate[]

  @@unique([schemeId, canalNumber])
  @@unique([schemeId, code])
  @@map("irrigation_canals")
}

model IrrigationBlock {
  id                  String               @id @default(uuid())
  canalId             String               @map("canal_id")
  blockNumber         Int                  @map("block_number")
  code                String
  name                String?
  /// Left or right of the canal. Null only for blocks created before this was recorded.
  side                IrrigationBlockSide?
  areaHectares        Decimal              @map("area_hectares") @db.Decimal(10, 2)
  /// Number of 1-hectare allocation units generated for this block.
  hectareCount        Int                  @map("hectare_count")
  status              IrrigationStatus     @default(ACTIVE)
  description         String?
  boundaryCoordinates Json?                @map("boundary_coordinates")
  centerLatitude      Float?               @map("center_latitude")
  centerLongitude     Float?               @map("center_longitude")
  boundaryNotes       String?              @map("boundary_notes")
  createdById         String?              @map("created_by_id")
  updatedById         String?              @map("updated_by_id")
  archivedAt          DateTime?            @map("archived_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  canal               IrrigationCanal        @relation(fields: [canalId], references: [id], onDelete: Restrict)
  hectares            IrrigationHectare[]
  leaderships         IrrigationLeadership[]
  documents           IrrigationDocument[]
  harvestRates        HarvestFeeRate[]
  machineryActivities MachineryActivity[]

  @@unique([canalId, blockNumber])
  @@unique([canalId, code])
  @@map("irrigation_blocks")
}

model IrrigationHectare {
  id            String   @id @default(uuid())
  blockId       String   @map("block_id")
  hectareNumber Int      @map("hectare_number")
  code          String
  areaHectares  Decimal  @default(1) @map("area_hectares") @db.Decimal(8, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  block         IrrigationBlock                @relation(fields: [blockId], references: [id], onDelete: Restrict)
  allocations   IrrigationHectareAllocation[]
  transfers     IrrigationAllocationTransfer[]
  landListings  LandListing[]
  rentalRecords AmcosRentalRecord[]
  emancipations IrrigationEmancipationRequest[]

  @@unique([blockId, hectareNumber])
  @@map("irrigation_hectares")
}

enum HectareAllocationStatus {
  PENDING_APPROVAL
  ACTIVE
  ENDED
  REJECTED
}

/// One row per period a member holds a hectare. The partial unique index
/// irrigation_hectare_allocations_one_open_per_hectare (raw SQL in the migration) allows a
/// single PENDING_APPROVAL/ACTIVE row per hectare. Rows are never deleted or overwritten.
model IrrigationHectareAllocation {
  id             String                  @id @default(uuid())
  hectareId      String                  @map("hectare_id")
  farmerId       String                  @map("farmer_id")
  status         HectareAllocationStatus
  allocatedOn    DateTime                @map("allocated_on") @db.Date
  endedOn        DateTime?               @map("ended_on") @db.Date
  endReason      String?                 @map("end_reason")
  notes          String?
  requestedById  String?                 @map("requested_by_id")
  approvedById   String?                 @map("approved_by_id")
  approvedAt     DateTime?               @map("approved_at")
  rejectedReason String?                 @map("rejected_reason")
  /// Waiting for the block or canal chairman to confirm the cultivator before the allocation can go live.
  awaitingChairman     Boolean           @default(false) @map("awaiting_chairman")
  chairmanVerifiedById String?           @map("chairman_verified_by_id")
  chairmanVerifiedAt   DateTime?         @map("chairman_verified_at")
  chairmanNote         String?           @map("chairman_note")
  endedById      String?                 @map("ended_by_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  hectare       IrrigationHectare              @relation(fields: [hectareId], references: [id], onDelete: Restrict)
  farmer        Farmer                         @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  transfersFrom IrrigationAllocationTransfer[] @relation("TransferFromAllocation")
  transfersTo   IrrigationAllocationTransfer[] @relation("TransferToAllocation")
  guardians     IrrigationHectareGuardian[]

  @@index([hectareId, status])
  @@index([farmerId, status])
  @@map("irrigation_hectare_allocations")
}

enum IrrigationTransferStatus {
  AWAITING_RECIPIENT
  PENDING_APPROVAL
  COMPLETED
  REJECTED
  CANCELLED
}

model IrrigationAllocationTransfer {
  id                   String                   @id @default(uuid())
  hectareId            String                   @map("hectare_id")
  fromAllocationId     String                   @map("from_allocation_id")
  toAllocationId       String?                  @map("to_allocation_id")
  fromFarmerId         String                   @map("from_farmer_id")
  toFarmerId           String                   @map("to_farmer_id")
  transferDate         DateTime                 @map("transfer_date") @db.Date
  effectiveDate        DateTime                 @map("effective_date") @db.Date
  reason               String
  status               IrrigationTransferStatus
  requestedById        String?                  @map("requested_by_id")
  approvedById         String?                  @map("approved_by_id")
  approvedAt           DateTime?                @map("approved_at")
  processedById        String?                  @map("processed_by_id")
  processedAt          DateTime?                @map("processed_at")
  rejectedReason       String?                  @map("rejected_reason")
  /// When the receiving member accepted or declined (null while AWAITING_RECIPIENT or if acceptance was not required).
  recipientRespondedAt DateTime?                @map("recipient_responded_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  hectare        IrrigationHectare            @relation(fields: [hectareId], references: [id], onDelete: Restrict)
  fromAllocation IrrigationHectareAllocation  @relation("TransferFromAllocation", fields: [fromAllocationId], references: [id], onDelete: Restrict)
  toAllocation   IrrigationHectareAllocation? @relation("TransferToAllocation", fields: [toAllocationId], references: [id], onDelete: Restrict)
  fromFarmer     Farmer                       @relation("TransferFromFarmer", fields: [fromFarmerId], references: [id], onDelete: Restrict)
  toFarmer       Farmer                       @relation("TransferToFarmer", fields: [toFarmerId], references: [id], onDelete: Restrict)
  documents      IrrigationDocument[]

  @@index([hectareId, status])
  @@map("irrigation_allocation_transfers")
}

enum IrrigationLeadershipPosition {
  CANAL_LEADER
  BLOCK_LEADER
}

enum IrrigationLeadershipStatus {
  ACTIVE
  ENDED
}

/// Appointment history. Partial unique indexes (raw SQL in the migration) allow one ACTIVE canal
/// leader per canal and one ACTIVE block leader per block. Ended rows are kept for the audit trail.
model IrrigationLeadership {
  id           String                       @id @default(uuid())
  position     IrrigationLeadershipPosition
  canalId      String                       @map("canal_id")
  blockId      String?                      @map("block_id")
  farmerId     String                       @map("farmer_id")
  appointedOn  DateTime                     @map("appointed_on") @db.Date
  termStart    DateTime                     @map("term_start") @db.Date
  termEnd      DateTime?                    @map("term_end") @db.Date
  status       IrrigationLeadershipStatus   @default(ACTIVE)
  notes        String?
  endedOn      DateTime?                    @map("ended_on") @db.Date
  endReason    String?                      @map("end_reason")
  replacedById String?                      @map("replaced_by_id")
  recordedById String?                      @map("recorded_by_id")
  endedById    String?                      @map("ended_by_id")
  createdAt    DateTime                     @default(now()) @map("created_at")
  updatedAt    DateTime                     @updatedAt @map("updated_at")

  canal      IrrigationCanal        @relation(fields: [canalId], references: [id], onDelete: Restrict)
  block      IrrigationBlock?       @relation(fields: [blockId], references: [id], onDelete: Restrict)
  farmer     Farmer                 @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  replacedBy IrrigationLeadership?  @relation("LeadershipReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   IrrigationLeadership[] @relation("LeadershipReplacement")
  documents  IrrigationDocument[]

  @@index([canalId, status])
  @@index([blockId, status])
  @@index([farmerId])
  @@map("irrigation_leaderships")
}

enum IrrigationDocumentType {
  REGISTRATION
  SURVEY_MAP
  ALLOCATION_LETTER
  TRANSFER_SUPPORT
  APPOINTMENT_LETTER
  INFRASTRUCTURE
  OTHER
}

model IrrigationDocument {
  id           String                 @id @default(uuid())
  schemeId     String                 @map("scheme_id")
  canalId      String?                @map("canal_id")
  blockId      String?                @map("block_id")
  transferId   String?                @map("transfer_id")
  leadershipId String?                @map("leadership_id")
  type         IrrigationDocumentType @default(OTHER)
  title        String
  fileUrl      String                 @map("file_url")
  fileName     String                 @map("file_name")
  mimeType     String?                @map("mime_type")
  sizeBytes    Int?                   @map("size_bytes")
  uploadedById String?                @map("uploaded_by_id")
  archivedAt   DateTime?              @map("archived_at")
  createdAt    DateTime               @default(now()) @map("created_at")

  scheme     IrrigationScheme              @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  canal      IrrigationCanal?              @relation(fields: [canalId], references: [id], onDelete: Restrict)
  block      IrrigationBlock?              @relation(fields: [blockId], references: [id], onDelete: Restrict)
  transfer   IrrigationAllocationTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)
  leadership IrrigationLeadership?         @relation(fields: [leadershipId], references: [id], onDelete: Restrict)

  @@index([schemeId])
  @@index([canalId])
  @@index([blockId])
  @@index([transferId])
  @@map("irrigation_documents")
}

model AggregationCentre {
  id            String   @id @default(uuid())
  mamcosId      String?  @map("mamcos_id")
  name          String
  location      String?
  capacityKg    Float?   @map("capacity_kg")
  contactPerson String?  @map("contact_person")
  contactPhone  String?  @map("contact_phone")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  mamcos Mamcos? @relation(fields: [mamcosId], references: [id])

  @@map("aggregation_centres")
}

// ============================================================
// CORE: Farm (Multi-farm per farmer)
// ============================================================

model Farm {
  id                    String    @id @default(uuid())
  farmCode              String    @unique @map("farm_code") // e.g., FP-JD-01
  /// Field officer who registered / mapped this farm, and the one now responsible for it
  /// (loose id references to MamcosStaff).
  registeredByOfficerId String?   @map("registered_by_officer_id")
  assignedOfficerId     String?   @map("assigned_officer_id")
  // Official farms are owned by AMCOS. This remains only for legacy records;
  // a verified SeasonalFarmAssignment grants renter operating access.
  farmerId              String?   @map("farmer_id")
  mamcosId              String?   @map("mamcos_id")
  name                  String
  plotNumber            String?   @map("plot_number")
  blockNumber           String?   @map("block_number")
  canal                 String?
  section               String?
  village               String?
  subVillage            String?   @map("sub_village") // kitongoji
  ward                  String?
  district              String?
  region                String?
  socialHectares        Float     @map("social_hectares") // The "social" unit
  actualAcres           Float?    @map("actual_acres") // GPS-verified actual size
  grade                 FarmGrade @default(B)
  vichuguuCount         Int       @default(0) @map("vichuguu_count")
  hasIrrigation         Boolean   @default(false) @map("has_irrigation")
  nearRoad              Boolean   @default(false) @map("near_road")
  soilCondition         String?   @map("soil_condition")
  photoUrls             String[]  @map("photo_urls")

  // Extended farm characteristics
  ownershipType      OwnershipType?  @map("ownership_type")
  ownerName          String?         @map("owner_name")
  ownerPhone         String?         @map("owner_phone")
  landTenure         String?         @map("land_tenure")
  soilType           String?         @map("soil_type")
  soilFertility      String?         @map("soil_fertility")
  waterSource        String?         @map("water_source")
  irrigationMethod   String?         @map("irrigation_method")
  accessibility      String?
  previousCrops      String[]        @map("previous_crops")
  /// Mayode Farms operations: the person who runs this farm, whether it is one of Mayode's own, and whether it is in use.
  managerUserId      String?         @map("manager_user_id")
  isMayodeFarm       Boolean         @default(false) @map("is_mayode_farm")
  isActive           Boolean         @default(true) @map("is_active")
  isVerified         Boolean         @default(false) @map("is_verified")
  isAvailableForRent Boolean         @default(false) @map("is_available_for_rent")
  isLeased           Boolean         @default(false) @map("is_leased")
  leaseLockedUntil   DateTime?       @map("lease_locked_until")
  /// Overdue-debt handling: NORMAL unless the owner's debt is past the grace period (see FarmDefaultCase).
  adminStatus        FarmAdminStatus @default(NORMAL) @map("admin_status")
  adminCaseId        String?         @map("admin_case_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // GPS Boundary (stored as GeoJSON polygon via PostGIS)
  // We store coordinates as JSON since Prisma doesn't natively support PostGIS geometry
  boundaryCoordinates Json?  @map("boundary_coordinates")
  centerLatitude      Float? @map("center_latitude")
  centerLongitude     Float? @map("center_longitude")

  // Relations
  farmer               Farmer?                    @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  mamcos               Mamcos?                    @relation(fields: [mamcosId], references: [id])
  plots                Plot[]
  cropCycles           CropCycle[]
  landListings         LandListing[]
  verifications        FarmVerification[]
  inventoryRecords     InventoryRecord[]
  documents            Document[]
  ownerships           FarmOwnership[]
  leases               FarmLease[]
  seasonalAssignments  SeasonalFarmAssignment[]
  alerts               FarmAlert[]
  photos               FarmPhoto[]
  fieldSurveys         FarmFieldSurvey[]
  disputes             Dispute[]
  suggestedUpdates     SuggestedFarmUpdate[]
  dataValues           FarmDataValue[]
  confirmationRequests OwnerConfirmationRequest[]
  officerVisits        FieldOfficerVisit[]
  questionnaires       FarmerQuestionnaire[]
  aiIntegrationRecords AiIntegrationRecord[]
  insurancePolicies    InsurancePolicy[]
  goodsReceipts        GoodsReceipt[]
  farmTasks            FarmTask[]
  harvestRecords       HarvestRecord[]

  @@map("farms")
}

model FarmVerification {
  id             String   @id @default(uuid())
  farmId         String   @map("farm_id")
  fieldOfficerId String   @map("field_officer_id")
  verifiedAt     DateTime @default(now()) @map("verified_at")
  gpsVerified    Boolean  @default(false) @map("gps_verified")
  neighborLeft   String?  @map("neighbor_left")
  neighborRight  String?  @map("neighbor_right")
  mamcosApproved Boolean  @default(false) @map("mamcos_approved")
  photoProofUrl  String?  @map("photo_proof_url")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  farm         Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldOfficer MamcosStaff @relation(fields: [fieldOfficerId], references: [id])

  @@map("farm_verifications")
}

// ============================================================
// PRODUCTION: Crop Cycle & Activity Tracking
// ============================================================

model CropCycle {
  id               String          @id @default(uuid())
  farmId           String          @map("farm_id")
  plotId           String?         @map("plot_id") // Farm → Plot → CropCycle (Phase 1+)
  farmerId         String          @map("farmer_id")
  season           String // e.g., "2025/2026 Main"
  riceVariety      String?         @map("rice_variety")
  /// The admin-managed variety the farmer chose; its calendar and maturity length drive the schedule.
  riceVarietyId    String?         @map("rice_variety_id")
  plantingDate     DateTime?       @map("planting_date")
  expectedHarvest  DateTime?       @map("expected_harvest")
  harvestDate      DateTime?       @map("harvest_date")
  estimatedYieldKg Float?          @map("estimated_yield_kg")
  actualYieldKg    Float?          @map("actual_yield_kg")
  status           CropCycleStatus @default(PLANNED)

  /// The farming season (registration/verification window) this crop belongs to.
  farmingSeasonId  String?              @map("farming_season_id")
  areaPlantedHa    Float?               @map("area_planted_ha")
  seedQuantityKg   Float?               @map("seed_quantity_kg")
  productionMethod ProductionMethod?    @map("production_method")
  irrigationType   CycleIrrigationType? @map("irrigation_type")
  /// Current stage of the crop; moved by the admin or by a field officer's visit.
  growthStage      RiceGrowthStage?     @map("growth_stage")
  stageUpdatedAt   DateTime?            @map("stage_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  farm                 Farm                  @relation(fields: [farmId], references: [id])
  plot                 Plot?                 @relation(fields: [plotId], references: [id])
  farmer               Farmer                @relation(fields: [farmerId], references: [id])
  activities           ActivityLog[]
  costs                InputCost[]
  revenues             Revenue[]
  officerVisits        FieldOfficerVisit[]
  calendarTasks        RiceCalendarTask[]
  harvestQuality       HarvestQualityCheck?
  inventoryRecords     InventoryRecord[]
  aiIntegrationRecords AiIntegrationRecord[]
  insurancePolicies    InsurancePolicy[]
  variety              RiceVariety?          @relation(fields: [riceVarietyId], references: [id])
  farmingSeason        FarmingSeason?        @relation(fields: [farmingSeasonId], references: [id], onDelete: SetNull)
  stageChanges         CropStageChange[]
  goodsReceipts        GoodsReceipt[]
  farmTasks            FarmTask[]
  harvestRecords       HarvestRecord[]

  @@index([riceVarietyId])
  @@index([farmingSeasonId])
  @@map("crop_cycles")
}

/// One move of a crop cycle from stage to stage, so the admin can show a timeline.
model CropStageChange {
  id              String          @id @default(uuid())
  cropCycleId     String          @map("crop_cycle_id")
  stage           RiceGrowthStage
  /// ADMIN (set on the dashboard) or VISIT (reported by a field officer).
  source          String
  note            String?
  changedByUserId String?         @map("changed_by_user_id")
  changedAt       DateTime        @default(now()) @map("changed_at")

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@index([cropCycleId, changedAt])
  @@map("crop_stage_changes")
}

model ActivityLog {
  id               String       @id @default(uuid())
  cropCycleId      String       @map("crop_cycle_id")
  fieldOfficerId   String?      @map("field_officer_id")
  activityType     ActivityType @map("activity_type")
  activityDate     DateTime     @map("activity_date")
  description      String?
  inputsUsed       Json?        @map("inputs_used") // { name, quantity, unit }
  laborWorkers     Int?         @map("labor_workers")
  laborHours       Float?       @map("labor_hours")
  familyLaborCount Int?         @map("family_labor_count")
  hiredLaborCount  Int?         @map("hired_labor_count")
  laborWageTotal   Float?       @map("labor_wage_total")
  photoUrls        String[]     @map("photo_urls")
  gpsLatitude      Float?       @map("gps_latitude")
  gpsLongitude     Float?       @map("gps_longitude")
  /// Plot the work was done on; empty means the whole farm.
  plotId           String?      @map("plot_id")
  /// Main input used (seed, fertilizer, chemical...). Several inputs can also go in inputsUsed.
  inputName        String?      @map("input_name")
  inputQuantity    Float?       @map("input_quantity")
  inputUnit        String?      @map("input_unit")
  /// Total cost of the activity in TZS (inputs, hire, fuel...).
  cost             Float?
  remarks          String?
  createdAt        DateTime     @default(now()) @map("created_at")

  // Relations
  cropCycle    CropCycle    @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  fieldOfficer MamcosStaff? @relation(fields: [fieldOfficerId], references: [id])
  plot         Plot?        @relation(fields: [plotId], references: [id], onDelete: SetNull)

  @@index([cropCycleId, activityDate])
  @@map("activity_logs")
}

// Cooperative-owned, versioned rice calendar. Each task is copied onto the
// crop cycle so later protocol edits never rewrite a farmer's historic plan.
/// A rice variety the admin offers farmers. Varieties differ in how long they take to grow, so
/// each can have its own calendar (a platform RiceProtocol with this varietyId).
model RiceVariety {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String?
  /// Days from planting to harvest; used to work out the harvest date when the farmer gives only a planting date.
  maturityDays Int?     @map("maturity_days")
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  protocols  RiceProtocol[]
  cropCycles CropCycle[]

  @@map("rice_varieties")
}

model RiceProtocol {
  id              String    @id @default(uuid())
  /// null = the platform rice calendar (the one every farmer's mobile app uses); set = a
  /// cooperative's own calendar, which only that cooperative sees.
  mamcosId        String?   @map("mamcos_id")
  /// Platform calendars only: the rice variety this calendar is for. null on a platform calendar =
  /// the default calendar, used for any variety that has none of its own.
  varietyId       String?   @map("variety_id")
  name            String
  version         Int       @default(1)
  isActive        Boolean   @default(true) @map("is_active")
  /// The planting date this season's calendar is laid out from. Only used to show real dates next to the day counts in the admin editor; farmers' own tasks still follow their own planting date.
  seasonStart     DateTime? @map("season_start") @db.Date
  taskDefinitions Json      @map("task_definitions")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  mamcos  Mamcos?      @relation(fields: [mamcosId], references: [id], onDelete: Cascade)
  variety RiceVariety? @relation(fields: [varietyId], references: [id])

  // Platform versions (mamcos_id NULL) are numbered by RiceProtocolsService: Postgres treats NULLs as distinct.
  @@unique([mamcosId, version])
  @@index([mamcosId, isActive])
  @@index([varietyId])
  @@map("rice_protocols")
}

model RiceCalendarTask {
  id                   String             @id @default(uuid())
  cropCycleId          String             @map("crop_cycle_id")
  protocolVersion      Int                @map("protocol_version")
  taskKey              String             @map("task_key")
  title                String
  guidance             String
  activityType         ActivityType?      @map("activity_type")
  dueDate              DateTime           @map("due_date")
  requiredMeasurements Json?              @map("required_measurements")
  evidenceRequired     Boolean            @default(false) @map("evidence_required")
  status               CalendarTaskStatus @default(PENDING)
  measurements         Json?
  photoUrls            String[]           @map("photo_urls")
  completedAt          DateTime?          @map("completed_at")
  completedByUserId    String?            @map("completed_by_user_id")
  activityLogId        String?            @map("activity_log_id")
  // History that must survive for insurance checks: the first due date, when we reminded and
  // marked it missed, when the system (not the phone) received the completion, and any reschedule.
  originalDueDate      DateTime?          @map("original_due_date")
  reminderSentAt       DateTime?          @map("reminder_sent_at")
  missedAt             DateTime?          @map("missed_at")
  missedNotifiedAt     DateTime?          @map("missed_notified_at")
  recordedAt           DateTime?          @map("recorded_at")
  rescheduleCount      Int                @default(0) @map("reschedule_count")
  rescheduleReason     String?            @map("reschedule_reason")
  protocolId           String?            @map("protocol_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@unique([cropCycleId, taskKey])
  @@index([cropCycleId, status, dueDate])
  @@map("rice_calendar_tasks")
}

model HarvestQualityCheck {
  id                  String    @id @default(uuid())
  cropCycleId         String    @unique @map("crop_cycle_id")
  harvestMaturityPct  Float?    @map("harvest_maturity_pct")
  panicleMoisturePct  Float?    @map("panicle_moisture_pct")
  dryingMoisturePct   Float?    @map("drying_moisture_pct")
  bagCount            Int?      @map("bag_count")
  bagWeightKg         Float?    @map("bag_weight_kg")
  warehouseLocation   String?   @map("warehouse_location")
  warehouseReceivedAt DateTime? @map("warehouse_received_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@map("harvest_quality_checks")
}

// ============================================================
// FINANCE: Cost & Revenue Tracking
// ============================================================

model InputCost {
  id            String             @id @default(uuid())
  cropCycleId   String             @map("crop_cycle_id")
  category      CostCategory
  itemName      String             @map("item_name")
  quantity      Float?
  unit          String? // kg, liters, bags, etc.
  unitPrice     Float?             @map("unit_price")
  totalCost     Float              @map("total_cost") // In TZS
  supplier      String? // free-text legacy field, kept for backward compat
  supplierId    String?            @map("supplier_id")
  paymentStatus InputPaymentStatus @default(PENDING) @map("payment_status")
  loanRecordId  String?            @map("loan_record_id")
  receiptUrl    String?            @map("receipt_url")
  dateIncurred  DateTime           @map("date_incurred")
  createdAt     DateTime           @default(now()) @map("created_at")

  cropCycle        CropCycle   @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  supplierRecord   Supplier?   @relation(fields: [supplierId], references: [id])
  linkedLoanRecord LoanRecord? @relation(fields: [loanRecordId], references: [id])

  @@map("input_costs")
}

model Supplier {
  id            String       @id @default(uuid())
  /// Cooperative this supplier belongs to. Null = an older shared entry: every cooperative can see it, only Super Admin can change it.
  mamcosId      String?      @map("mamcos_id")
  /// A person (full name in `name`) or a company (company name in `name`, a person to contact in `contactPerson`).
  kind          SupplierKind @default(COMPANY)
  name          String
  contactPerson String?      @map("contact_person")
  contactPhone  String?      @map("contact_phone")
  contactEmail  String?      @map("contact_email")
  tin           String?
  /// VAT registration number, for a company.
  vrn           String?
  /// National ID number, for an individual.
  idNumber      String?      @map("id_number")
  /// Business registration number, for a company.
  businessRegNo String?      @map("business_reg_no")
  address       String?
  notes         String?
  itemsSupplied String[]     @map("items_supplied")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  mamcos     Mamcos?     @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  inputCosts InputCost[]
  bills      Bill[]

  @@index([mamcosId])
  @@map("suppliers")
}

enum SupplierKind {
  INDIVIDUAL
  COMPANY
}

model Revenue {
  id               String      @id @default(uuid())
  cropCycleId      String      @map("crop_cycle_id")
  revenueType      RevenueType @map("revenue_type")
  quantityKg       Float       @map("quantity_kg")
  pricePerKg       Float       @map("price_per_kg")
  totalRevenue     Float       @map("total_revenue") // In TZS
  fairtradePremium Float?      @map("fairtrade_premium")
  buyerId          String?     @map("buyer_id")
  saleId           String?     @map("sale_id")
  saleDate         DateTime    @map("sale_date")
  createdAt        DateTime    @default(now()) @map("created_at")

  cropCycle         CropCycle          @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  buyer             Buyer?             @relation(fields: [buyerId], references: [id])
  sale              Sale?              @relation(fields: [saleId], references: [id])
  saleApportionment SaleApportionment?

  @@map("revenues")
}

// ============================================================
// FINANCE: Payments & Escrow
// ============================================================

model Payment {
  id                     String        @id @default(uuid())
  farmerId               String        @map("farmer_id")
  membershipId           String?       @map("membership_id")
  saleId                 String?       @map("sale_id")
  amount                 Float // In TZS
  paymentType            PaymentType   @map("payment_type")
  status                 PaymentStatus
  mpesaRef               String?       @map("mpesa_ref")
  orderReference         String?       @map("order_reference") // ClickPesa order reference
  payoutApprovedByUserId String?       @map("payout_approved_by_user_id")
  payoutApprovedAt       DateTime?     @map("payout_approved_at")
  loanDeduction          Float?        @map("loan_deduction")
  netAmount              Float?        @map("net_amount")
  description            String?
  paidAt                 DateTime?     @map("paid_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  farmer         Farmer          @relation("FarmerPayments", fields: [farmerId], references: [id])
  membership     Membership?     @relation(fields: [membershipId], references: [id])
  sale           Sale?           @relation(fields: [saleId], references: [id])
  loanDeductions LoanDeduction[]

  @@map("payments")
}

model LoanRecord {
  id                String   @id @default(uuid())
  farmerId          String   @map("farmer_id")
  lenderId          String?  @map("lender_id")
  lenderName        String   @map("lender_name")
  originalAmount    Float    @map("original_amount")
  amountOwed        Float    @map("amount_owed")
  repaymentSchedule String?  @map("repayment_schedule")
  autoDeductPercent Float?   @map("auto_deduct_percent")
  lenderPayoutPhone String?  @map("lender_payout_phone")
  lenderPayoutName  String?  @map("lender_payout_name")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  farmer           Farmer           @relation(fields: [farmerId], references: [id])
  lender           Lender?          @relation(fields: [lenderId], references: [id])
  deductions       LoanDeduction[]
  linkedInputCosts InputCost[]
  instalments      LoanInstalment[]
  application      LoanApplication?
  /// The plot (hectare) this loan is tied to, when it is for one plot rather than the whole farmer.
  hectareId        String?          @map("hectare_id")

  @@map("loan_records")
}

enum LoanApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  WITHDRAWN
}

enum LoanPurpose {
  SEED_AND_INPUTS
  LAND_PREPARATION
  LABOUR
  EQUIPMENT
  IRRIGATION
  HARVEST_AND_TRANSPORT
  WORKING_CAPITAL
  OTHER
}

/// A farmer's request to a lender, with the farm and production picture at the time of applying.
model LoanApplication {
  id                  String                @id @default(uuid())
  reference           String                @unique
  farmerId            String                @map("farmer_id")
  /// The farmer's cooperative when applying; null for platform-level farmers.
  mamcosId            String?               @map("mamcos_id")
  lenderId            String                @map("lender_id")
  amountRequested     Float                 @map("amount_requested")
  termMonths          Int                   @map("term_months")
  purpose             LoanPurpose
  purposeNote         String?               @map("purpose_note")
  cropCycleId         String?               @map("crop_cycle_id")
  status              LoanApplicationStatus @default(SUBMITTED)
  /// Farm size, history, estimated yield, expected revenue and score as they stood on the day of applying.
  profileSnapshot     Json                  @map("profile_snapshot")
  creditScore         Int?                  @map("credit_score")
  submittedByUserId   String                @map("submitted_by_user_id")
  /// True when staff applied for the farmer.
  submittedOnBehalf   Boolean               @default(false) @map("submitted_on_behalf")
  reviewStartedAt     DateTime?             @map("review_started_at")
  approvedAmount      Float?                @map("approved_amount")
  interestRatePercent Float?                @map("interest_rate_percent")
  autoDeductPercent   Float?                @map("auto_deduct_percent")
  decisionNote        String?               @map("decision_note")
  decidedByUserId     String?               @map("decided_by_user_id")
  decidedAt           DateTime?             @map("decided_at")
  disbursedAmount     Float?                @map("disbursed_amount")
  disbursedAt         DateTime?             @map("disbursed_at")
  disbursementRef     String?               @map("disbursement_ref")
  loanRecordId        String?               @unique @map("loan_record_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  farmer Farmer      @relation(fields: [farmerId], references: [id])
  lender Lender      @relation(fields: [lenderId], references: [id])
  loan   LoanRecord? @relation(fields: [loanRecordId], references: [id])

  @@index([farmerId])
  @@index([lenderId, status])
  @@index([mamcosId, status])
  @@map("loan_applications")
}

/// One due payment of a loan. What has been paid is worked out from the loan's repaid total, not stored.
model LoanInstalment {
  id           String   @id @default(uuid())
  loanRecordId String   @map("loan_record_id")
  number       Int
  dueDate      DateTime @map("due_date")
  amount       Float
  createdAt    DateTime @default(now()) @map("created_at")

  loan LoanRecord @relation(fields: [loanRecordId], references: [id], onDelete: Cascade)

  @@unique([loanRecordId, number])
  @@map("loan_instalments")
}

model Lender {
  id                  String   @id @default(uuid())
  name                String   @unique
  contactPerson       String?  @map("contact_person")
  contactPhone        String?  @map("contact_phone")
  contactEmail        String?  @map("contact_email")
  payoutPhone         String?  @map("payout_phone")
  payoutName          String?  @map("payout_name")
  interestRatePercent Float?   @map("interest_rate_percent")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  loans        LoanRecord[]
  applications LoanApplication[]

  @@map("lenders")
}

model LoanDeduction {
  id                     String       @id @default(uuid())
  loanRecordId           String       @map("loan_record_id")
  sourcePaymentId        String       @map("source_payment_id")
  amount                 Float
  orderReference         String?      @unique @map("order_reference")
  payoutStatus           PayoutStatus @default(PENDING) @map("payout_status")
  payoutApprovedByUserId String?      @map("payout_approved_by_user_id")
  payoutApprovedAt       DateTime?    @map("payout_approved_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  loanRecord    LoanRecord @relation(fields: [loanRecordId], references: [id])
  sourcePayment Payment    @relation(fields: [sourcePaymentId], references: [id])

  @@unique([loanRecordId, sourcePaymentId])
  @@index([sourcePaymentId])
  @@map("loan_deductions")
}

// ============================================================
// INVENTORY: Traceability & Chain of Custody
// ============================================================

model InventoryRecord {
  id                  String              @id @default(uuid())
  farmId              String              @map("farm_id")
  farmerId            String              @map("farmer_id")
  cropCycleId         String?             @map("crop_cycle_id")
  lotNumber           String?             @map("lot_number")
  weightKg            Float               @map("weight_kg")
  qualityGrade        String?             @map("quality_grade")
  moistureContentPct  Float?              @map("moisture_content_pct")
  trackingCode        String              @unique @map("tracking_code")
  warehouseLocation   String?             @map("warehouse_location")
  warehouseId         String?             @map("warehouse_id")
  receivedDate        DateTime            @map("received_date")
  status              InventoryStatus     @default(RECEIVED)
  /// Cooperative the delivery belongs to (from the farm); null = platform-level.
  mamcosId            String?             @map("mamcos_id")
  collectionCentreId  String?             @map("collection_centre_id")
  riceVariety         String?             @map("rice_variety")
  bags                Int?
  /// Price paid to the farmer per kg, and the resulting total (TZS).
  pricePerKg          Float?              @map("price_per_kg")
  totalValue          Float?              @map("total_value")
  /// Storage batch (bay / stack) before the delivery joins an export lot.
  batchNumber         String?             @map("batch_number")
  farmerPaymentStatus FarmerPaymentStatus @default(UNPAID) @map("farmer_payment_status")
  amountPaid          Float               @default(0) @map("amount_paid")
  paidAt              DateTime?           @map("paid_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  farm             Farm              @relation(fields: [farmId], references: [id])
  farmer           Farmer            @relation(fields: [farmerId], references: [id])
  cropCycle        CropCycle?        @relation(fields: [cropCycleId], references: [id])
  lot              Lot?              @relation(fields: [lotNumber], references: [lotNumber])
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id])
  collectionCentre CollectionCentre? @relation(fields: [collectionCentreId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([mamcosId, status])
  @@index([collectionCentreId])
  @@map("inventory_records")
}

/// Where farmers bring rice for weighing and buying before it moves to a warehouse.
model CollectionCentre {
  id           String   @id @default(uuid())
  /// Owning cooperative; null = platform-level centre.
  mamcosId     String?  @map("mamcos_id")
  name         String
  region       String?
  district     String?
  ward         String?
  village      String?
  contactPhone String?  @map("contact_phone")
  /// Warehouse this centre normally delivers to.
  warehouseId  String?  @map("warehouse_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  mamcos           Mamcos?           @relation(fields: [mamcosId], references: [id])
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  inventoryRecords InventoryRecord[]

  @@index([mamcosId])
  @@map("collection_centres")
}

enum FarmerPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Lot {
  id            String   @id @default(uuid())
  lotNumber     String   @unique @map("lot_number") // e.g., LOT-2025-001
  totalWeightKg Float    @map("total_weight_kg")
  riceVariety   String?  @map("rice_variety")
  /// One grade per lot; null only for legacy lots created before grades were enforced.
  grade         String?
  /// Warehouse currently holding this lot (null for legacy lots).
  warehouseId   String?  @map("warehouse_id")
  createdAt     DateTime @default(now()) @map("created_at")

  warehouse            Warehouse?            @relation(fields: [warehouseId], references: [id])
  saleOrders           SaleOrder[]
  inventoryRecords     InventoryRecord[]
  sales                Sale[]
  aiIntegrationRecords AiIntegrationRecord[]

  @@map("lots")
}

// ============================================================
// BUYERS & SALES
// ============================================================

model Buyer {
  id                  String             @id @default(uuid())
  name                String
  fairtradeCertNumber String?            @unique @map("fairtrade_cert_number")
  contactPerson       String?            @map("contact_person")
  contactEmail        String?            @map("contact_email")
  contactPhone        String?            @map("contact_phone")
  isCertified         Boolean            @default(false) @map("is_certified")
  /// Owning cooperative; null = platform-level buyer (Super Admin's own customers).
  mamcosId            String?            @map("mamcos_id")
  businessType        BuyerBusinessType? @map("business_type")
  region              String?
  district            String?
  /// Street / town the buyer operates from.
  location            String?
  preferredVarieties  String[]           @map("preferred_varieties")
  /// Where this buyer usually takes delivery; orders and agreements can override it.
  deliveryLocation    String?            @map("delivery_location")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  mamcos     Mamcos?             @relation(fields: [mamcosId], references: [id])
  saleOrders SaleOrder[]
  sales      Sale[]
  revenues   Revenue[]
  invoices   Invoice[]
  orders     BuyerOrder[]
  agreements PurchaseAgreement[]

  @@index([mamcosId])
  @@map("buyers")
}

model BuyerOrder {
  id                  String           @id @default(uuid())
  buyerId             String           @map("buyer_id")
  riceVariety         String?          @map("rice_variety")
  quantityRequiredKg  Float            @map("quantity_required_kg")
  qualityRequirements String?          @map("quality_requirements")
  status              BuyerOrderStatus @default(OPEN)
  requiredByDate      DateTime?        @map("required_by_date")
  notes               String?
  /// Cooperative the order belongs to (the buyer's); null = platform-level.
  mamcosId            String?          @map("mamcos_id")
  offeredPricePerKg   Float?           @map("offered_price_per_kg")
  deliveryLocation    String?          @map("delivery_location")
  qualityGrade        String?          @map("quality_grade")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  buyer      Buyer               @relation(fields: [buyerId], references: [id])
  sales      Sale[]
  agreements PurchaseAgreement[]

  @@index([mamcosId])
  @@map("buyer_orders")
}

model Sale {
  id                    String    @id @default(uuid())
  invoiceNumber         String    @unique @map("invoice_number")
  buyerId               String    @map("buyer_id")
  lotId                 String    @map("lot_id")
  buyerOrderId          String?   @map("buyer_order_id")
  /// Purchase agreement this delivery counts against.
  agreementId           String?   @map("agreement_id")
  riceVariety           String?   @map("rice_variety")
  quantityKg            Float     @map("quantity_kg")
  packaging             String?
  pricePerKg            Float     @map("price_per_kg")
  fairtradePremium      Float?    @map("fairtrade_premium")
  totalRevenue          Float     @map("total_revenue")
  paymentReceived       Boolean   @default(false) @map("payment_received")
  paymentDate           DateTime? @map("payment_date")
  buyerOrderReference   String?   @unique @map("buyer_order_reference")
  buyerPaymentReference String?   @map("buyer_payment_reference")
  saleDate              DateTime  @map("sale_date")
  /// Cooperative the sale belongs to; null = platform-level sale.
  mamcosId              String?   @map("mamcos_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  buyer              Buyer               @relation(fields: [buyerId], references: [id])
  lot                Lot                 @relation(fields: [lotId], references: [id])
  fulfillsOrder      BuyerOrder?         @relation(fields: [buyerOrderId], references: [id])
  agreement          PurchaseAgreement?  @relation(fields: [agreementId], references: [id])
  revenues           Revenue[]
  payments           Payment[]
  apportionments     SaleApportionment[]
  premiumFundEntries PremiumFundEntry[]
  invoice            Invoice?
  dispatch           Dispatch?
  saleOrder          SaleOrder?

  @@index([mamcosId])
  @@map("sales")
}

// Immutable audit trail of how a cooperative sale was allocated to source farmers.
// Revenue rows are created from these allocations, while this table preserves the
// original inventory-weight calculation for traceability and dispute resolution.
model SaleApportionment {
  id                String   @id @default(uuid())
  saleId            String   @map("sale_id")
  farmerId          String   @map("farmer_id")
  inventoryWeightKg Float    @map("inventory_weight_kg")
  weightShare       Float    @map("weight_share")
  quantityKg        Float    @map("quantity_kg")
  grossAmount       Float    @map("gross_amount")
  fairtradePremium  Float    @default(0) @map("fairtrade_premium")
  revenueId         String?  @unique @map("revenue_id")
  createdAt         DateTime @default(now()) @map("created_at")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  farmer  Farmer   @relation(fields: [farmerId], references: [id])
  revenue Revenue? @relation(fields: [revenueId], references: [id])

  @@unique([saleId, farmerId])
  @@index([farmerId])
  @@map("sale_apportionments")
}

enum DispatchTransportMode {
  BUYER_OWN_VEHICLE
  MAYODE_ARRANGED
}

// Warehouse gate-pass: recorded when a buyer collects goods for a Sale.
// One dispatch per sale today; if partial/staged pickups are ever needed,
// drop the @unique on saleId (additive migration, not a rewrite).
model Dispatch {
  id                 String                @id @default(uuid())
  saleId             String                @unique @map("sale_id")
  transportMode      DispatchTransportMode @map("transport_mode")
  transportFee       Float?                @map("transport_fee")
  vehiclePlateNumber String?               @map("vehicle_plate_number")
  driverName         String?               @map("driver_name")
  driverPhone        String?               @map("driver_phone")
  releasedByUserId   String                @map("released_by_user_id")
  releasedAt         DateTime              @default(now()) @map("released_at")
  notes              String?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  sale       Sale @relation(fields: [saleId], references: [id])
  releasedBy User @relation(fields: [releasedByUserId], references: [id])

  @@map("dispatches")
}

// Fairtrade premium is deliberately tracked outside ordinary crop revenue so
// members can audit fund income, expenditure and the resulting balance.
model PremiumFundEntry {
  mamcosId    String?              @map("mamcos_id")
  mamcos      Mamcos?              @relation(fields: [mamcosId], references: [id])
  id          String               @id @default(uuid())
  entryType   PremiumFundEntryType @map("entry_type")
  amount      Float
  description String
  saleId      String?              @map("sale_id")
  entryDate   DateTime             @map("entry_date")
  createdAt   DateTime             @default(now()) @map("created_at")

  sale Sale? @relation(fields: [saleId], references: [id])

  @@index([mamcosId])
  @@index([entryDate])
  @@map("premium_fund_entries")
}

model Account {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  type        AccountType
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  entries     LedgerEntry[]
  budgetLines BudgetLine[]

  @@map("accounts")
}

model LedgerEntry {
  id                String   @id @default(uuid())
  entryNumber       String   @map("entry_number")
  accountId         String   @map("account_id")
  debit             Float    @default(0)
  credit            Float    @default(0)
  entryDate         DateTime @map("entry_date")
  sourceType        String   @map("source_type")
  sourceId          String   @map("source_id")
  description       String?
  /// Cooperative whose books this belongs to. Null = platform-level (Mayode corporate, or could not be attributed); visible to Super Admin only.
  mamcosId          String?  @map("mamcos_id")
  /// All lines of one journal share this id. A journal always balances (enforced by a deferred trigger).
  journalId         String   @map("journal_id")
  /// 1 for a source's first posting; later postings of the same source are adjustments carrying only the difference.
  revision          Int      @default(1)
  /// Set on a reversing journal: the journal it cancels.
  reversesJournalId String?  @map("reverses_journal_id")
  postedById        String?  @map("posted_by_id")
  /// Which of the cooperative's money accounts a cash line (ledger account 1000) moved through; null = not assigned yet.
  cashAccountId     String?  @map("cash_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  account     Account            @relation(fields: [accountId], references: [id])
  mamcos      Mamcos?            @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  cashAccount CashAccount?       @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  bankLine    BankStatementLine?

  // Uniqueness per source/reversal also includes the money account (a database index, so a transfer can post two cash lines).
  @@index([entryDate])
  @@index([mamcosId, entryDate])
  @@index([journalId])
  @@map("ledger_entries")
}

/// Last document number handed out for one (cooperative, kind, year), so numbers run 1, 2, 3 … without gaps or repeats.
model LedgerCounter {
  scopeKey  String @map("scope_key")
  year      Int
  lastValue Int    @default(0) @map("last_value")

  @@id([scopeKey, year])
  @@map("ledger_counters")
}

/// Books are closed up to and including `closedThrough`: nothing can be posted on or before that day.
model AccountingLock {
  scopeKey      String   @id @map("scope_key")
  mamcosId      String?  @unique @map("mamcos_id")
  closedThrough DateTime @map("closed_through") @db.Date
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  updatedById   String?  @map("updated_by_id")

  mamcos Mamcos? @relation(fields: [mamcosId], references: [id], onDelete: Restrict)

  @@map("accounting_locks")
}

/// Append-only history of closing and reopening the books.
model AccountingLockEvent {
  id        String    @id @default(uuid())
  scopeKey  String    @map("scope_key")
  mamcosId  String?   @map("mamcos_id")
  action    String
  fromDate  DateTime? @map("from_date") @db.Date
  toDate    DateTime? @map("to_date") @db.Date
  reason    String?
  byUserId  String?   @map("by_user_id")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([scopeKey, createdAt])
  @@map("accounting_lock_events")
}

enum CashTransactionKind {
  EXPENSE
  INCOME
}

enum CashTransactionStatus {
  POSTED
  VOID
}

/// A simple money-out or money-in the AMCOS records without bookkeeping knowledge; each one posts a journal to the ledger.
model CashTransaction {
  id              String                @id @default(uuid())
  mamcosId        String                @map("mamcos_id")
  kind            CashTransactionKind
  /// EXP-2026-000001 / INC-2026-000001, running per cooperative and year.
  number          String
  transactionDate DateTime              @map("transaction_date") @db.Date
  /// The total money that moved, VAT included.
  amount          Decimal               @db.Decimal(14, 2)
  vatAmount       Decimal               @default(0) @map("vat_amount") @db.Decimal(14, 2)
  /// Ledger account the cost or income is booked to.
  accountCode     String                @map("account_code")
  party           String?
  /// How the money moved. Informational: it all goes through the cash and mobile money account.
  method          String                @default("CASH")
  reference       String?
  note            String?
  status          CashTransactionStatus @default(POSTED)
  voidedAt        DateTime?             @map("voided_at")
  voidedById      String?               @map("voided_by_id")
  voidReason      String?               @map("void_reason")
  createdById     String?               @map("created_by_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  mamcos        Mamcos       @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  /// The money account this moved through; null = not assigned to one.
  cashAccountId String?      @map("cash_account_id")
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, number])
  @@index([mamcosId, transactionDate])
  @@map("cash_transactions")
}

enum StatementStatus {
  DRAFT
  RECONCILED
}

/// A bank, mobile-money or cash-count statement being checked against the cash book (account 1000).
model BankStatement {
  id             String          @id @default(uuid())
  mamcosId       String          @map("mamcos_id")
  accountLabel   String          @map("account_label")
  kind           String          @default("BANK")
  periodStart    DateTime        @map("period_start") @db.Date
  periodEnd      DateTime        @map("period_end") @db.Date
  openingBalance Decimal         @map("opening_balance") @db.Decimal(14, 2)
  closingBalance Decimal         @map("closing_balance") @db.Decimal(14, 2)
  status         StatementStatus @default(DRAFT)
  reconciledAt   DateTime?       @map("reconciled_at")
  reconciledById String?         @map("reconciled_by_id")
  createdById    String?         @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  mamcos        Mamcos              @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  lines         BankStatementLine[]
  /// The money account this moved through; null = not assigned to one.
  cashAccountId String?             @map("cash_account_id")
  cashAccount   CashAccount?        @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@index([mamcosId, periodEnd])
  @@map("bank_statements")
}

model BankStatementLine {
  id            String    @id @default(uuid())
  statementId   String    @map("statement_id")
  lineDate      DateTime  @map("line_date") @db.Date
  description   String
  reference     String?
  /// Money in is positive, money out negative.
  amount        Decimal   @db.Decimal(14, 2)
  ledgerEntryId String?   @unique @map("ledger_entry_id")
  matchedAt     DateTime? @map("matched_at")
  matchedById   String?   @map("matched_by_id")

  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  ledgerEntry LedgerEntry?  @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([statementId])
  @@map("bank_statement_lines")
}

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @map("invoice_number")
  saleId            String?       @unique @map("sale_id")
  buyerId           String?       @map("buyer_id")
  /// Total the customer owes, VAT included.
  amount            Float
  subtotal          Float?
  vatAmount         Float         @default(0) @map("vat_amount")
  /// Tax the customer withholds from this invoice and pays to the revenue authority for us.
  withholdingAmount Float         @default(0) @map("withholding_amount")
  description       String?
  /// False for older invoices recorded before invoices posted to the ledger.
  postedToLedger    Boolean       @default(true) @map("posted_to_ledger")
  dueDate           DateTime      @map("due_date")
  /// Cooperative these books belong to (null = platform-level).
  mamcosId          String?       @map("mamcos_id")
  status            InvoiceStatus @default(OPEN)
  paidAt            DateTime?     @map("paid_at")
  lastReminderAt    DateTime?     @map("last_reminder_at")
  reminderCount     Int           @default(0) @map("reminder_count")
  createdAt         DateTime      @default(now()) @map("created_at")
  sale              Sale?         @relation(fields: [saleId], references: [id])
  buyer             Buyer?        @relation(fields: [buyerId], references: [id])
  mamcos            Mamcos?       @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  /// The money account this moved through; null = not assigned to one.
  cashAccountId     String?       @map("cash_account_id")
  cashAccount       CashAccount?  @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, invoiceNumber])
  @@index([dueDate, status])
  @@index([mamcosId])
  @@map("invoices")
}

model Bill {
  id                 String        @id @default(uuid())
  billNumber         String        @map("bill_number")
  supplier           String
  supplierId         String?       @map("supplier_id")
  /// Total on the supplier's bill, VAT included.
  amount             Float
  subtotal           Float?
  vatAmount          Float         @default(0) @map("vat_amount")
  /// Tax we hold back from the supplier and owe the revenue authority.
  withholdingAmount  Float         @default(0) @map("withholding_amount")
  /// Account code the cost is booked to (default 5000).
  expenseAccountCode String?       @map("expense_account_code")
  dueDate            DateTime      @map("due_date")
  /// Cooperative these books belong to (null = platform-level).
  mamcosId           String?       @map("mamcos_id")
  status             InvoiceStatus @default(OPEN)
  paidAt             DateTime?     @map("paid_at")
  description        String?
  createdAt          DateTime      @default(now()) @map("created_at")

  supplierRef   Supplier?    @relation(fields: [supplierId], references: [id])
  mamcos        Mamcos?      @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  /// The money account this moved through; null = not assigned to one.
  cashAccountId String?      @map("cash_account_id")
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@unique([mamcosId, billNumber])
  @@index([dueDate, status])
  @@index([mamcosId])
  @@map("bills")
}

model Budget {
  id               String       @id @default(uuid())
  mamcosId         String?      @map("mamcos_id")
  name             String
  fiscalYear       Int?         @map("fiscal_year")
  seasonLabel      String?      @map("season_label")
  startDate        DateTime     @map("start_date")
  endDate          DateTime     @map("end_date")
  status           BudgetStatus @default(DRAFT)
  approvedAt       DateTime?    @map("approved_at")
  approvedByUserId String?      @map("approved_by_user_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  mamcos           Mamcos?      @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  lines            BudgetLine[]

  @@map("budgets")
}

model BudgetLine {
  id        String  @id @default(uuid())
  budgetId  String  @map("budget_id")
  accountId String  @map("account_id")
  amount    Float
  budget    Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId])
  @@map("budget_lines")
}

model CommunityProject {
  mamcosId      String?       @map("mamcos_id")
  mamcos        Mamcos?       @relation(fields: [mamcosId], references: [id])
  id            String        @id @default(uuid())
  name          String
  fundingSource String        @map("funding_source")
  budget        Float
  spentAmount   Float         @default(0) @map("spent_amount")
  status        ProjectStatus @default(OPEN)
  milestones    Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([mamcosId])
  @@map("community_projects")
}

model MeetingRecord {
  mamcosId      String?  @map("mamcos_id")
  mamcos        Mamcos?  @relation(fields: [mamcosId], references: [id])
  id            String   @id @default(uuid())
  meetingDate   DateTime @map("meeting_date")
  agenda        String
  decisions     String
  attendeeCount Int      @map("attendee_count")
  createdAt     DateTime @default(now()) @map("created_at")
  votes         Vote[]

  @@index([mamcosId])
  @@map("meeting_records")
}

model Vote {
  mamcosId    String?        @map("mamcos_id")
  mamcos      Mamcos?        @relation(fields: [mamcosId], references: [id])
  id          String         @id @default(uuid())
  title       String
  description String?
  opensAt     DateTime       @map("opens_at")
  closesAt    DateTime       @map("closes_at")
  status      VoteStatus     @default(DRAFT)
  meetingId   String?        @map("meeting_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  options     VoteOption[]
  responses   VoteResponse[]
  meeting     MeetingRecord? @relation(fields: [meetingId], references: [id])

  @@index([mamcosId])
  @@map("votes")
}

model VoteOption {
  id        String         @id @default(uuid())
  voteId    String         @map("vote_id")
  label     String
  vote      Vote           @relation(fields: [voteId], references: [id], onDelete: Cascade)
  responses VoteResponse[]

  @@map("vote_options")
}

model VoteResponse {
  id        String     @id @default(uuid())
  voteId    String     @map("vote_id")
  optionId  String     @map("option_id")
  farmerId  String     @map("farmer_id")
  createdAt DateTime   @default(now()) @map("created_at")
  vote      Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  option    VoteOption @relation(fields: [optionId], references: [id])
  farmer    Farmer     @relation(fields: [farmerId], references: [id])

  @@unique([voteId, farmerId])
  @@map("vote_responses")
}

// ============================================================
// M-LAX: Land Listing & Marketplace
// ============================================================

model LandListing {
  id                   String      @id @default(uuid())
  farmId               String      @map("farm_id")
  ownerId              String      @map("owner_id")
  renterId             String?     @map("renter_id")
  askingPrice          Float       @map("asking_price") // In TZS
  suggestedPrice       Float?      @map("suggested_price")
  finalPrice           Float?      @map("final_price")
  dealType             DealType    @default(STANDARD) @map("deal_type")
  commissionRate       Float       @map("commission_rate")
  commissionAmount     Float?      @map("commission_amount")
  leaseStatus          LeaseStatus @default(DRAFT) @map("lease_status")
  leaseDurationMonths  Int         @map("lease_duration_months")
  leaseStartDate       DateTime?   @map("lease_start_date")
  leaseEndDate         DateTime?   @map("lease_end_date")
  isFlashDeal          Boolean     @default(false) @map("is_flash_deal")
  preferredRenterCode  String?     @map("preferred_renter_code")
  isMultiYear          Boolean     @default(false) @map("is_multi_year")
  pricingModel         String?     @map("pricing_model") // "fixed", "step_up", "rice_linked"
  autoDropPrice        Float?      @map("auto_drop_price") // Flexible pricing auto-drop
  autoDropDays         Int?        @map("auto_drop_days")
  lastPriceDropAt      DateTime?   @map("last_price_drop_at") // Flash-deal cron dedup
  previousRenterId     String?     @map("previous_renter_id") // Last completed renter on this farm, for loyalty pricing
  facilitatedByStaffId String?     @map("facilitated_by_staff_id") // Desk officer who gets the agent fee
  agreementPdfUrl      String?     @map("agreement_pdf_url")
  agreementGeneratedAt DateTime?   @map("agreement_generated_at")
  /// What the AMCOS keeps on record (never the money): why the owner lets the farm out, the agreed terms, the length in seasons, and the hectare involved.
  rentOutReason        String?     @map("rent_out_reason")
  leaseTerms           String?     @map("lease_terms")
  seasonCount          Int?        @map("season_count")
  hectareId            String?     @map("hectare_id")
  // Multi-year leases (Step-Up / Rice-Linked pricing)
  paymentPlan          String?     @default("PREPAID") @map("payment_plan") // "PREPAID" | "ANNUAL"
  rentScheduleJson     Json?       @map("rent_schedule_json")
  lastInstallmentYear  Int         @default(0) @map("last_installment_year")
  // Reward for Honesty: every M-LAX in-app deal is MAYODE-protected once escrow is secured
  mayodeProtected      Boolean     @default(false) @map("mayode_protected")
  /// Listed because the owner's debt went unpaid (FarmDefaultCase). The price may not go below minimumPrice.
  defaultCaseId        String?     @map("default_case_id")
  minimumPrice         Float?      @map("minimum_price")
  // Private ("Relationship") deals: only a keyed hash of the code is stored, never the code. The
  // first renter to redeem it is recorded in claimedByFarmerId and is the only one who can take the listing.
  accessCodeHash       String?     @map("access_code_hash")
  accessCodeExpiresAt  DateTime?   @map("access_code_expires_at")
  claimedByFarmerId    String?     @map("claimed_by_farmer_id")
  claimedAt            DateTime?   @map("claimed_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  // Relations
  claimedByFarmer    Farmer?                        @relation("LandCodeHolder", fields: [claimedByFarmerId], references: [id])
  codeAttempts       LandListingCodeAttempt[]
  farm               Farm                           @relation(fields: [farmId], references: [id])
  owner              Farmer                         @relation("LandOwner", fields: [ownerId], references: [id])
  renter             Farmer?                        @relation("LandRenter", fields: [renterId], references: [id])
  previousRenter     Farmer?                        @relation("LandPreviousRenter", fields: [previousRenterId], references: [id])
  facilitatedByStaff MamcosStaff?                   @relation(fields: [facilitatedByStaffId], references: [id])
  escrowPayments     EscrowPayment[]
  subLeases          LandListingSubLease[]
  ownershipTransfers LandListingOwnershipTransfer[]
  offers             LandListingOffer[]
  improvements       LandListingImprovement[]
  hectare            IrrigationHectare?             @relation(fields: [hectareId], references: [id])
  rentalRecord       AmcosRentalRecord?

  @@index([hectareId])
  @@map("land_listings")
}

/// Every attempt to redeem a private listing's code, used to throttle guessing.
model LandListingCodeAttempt {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  farmerId  String   @map("farmer_id")
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  listing LandListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  farmer  Farmer      @relation(fields: [farmerId], references: [id])

  @@index([farmerId, createdAt])
  @@index([listingId, farmerId, createdAt])
  @@map("land_listing_code_attempts")
}

model LandListingOffer {
  id            String      @id @default(uuid())
  listingId     String      @map("listing_id")
  farmerId      String      @map("farmer_id") // the farmer making the offer
  offerAmount   Float       @map("offer_amount")
  status        OfferStatus @default(PENDING)
  counterAmount Float?      @map("counter_amount")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  listing LandListing @relation(fields: [listingId], references: [id])
  farmer  Farmer      @relation(fields: [farmerId], references: [id])

  @@map("land_listing_offers")
}

model LandListingImprovement {
  id            String   @id @default(uuid())
  listingId     String   @map("listing_id")
  renterId      String   @map("renter_id")
  description   String
  amountTzs     Float    @map("amount_tzs")
  appliedToYear Int?     @map("applied_to_year") // which installment year this credit was deducted from, if any
  createdAt     DateTime @default(now()) @map("created_at")

  listing LandListing @relation(fields: [listingId], references: [id])
  renter  Farmer      @relation(fields: [renterId], references: [id])

  @@map("land_listing_improvements")
}

model LandListingSubLease {
  id                String         @id @default(uuid())
  originalListingId String         @map("original_listing_id")
  originalRenterId  String         @map("original_renter_id")
  status            SubLeaseStatus @default(PENDING)
  newRenterId       String?        @map("new_renter_id")
  newAskingPrice    Float?         @map("new_asking_price")
  approvedByOwnerAt DateTime?      @map("approved_by_owner_at")
  settledAt         DateTime?      @map("settled_at") // Re-listing fee payout to original renter processed
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  originalListing LandListing @relation(fields: [originalListingId], references: [id])
  originalRenter  Farmer      @relation("SubLeaseOriginalRenter", fields: [originalRenterId], references: [id])
  newRenter       Farmer?     @relation("SubLeaseNewRenter", fields: [newRenterId], references: [id])

  @@map("land_listing_sub_leases")
}

model LandListingOwnershipTransfer {
  id             String    @id @default(uuid())
  listingId      String    @map("listing_id")
  fromOwnerId    String    @map("from_owner_id")
  toOwnerPhone   String    @map("to_owner_phone")
  toOwnerId      String?   @map("to_owner_id")
  reason         String?
  transferFeeTzs Float     @default(10000) @map("transfer_fee_tzs")
  feeChargedAt   DateTime? @map("fee_charged_at") // Fixed transfer fee deducted from the next payout
  transferredAt  DateTime  @default(now()) @map("transferred_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  listing   LandListing @relation(fields: [listingId], references: [id])
  fromOwner Farmer      @relation("TransferFromOwner", fields: [fromOwnerId], references: [id])
  toOwner   Farmer?     @relation("TransferToOwner", fields: [toOwnerId], references: [id])

  @@map("land_listing_ownership_transfers")
}

// ============================================================
// M-LAX: Tractor & Equipment Booking
// ============================================================

model TractorOwner {
  id        String   @id @default(uuid())
  name      String
  phone     String
  location  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tractors Tractor[]

  @@map("tractor_owners")
}

model Tractor {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  registrationNo  String   @unique @map("registration_no")
  model           String?
  horsePower      Int?     @map("horse_power")
  isAvailable     Boolean  @default(true) @map("is_available")
  location        String?
  pricePerHectare Float?   @map("price_per_hectare") // Base price in TZS
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner    TractorOwner     @relation(fields: [ownerId], references: [id])
  bookings TractorBooking[]

  @@map("tractors")
}

model TractorBooking {
  id               String        @id @default(uuid())
  tractorId        String        @map("tractor_id")
  farmerId         String        @map("farmer_id")
  hectares         Float
  terrainGrade     FarmGrade     @map("terrain_grade")
  basePrice        Float         @map("base_price")
  terrainSurcharge Float?        @map("terrain_surcharge")
  totalPrice       Float         @map("total_price")
  commissionRate   Float         @map("commission_rate")
  commissionAmount Float         @map("commission_amount")
  status           BookingStatus @default(PENDING)
  scheduledDate    DateTime      @map("scheduled_date")
  completedAt      DateTime?     @map("completed_at")
  farmerConfirmed  Boolean       @default(false) @map("farmer_confirmed")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tractor Tractor @relation(fields: [tractorId], references: [id])
  farmer  Farmer  @relation(fields: [farmerId], references: [id])

  @@map("tractor_bookings")
}

// ============================================================
// ESCROW & TRUST
// ============================================================

model EscrowPayment {
  id                   String        @id @default(uuid())
  listingId            String        @map("listing_id")
  amount               Float
  status               PaymentStatus
  mpesaRef             String?       @map("mpesa_ref")
  // Collection (money in, via ClickPesa USSD push)
  orderReference       String?       @unique @map("order_reference")
  phoneNumber          String?       @map("phone_number")
  // Payout (money out, via ClickPesa Payout API)
  payoutOrderReference String?       @unique @map("payout_order_reference")
  payoutStatus         PayoutStatus? @map("payout_status")
  payoutRecipientId    String?       @map("payout_recipient_id")
  payoutFailureReason  String?       @map("payout_failure_reason")
  depositedAt          DateTime?     @map("deposited_at")
  releasedAt           DateTime?     @map("released_at")
  // Set only for a multi-year ANNUAL-plan installment (year 2, 3, ...) —
  // null means this is the original deposit that activates the lease.
  installmentYear      Int?          @map("installment_year")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  listing         LandListing @relation(fields: [listingId], references: [id])
  payoutRecipient Farmer?     @relation(fields: [payoutRecipientId], references: [id])

  @@map("escrow_payments")
}

// ============================================================
// MARKET DATA
// ============================================================

model MarketPrice {
  id         String   @id @default(uuid())
  commodity  String // e.g., "rice_sack_100kg"
  price      Float // In TZS
  market     String? // e.g., "Mafinga"
  source     String?
  recordedAt DateTime @map("recorded_at")
  /// Cooperative that recorded the price; null = platform-wide (visible to everyone).
  mamcosId   String?  @map("mamcos_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([mamcosId])
  @@map("market_prices")
}

// ============================================================
// AGRICULTURAL INSURANCE
// ============================================================

enum InsuranceProductType {
  AREA_YIELD
  WEATHER_INDEX
  MULTI_PERIL
  INPUT_INSURANCE
  CREDIT_LINKED
}

enum PolicyStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

enum ClaimStatus {
  SUBMITTED
  INSPECTING
  APPROVED
  REJECTED
  PAID
}

model InsuranceProvider {
  id            String   @id @default(uuid())
  name          String   @unique
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  policies     InsurancePolicy[]
  applications InsuranceApplication[]

  @@map("insurance_providers")
}

enum InsuranceApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVATED
  WITHDRAWN
}

/// A request for cover, decided by the insurer; becomes a policy once staff record the premium as paid.
model InsuranceApplication {
  id                  String                     @id @default(uuid())
  reference           String                     @unique
  farmerId            String                     @map("farmer_id")
  mamcosId            String?                    @map("mamcos_id")
  providerId          String                     @map("provider_id")
  farmId              String?                    @map("farm_id")
  cropCycleId         String?                    @map("crop_cycle_id")
  productType         InsuranceProductType       @map("product_type")
  riceVariety         String?                    @map("rice_variety")
  insuredAreaHectares Float                      @map("insured_area_hectares")
  /// What the applicant asked to be covered for (a guide, the insurer sets the final figure).
  requestedSumInsured Float?                     @map("requested_sum_insured")
  notes               String?
  status              InsuranceApplicationStatus @default(SUBMITTED)
  /// Weather, claims and yield risk as it stood when applying.
  riskSnapshot        Json                       @map("risk_snapshot")
  riskLevel           String                     @map("risk_level")
  submittedByUserId   String                     @map("submitted_by_user_id")
  submittedOnBehalf   Boolean                    @default(false) @map("submitted_on_behalf")
  reviewStartedAt     DateTime?                  @map("review_started_at")
  /// The insurer's offer.
  sumInsured          Float?                     @map("sum_insured")
  premiumAmount       Float?                     @map("premium_amount")
  startDate           DateTime?                  @map("start_date")
  endDate             DateTime?                  @map("end_date")
  decisionNote        String?                    @map("decision_note")
  decidedByUserId     String?                    @map("decided_by_user_id")
  decidedAt           DateTime?                  @map("decided_at")
  premiumPaidAmount   Float?                     @map("premium_paid_amount")
  premiumPaidAt       DateTime?                  @map("premium_paid_at")
  premiumReference    String?                    @map("premium_reference")
  recordedByUserId    String?                    @map("recorded_by_user_id")
  policyId            String?                    @unique @map("policy_id")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  farmer   Farmer            @relation(fields: [farmerId], references: [id])
  provider InsuranceProvider @relation(fields: [providerId], references: [id])
  policy   InsurancePolicy?  @relation(fields: [policyId], references: [id])

  @@index([farmerId])
  @@index([providerId, status])
  @@index([mamcosId, status])
  @@map("insurance_applications")
}

model InsurancePolicy {
  id                  String               @id @default(uuid())
  farmerId            String               @map("farmer_id")
  farmId              String?              @map("farm_id")
  cropCycleId         String?              @map("crop_cycle_id")
  providerId          String               @map("provider_id")
  productType         InsuranceProductType @map("product_type")
  riceVariety         String?              @map("rice_variety")
  insuredAreaHectares Float                @map("insured_area_hectares")
  sumInsured          Float                @map("sum_insured")
  premiumAmount       Float                @map("premium_amount")
  status              PolicyStatus         @default(PENDING)
  startDate           DateTime?            @map("start_date")
  endDate             DateTime?            @map("end_date")
  renewedFromPolicyId String?              @map("renewed_from_policy_id")
  /// The farmer's cooperative when the policy was issued; null for platform-level farmers.
  mamcosId            String?              @map("mamcos_id")
  /// Premium actually collected from the farmer, recorded by staff.
  premiumPaidAmount   Float                @default(0) @map("premium_paid_amount")
  premiumPaidAt       DateTime?            @map("premium_paid_at")
  premiumReference    String?              @map("premium_reference")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  application       InsuranceApplication?
  farmer            Farmer                @relation(fields: [farmerId], references: [id])
  farm              Farm?                 @relation(fields: [farmId], references: [id])
  cropCycle         CropCycle?            @relation(fields: [cropCycleId], references: [id])
  provider          InsuranceProvider     @relation(fields: [providerId], references: [id])
  claims            InsuranceClaim[]
  renewedFromPolicy InsurancePolicy?      @relation("PolicyRenewal", fields: [renewedFromPolicyId], references: [id])
  renewals          InsurancePolicy[]     @relation("PolicyRenewal")

  @@map("insurance_policies")
}

model InsuranceClaim {
  id                  String      @id @default(uuid())
  policyId            String      @map("policy_id")
  incidentDate        DateTime    @map("incident_date")
  incidentType        String      @map("incident_type") // e.g., flood, drought, pest, disease
  description         String?
  claimedAmount       Float       @map("claimed_amount")
  status              ClaimStatus @default(SUBMITTED)
  // Loose id reference (no @relation), matching Farmer.verifiedById/assignedOfficerId convention.
  inspectedById       String?     @map("inspected_by_id")
  inspectionNotes     String?     @map("inspection_notes")
  inspectionDate      DateTime?   @map("inspection_date")
  paidAmount          Float?      @map("paid_amount")
  paidAt              DateTime?   @map("paid_at")
  /// Field inspection: photos, the loss the inspector measured and what they recommend (APPROVE, REJECT, REINSPECT).
  inspectionPhotoUrls String[]    @map("inspection_photo_urls")
  assessedLossAmount  Float?      @map("assessed_loss_amount")
  recommendation      String?
  /// The insurer's decision.
  approvedAmount      Float?      @map("approved_amount")
  decisionNote        String?     @map("decision_note")
  decidedAt           DateTime?   @map("decided_at")
  paymentReference    String?     @map("payment_reference")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  policy InsurancePolicy @relation(fields: [policyId], references: [id])

  @@map("insurance_claims")
}

// ============================================================
// WEATHER & EARLY WARNING
// ============================================================

enum WeatherAlertStatus {
  DRAFT
  SENT
  DISMISSED
}

enum AlertChannel {
  SMS
  APP
  WHATSAPP
  OFFICER
}

/// One message of one alert to one person on one channel, so staff can see who was reached.
model AlertDelivery {
  id        String       @id @default(uuid())
  alertId   String       @map("alert_id")
  userId    String?      @map("user_id")
  farmerId  String?      @map("farmer_id")
  channel   AlertChannel
  status    String // SENT, FAILED, SKIPPED
  detail    String?
  createdAt DateTime     @default(now()) @map("created_at")

  alert WeatherAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, channel])
  @@map("alert_deliveries")
}

/// The latest 7-day forecast for an area, so apps, USSD and the daily check never wait on the weather service.
model WeatherSnapshot {
  id        String   @id @default(uuid())
  areaKey   String   @unique @map("area_key")
  region    String?
  district  String?
  latitude  Float
  longitude Float
  days      Json
  fetchedAt DateTime @map("fetched_at")

  @@map("weather_snapshots")
}

enum WeatherAlertType {
  FLOOD
  DROUGHT
  PEST
  DISEASE
  PLANTING_RECOMMENDATION
  IRRIGATION_RECOMMENDATION
  GENERAL
}

enum WeatherAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model WeatherAlert {
  id                String               @id @default(uuid())
  region            String?
  district          String?
  ward              String?
  alertType         WeatherAlertType     @map("alert_type")
  severity          WeatherAlertSeverity @default(MEDIUM)
  title             String
  message           String
  // Loose id reference (no @relation), matching Farmer.verifiedById convention.
  issuedById        String?              @map("issued_by_id")
  validFrom         DateTime             @default(now()) @map("valid_from")
  validUntil        DateTime?            @map("valid_until")
  smsSentCount      Int                  @default(0) @map("sms_sent_count")
  createdAt         DateTime             @default(now()) @map("created_at")
  /// Cooperative whose farmers get the alert; null = every farmer in the area (issued by Super Admin).
  mamcosId          String?              @map("mamcos_id")
  /// Drafts wait for staff to review and send; manual alerts go out straight away.
  status            WeatherAlertStatus   @default(DRAFT)
  /// MANUAL (a person wrote it) or AUTO (drafted from the forecast).
  source            String               @default("MANUAL")
  titleSw           String?              @map("title_sw")
  messageSw         String?              @map("message_sw")
  /// What the forecast showed when an automatic draft was made.
  evidence          Json?
  reviewedByUserId  String?              @map("reviewed_by_user_id")
  sentAt            DateTime?            @map("sent_at")
  appSentCount      Int                  @default(0) @map("app_sent_count")
  whatsappSentCount Int                  @default(0) @map("whatsapp_sent_count")
  officersNotified  Int                  @default(0) @map("officers_notified")
  deliveries        AlertDelivery[]

  @@index([mamcosId, status])
  @@map("weather_alerts")
}

// ============================================================
// AUDIT & SYSTEM
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String // e.g., "farmer.create", "payment.release"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  /// Cooperative of the acting user at the time; null = platform-level.
  mamcosId   String?  @map("mamcos_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([mamcosId, createdAt])
  @@map("audit_logs")
}

model SmsLog {
  id        String    @id @default(uuid())
  phone     String
  message   String
  type      String // "payment_confirmation", "alert", "notification"
  status    String    @default("pending")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("sms_logs")
}

model ConsentRecord {
  id                      String    @id @default(uuid())
  farmerId                String    @map("farmer_id")
  scope                   String
  granted                 Boolean   @default(true)
  formVersion             String    @default("MAYODATA_CONSENT_2026_07") @map("form_version")
  language                String    @default("sw")
  explanationReadByUserId String?   @map("explanation_read_by_user_id")
  signatureUrl            String?   @map("signature_url")
  thumbprintUrl           String?   @map("thumbprint_url")
  witnessName             String?   @map("witness_name")
  notes                   String?
  capturedAt              DateTime  @default(now()) @map("captured_at")
  revokedAt               DateTime? @map("revoked_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId, scope, capturedAt])
  @@map("consent_records")
}

model FarmerQuestionnaire {
  id                  String   @id @default(uuid())
  farmerId            String   @map("farmer_id")
  farmId              String?  @map("farm_id")
  fieldOfficerUserId  String?  @map("field_officer_user_id")
  formVersion         String   @default("MAYODATA_FIELD_QUESTIONNAIRE_2026_07") @map("form_version")
  language            String   @default("sw")
  officialUse         Json     @default("{}") @map("official_use")
  farmerSnapshot      Json     @default("{}") @map("farmer_snapshot")
  farmRegistration    Json     @default("{}") @map("farm_registration")
  plantingInputs      Json     @default("{}") @map("planting_inputs")
  midSeasonCosts      Json     @default("{}") @map("mid_season_costs")
  harvestSales        Json     @default("{}") @map("harvest_sales")
  consentAcknowledged Boolean  @default(false) @map("consent_acknowledged")
  signatureUrl        String?  @map("signature_url")
  photoUrls           String[] @map("photo_urls")
  gpsLatitude         Float?   @map("gps_latitude")
  gpsLongitude        Float?   @map("gps_longitude")
  capturedAt          DateTime @default(now()) @map("captured_at")
  createdAt           DateTime @default(now()) @map("created_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm   Farm?  @relation(fields: [farmId], references: [id], onDelete: SetNull)

  @@index([farmerId, capturedAt])
  @@index([farmId])
  @@map("farmer_questionnaires")
}

model AiIntegrationRecord {
  id                String   @id @default(uuid())
  sourceType        String   @map("source_type")
  farmId            String?  @map("farm_id")
  cropCycleId       String?  @map("crop_cycle_id")
  lotId             String?  @map("lot_id")
  externalReference String?  @map("external_reference")
  payload           Json     @default("{}")
  recommendation    Json?
  capturedByUserId  String?  @map("captured_by_user_id")
  capturedAt        DateTime @default(now()) @map("captured_at")
  createdAt         DateTime @default(now()) @map("created_at")

  farm      Farm?      @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cropCycle CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  lot       Lot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([sourceType, capturedAt])
  @@index([farmId])
  @@index([cropCycleId])
  @@index([lotId])
  @@map("ai_integration_records")
}

// ============================================================
// LOCATION: Tanzania Administrative Hierarchy (seeded from data.xlsx)
// ADM1 = Region, ADM2 = District, ADM3 = Ward
// ============================================================

model Region {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]

  @@map("regions")
}

model District {
  id       String @id @default(cuid())
  name     String
  regionId String @map("region_id")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  wards    Ward[]

  @@unique([name, regionId])
  @@map("districts")
}

model Ward {
  id         String   @id @default(cuid())
  name       String
  districtId String   @map("district_id")
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([name, districtId])
  @@map("wards")
}

// ============================================================
// PRODUCTION PLATFORM: Plots, Verification, Household, Documents
// ============================================================

model Plot {
  id                  String   @id @default(uuid())
  plotCode            String   @unique @map("plot_code") // e.g., FP-JD-01-P1
  farmId              String   @map("farm_id")
  photoUrls           String[] @default([]) @map("photo_urls")
  name                String?
  sizeAcres           Float?   @map("size_acres")
  soilCondition       String?  @map("soil_condition")
  irrigationStatus    String?  @map("irrigation_status")
  currentStage        String?  @map("current_stage") // denormalized from active CropCycle
  boundaryCoordinates Json?    @map("boundary_coordinates")
  centerLatitude      Float?   @map("center_latitude")
  centerLongitude     Float?   @map("center_longitude")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropCycles     CropCycle[]
  activityLogs   ActivityLog[]
  goodsReceipts  GoodsReceipt[]
  farmTasks      FarmTask[]
  harvestRecords HarvestRecord[]

  @@map("plots")
}

model FarmerVerification {
  id                String             @id @default(uuid())
  farmerId          String             @map("farmer_id")
  fieldOfficerId    String             @map("field_officer_id")
  status            VerificationStatus
  gpsVerified       Boolean            @default(false) @map("gps_verified")
  documentsReviewed Boolean            @default(false) @map("documents_reviewed")
  notes             String?
  rejectionReason   String?            @map("rejection_reason")
  gpsLatitude       Float?             @map("gps_latitude")
  gpsLongitude      Float?             @map("gps_longitude")
  verifiedAt        DateTime           @default(now()) @map("verified_at")

  farmer       Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  fieldOfficer MamcosStaff @relation(fields: [fieldOfficerId], references: [id])

  @@index([farmerId])
  @@map("farmer_verifications")
}

model Household {
  id                  String   @id @default(uuid())
  farmerId            String   @unique @map("farmer_id")
  householdSize       Int?     @map("household_size")
  dependents          Int?
  adultsCount         Int?     @map("adults_count")
  childrenCount       Int?     @map("children_count")
  primaryIncomeSource String?  @map("primary_income_source")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("households")
}

model Document {
  id           String       @id @default(uuid())
  type         DocumentType
  fileUrl      String       @map("file_url")
  fileName     String       @map("file_name")
  mimeType     String?      @map("mime_type")
  sizeBytes    Int?         @map("size_bytes")
  farmerId     String?      @map("farmer_id")
  farmId       String?      @map("farm_id")
  uploadedById String?      @map("uploaded_by_id")
  verified     Boolean      @default(false)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  farmer Farmer? @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm   Farm?   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([farmId])
  @@map("documents")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String // e.g., "verification.pending", "activity.delayed"
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// Lightweight audit trail of farmer-facing actions, shown as the "Recent
// Activities" feed on the mobile dashboard (farm/plot/document events).
model Activity {
  id        String   @id @default(uuid())
  farmerId  String   @map("farmer_id")
  type      String // e.g., "farm.created", "plot.mapped"
  title     String
  subtitle  String?
  icon      String?
  /// Facts for the app to build the sentence in the person's language; title/subtitle stay as the English fallback.
  params    Json?
  createdAt DateTime @default(now()) @map("created_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId, createdAt])
  @@map("activities")
}

// A field officer's timestamped record of visiting a farmer (routine check,
// helping with a farming activity, in-person verification, etc.). visitedAt
// may be supplied by the officer (visit date) or defaults to submission time.
enum FieldOfficerVisitPurpose {
  ROUTINE_CHECK
  FARMING_ASSISTANCE
  VERIFICATION
  DISPUTE_FOLLOWUP
  TRAINING
  OTHER
}

enum RiceGrowthStage {
  LAND_PREPARATION
  NURSERY_PREPARATION
  /// Transplanting / direct seeding.
  PLANTING
  /// Legacy: older clients still send it; the admin shows it under vegetative growth.
  GERMINATION
  VEGETATIVE_GROWTH
  TILLERING
  /// Legacy: older clients still send it; the admin shows it under tillering.
  PANICLE_INITIATION
  FLOWERING
  GRAIN_FILLING
  MATURITY
  HARVEST
  POST_HARVEST
}

enum ProductionMethod {
  TRANSPLANTING
  DIRECT_SEEDING
  SRI
}

enum CycleIrrigationType {
  RAIN_FED
  CANAL_GRAVITY
  PUMP
  SPRINKLER
  SUPPLEMENTAL
}

enum FieldConditionStatus {
  GOOD
  FAIR
  POOR
  NONE
}

model FieldOfficerVisit {
  id                String                   @id @default(uuid())
  fieldOfficerId    String                   @map("field_officer_id")
  farmerId          String                   @map("farmer_id")
  farmId            String?                  @map("farm_id")
  cropCycleId       String?                  @map("crop_cycle_id")
  purpose           FieldOfficerVisitPurpose @default(ROUTINE_CHECK)
  notes             String?
  growthStage       RiceGrowthStage?         @map("growth_stage")
  riceVariety       String?                  @map("rice_variety")
  cropCondition     FieldConditionStatus?    @map("crop_condition")
  waterStatus       FieldConditionStatus?    @map("water_status")
  weedStatus        FieldConditionStatus?    @map("weed_status")
  pestStatus        FieldConditionStatus?    @map("pest_status")
  diseaseStatus     FieldConditionStatus?    @map("disease_status")
  fertilizerApplied Boolean?                 @map("fertilizer_applied")
  inputUsed         String?                  @map("input_used")
  inputQuantity     String?                  @map("input_quantity")
  observations      String?
  recommendations   String?
  nextVisitDate     DateTime?                @map("next_visit_date")
  photoUrls         String[]                 @map("photo_urls")
  gpsLatitude       Float?                   @map("gps_latitude")
  gpsLongitude      Float?                   @map("gps_longitude")
  visitedAt         DateTime                 @map("visited_at")
  createdAt         DateTime                 @default(now()) @map("created_at")

  fieldOfficer MamcosStaff @relation(fields: [fieldOfficerId], references: [id], onDelete: Cascade)
  farmer       Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm         Farm?       @relation(fields: [farmId], references: [id])
  cropCycle    CropCycle?  @relation(fields: [cropCycleId], references: [id])

  @@index([fieldOfficerId, visitedAt])
  @@index([farmerId, visitedAt])
  @@index([fieldOfficerId, nextVisitDate])
  @@map("field_officer_visits")
}

// ============================================================
// SEASONS, OWNERSHIP, LEASES & SEASONAL ASSIGNMENTS
// ============================================================

model FarmingSeason {
  id                    String              @id @default(uuid())
  name                  String              @unique // e.g., "2026/2027 Masika"
  mamcosId              String?             @map("mamcos_id")
  region                String?
  crop                  String?
  startDate             DateTime            @map("start_date")
  endDate               DateTime            @map("end_date")
  registrationOpenDate  DateTime?           @map("registration_open_date")
  registrationCloseDate DateTime?           @map("registration_close_date")
  verificationDeadline  DateTime?           @map("verification_deadline")
  status                FarmingSeasonStatus @default(DRAFT)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  mamcos          Mamcos?                  @relation(fields: [mamcosId], references: [id])
  memberships     Membership[]
  leases          FarmLease[]
  assignments     SeasonalFarmAssignment[]
  rewardCampaigns RewardCampaign[]
  disputes        Dispute[]
  cropCycles      CropCycle[]

  @@map("farming_seasons")
}

// Legal owner record — independent of who farms the land in a season.
model FarmOwnership {
  id                 String             @id @default(uuid())
  farmId             String             @map("farm_id")
  ownerFarmerId      String?            @map("owner_farmer_id")
  ownerName          String?            @map("owner_name")
  ownerPhone         String?            @map("owner_phone")
  source             OwnershipSource    @default(OWNER)
  confirmationStatus VerificationStatus @default(PENDING) @map("confirmation_status")
  confirmedAt        DateTime?          @map("confirmed_at")
  verifiedByUserId   String?            @map("verified_by_user_id")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  farm        Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ownerFarmer Farmer? @relation("LegalOwner", fields: [ownerFarmerId], references: [id])

  @@index([farmId])
  @@map("farm_ownerships")
}

model FarmLease {
  id                        String             @id @default(uuid())
  farmId                    String             @map("farm_id")
  ownerFarmerId             String?            @map("owner_farmer_id")
  renterFarmerId            String?            @map("renter_farmer_id")
  renterName                String?            @map("renter_name")
  renterPhone               String             @map("renter_phone")
  farmingSeasonId           String             @map("farming_season_id")
  leaseStartDate            DateTime           @map("lease_start_date")
  leaseEndDate              DateTime           @map("lease_end_date")
  ownerConfirmationStatus   VerificationStatus @default(PENDING) @map("owner_confirmation_status")
  renterConfirmationStatus  VerificationStatus @default(PENDING) @map("renter_confirmation_status")
  officerConfirmationStatus VerificationStatus @default(PENDING) @map("officer_confirmation_status")
  status                    LeaseStatus        @default(PENDING_VERIFICATION)
  notes                     String?
  agreementDocumentUrl      String?            @map("agreement_document_url")

  // Officer-assisted verification evidence trail (prompt.md §10 / prompt2.md §23).
  officerVerificationMethod OfficerVerificationMethod? @map("officer_verification_method")
  officerContactedName      String?                    @map("officer_contacted_name")
  officerContactedPhone     String?                    @map("officer_contacted_phone")
  officerEvidenceUrls       String[]                   @map("officer_evidence_urls")
  officerDecidedAt          DateTime?                  @map("officer_decided_at")
  officerDecidedByUserId    String?                    @map("officer_decided_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farm          Farm                     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ownerFarmer   Farmer?                  @relation("LeaseOwner", fields: [ownerFarmerId], references: [id])
  renterFarmer  Farmer?                  @relation("LeaseRenter", fields: [renterFarmerId], references: [id])
  farmingSeason FarmingSeason            @relation(fields: [farmingSeasonId], references: [id])
  assignments   SeasonalFarmAssignment[]
  disputes      Dispute[]

  @@index([farmId, farmingSeasonId])
  @@index([renterPhone])
  @@map("farm_leases")
}

// Who actively farms a given farm in a given season (owner or verified renter).
model SeasonalFarmAssignment {
  id              String             @id @default(uuid())
  farmId          String             @map("farm_id")
  farmingSeasonId String             @map("farming_season_id")
  activeFarmerId  String             @map("active_farmer_id")
  leaseId         String?            @map("lease_id")
  assignmentType  AssignmentType     @map("assignment_type")
  status          VerificationStatus @default(PENDING)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  farm          Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmingSeason FarmingSeason @relation(fields: [farmingSeasonId], references: [id])
  activeFarmer  Farmer        @relation("ActiveFarmer", fields: [activeFarmerId], references: [id])
  lease         FarmLease?    @relation(fields: [leaseId], references: [id])

  // One primary seasonal operator per farm and season (data-integrity rule).
  @@unique([farmId, farmingSeasonId])
  @@map("seasonal_farm_assignments")
}

// ============================================================
// MEMBERSHIP (free registration, paid analytics)
// ============================================================

model MembershipPlan {
  id           String                 @id @default(uuid())
  name         String                 @unique
  description  String?
  priceTzs     Float                  @map("price_tzs")
  durationType MembershipDurationType @default(SEASON) @map("duration_type")
  features     String[]
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("membership_plans")
}

model Membership {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  farmerId             String?          @map("farmer_id")
  planId               String           @map("plan_id")
  farmingSeasonId      String?          @map("farming_season_id")
  status               MembershipStatus @default(PAYMENT_PENDING)
  paymentStatus        PaymentStatus    @default(PENDING) @map("payment_status")
  paymentReference     String?          @map("payment_reference")
  orderReference       String?          @unique @map("order_reference") // ClickPesa order reference
  amountTzs            Float?           @map("amount_tzs")
  startDate            DateTime?        @map("start_date")
  endDate              DateTime?        @map("end_date")
  activatedAt          DateTime?        @map("activated_at")
  expiryReminderSentAt DateTime?        @map("expiry_reminder_sent_at")
  approvedByUserId     String?          @map("approved_by_user_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmer        Farmer?        @relation(fields: [farmerId], references: [id])
  plan          MembershipPlan @relation(fields: [planId], references: [id])
  farmingSeason FarmingSeason? @relation(fields: [farmingSeasonId], references: [id])
  payments      Payment[]

  @@index([userId, status])
  @@map("memberships")
}

model MemberContribution {
  id               String   @id @default(uuid())
  mamcosId         String   @map("mamcos_id")
  farmerId         String   @map("farmer_id")
  amount           Float
  contributionDate DateTime @map("contribution_date")
  paymentMethod    String?  @map("payment_method")
  reference        String?
  description      String?
  createdAt        DateTime @default(now()) @map("created_at")

  mamcos Mamcos @relation(fields: [mamcosId], references: [id], onDelete: Restrict)
  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Restrict)

  @@index([mamcosId, contributionDate])
  @@index([farmerId, contributionDate])
  @@map("member_contributions")
}

model ReserveAllocation {
  id             String   @id @default(uuid())
  mamcosId       String   @map("mamcos_id")
  amount         Float
  allocationDate DateTime @map("allocation_date")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  mamcos Mamcos @relation(fields: [mamcosId], references: [id], onDelete: Restrict)

  @@index([mamcosId, allocationDate])
  @@map("reserve_allocations")
}

// ============================================================
// FARM-ACTION ALERTS (free preview, premium recommendation)
// ============================================================

model FarmAlert {
  id                 String        @id @default(uuid())
  farmId             String        @map("farm_id")
  plotId             String?       @map("plot_id")
  farmerId           String?       @map("farmer_id") // active/target farmer
  farmingSeasonId    String?       @map("farming_season_id")
  cropCycleId        String?       @map("crop_cycle_id")
  category           AlertCategory
  urgency            AlertUrgency  @default(MEDIUM)
  title              String
  // Shown to everyone (free preview): what & where, no diagnosis.
  previewMessage     String        @map("preview_message")
  // Premium-only: stripped from API responses for non-members.
  recommendation     String?
  actionDetails      String?       @map("action_details")
  expectedActionDate DateTime?     @map("expected_action_date")
  // Dedupe key so the generator doesn't repeat the same open alert.
  dedupeKey          String?       @map("dedupe_key")
  status             AlertStatus   @default(OPEN)
  completedAt        DateTime?     @map("completed_at")
  completedByUserId  String?       @map("completed_by_user_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([farmId, status])
  @@map("farm_alerts")
}

// ============================================================
// FARMER REWARDS & INCENTIVES (auditable selection)
// ============================================================

model RewardCampaign {
  id                   String               @id @default(uuid())
  name                 String
  description          String?
  sponsor              String?
  rewardType           RewardType           @map("reward_type")
  rewardQuantity       Int                  @default(1) @map("reward_quantity") // per winner
  numberOfWinners      Int                  @default(1) @map("number_of_winners")
  farmingSeasonId      String?              @map("farming_season_id")
  eligibleCooperatives String[]             @map("eligible_cooperatives")
  eligibilityStartDate DateTime?            @map("eligibility_start_date")
  eligibilityEndDate   DateTime?            @map("eligibility_end_date")
  selectionMethod      SelectionMethod      @default(RANDOM) @map("selection_method")
  status               RewardCampaignStatus @default(DRAFT)

  // Auditable selection record (prompt §16): reproducible from seed + snapshot.
  selectionSeed             String?   @map("selection_seed")
  selectionAlgorithmVersion String?   @map("selection_algorithm_version")
  eligibleSnapshot          Json?     @map("eligible_snapshot") // farmer ids considered
  selectedAt                DateTime? @map("selected_at")
  createdByUserId           String?   @map("created_by_user_id")
  approvedByUserId          String?   @map("approved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farmingSeason FarmingSeason? @relation(fields: [farmingSeasonId], references: [id])
  winners       RewardWinner[]

  @@map("reward_campaigns")
}

model RewardWinner {
  id          String             @id @default(uuid())
  campaignId  String             @map("campaign_id")
  farmerId    String             @map("farmer_id")
  farmId      String?            @map("farm_id")
  rewardType  RewardType         @map("reward_type")
  quantity    Int                @default(1)
  status      RewardWinnerStatus @default(SELECTED)
  notifiedAt  DateTime?          @map("notified_at")
  confirmedAt DateTime?          @map("confirmed_at")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  campaign RewardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  farmer   Farmer         @relation(fields: [farmerId], references: [id])

  // One award per farmer per campaign (no duplicate winners).
  @@unique([campaignId, farmerId])
  @@index([farmerId])
  @@map("reward_winners")
}

// ============================================================
// AMCOS-FIRST FARM REGISTRY (pre-registration before owner has an account)
// ============================================================

// A farm pre-registered by a cooperative (prompt2 §2, §22). It exists before the
// owner has an account; when the owner registers and confirms, it is materialized
// into a real Farm (`farmId` links the two).
model FarmRegistryRecord {
  id                String             @id @default(uuid())
  sourceMamcosId    String?            @map("source_mamcos_id")
  sourceOfficerId   String?            @map("source_officer_id") // user id who entered it
  ownerName         String             @map("owner_name")
  ownerPhone        String             @map("owner_phone")
  ownerNationalId   String?            @map("owner_national_id")
  name              String?
  plotNumber        String?            @map("plot_number")
  block             String?
  canal             String?
  scheme            String?
  section           String?
  village           String?
  ward              String?
  district          String?
  region            String?
  farmSizeHectares  Float?             @map("farm_size_hectares")
  status            FarmRegistryStatus @default(OWNER_CONFIRMATION_PENDING)
  notes             String?
  farmId            String?            @unique @map("farm_id") // set once claimed/materialized
  claimedByFarmerId String?            @map("claimed_by_farmer_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  mamcos               Mamcos?                    @relation(fields: [sourceMamcosId], references: [id])
  confirmationRequests OwnerConfirmationRequest[]

  @@index([ownerPhone, status])
  @@map("farm_registry_records")
}

// Expiring, auditable owner-confirmation request sent by SMS/USSD/app
// (prompt2 §5 / prompt.md §10): records the exact message sent, the channel,
// and the eventual response so a stale or repeated request can't be replayed.
model OwnerConfirmationRequest {
  id               String                    @id @default(uuid())
  farmId           String?                   @map("farm_id")
  registryRecordId String?                   @map("registry_record_id")
  phone            String
  channel          ConfirmationChannel       @default(SMS)
  message          String
  status           ConfirmationRequestStatus @default(SENT)
  response         String?
  resendCount      Int                       @default(0) @map("resend_count")
  sentAt           DateTime                  @default(now()) @map("sent_at")
  expiresAt        DateTime                  @map("expires_at")
  respondedAt      DateTime?                 @map("responded_at")
  createdAt        DateTime                  @default(now()) @map("created_at")

  farm           Farm?               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  registryRecord FarmRegistryRecord? @relation(fields: [registryRecordId], references: [id], onDelete: Cascade)

  @@index([phone, status])
  @@index([farmId])
  @@index([registryRecordId])
  @@map("owner_confirmation_requests")
}

// A farmer- or officer-submitted correction to a farm field. Never overwrites
// verified data silently (prompt2 §19) — held for review, then merged.
model SuggestedFarmUpdate {
  id                String                @id @default(uuid())
  farmId            String                @map("farm_id")
  submittedByUserId String?               @map("submitted_by_user_id")
  fieldName         String                @map("field_name")
  currentValue      String?               @map("current_value")
  suggestedValue    String                @map("suggested_value")
  evidenceUrls      String[]              @map("evidence_urls")
  reviewStatus      SuggestedUpdateStatus @default(PENDING) @map("review_status")
  reviewedByUserId  String?               @map("reviewed_by_user_id")
  reviewNotes       String?               @map("review_notes")
  reviewedAt        DateTime?             @map("reviewed_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, reviewStatus])
  @@map("suggested_farm_updates")
}

// Source-tracked value for a single farm attribute (prompt2 §16/§18). Multiple
// sources may report the same field; conflicting values are flagged rather
// than silently overwritten, and an officer picks the approved final value.
model FarmDataValue {
  id                 String             @id @default(uuid())
  farmId             String             @map("farm_id")
  fieldName          String             @map("field_name")
  value              String
  sourceType         FarmDataSource     @map("source_type")
  sourceId           String?            @map("source_id")
  confidenceLevel    Int?               @map("confidence_level") // 0–100
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  hasConflict        Boolean            @default(false) @map("has_conflict")
  recordedAt         DateTime           @default(now()) @map("recorded_at")
  verifiedAt         DateTime?          @map("verified_at")
  supersededById     String?            @map("superseded_by_id")

  farm         Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  supersededBy FarmDataValue?  @relation("FarmDataValueSupersedes", fields: [supersededById], references: [id])
  supersedes   FarmDataValue[] @relation("FarmDataValueSupersedes")

  @@index([farmId, fieldName])
  @@map("farm_data_values")
}

// Ownership/rental/boundary dispute (prompt.md §22). While OPEN, sensitive
// farm access (leasing, ownership confirmation) is restricted until an
// authorized officer resolves it.
model Dispute {
  id                String        @id @default(uuid())
  farmId            String?       @map("farm_id")
  leaseId           String?       @map("lease_id")
  farmingSeasonId   String?       @map("farming_season_id")
  rentalRecordId    String?       @map("rental_record_id")
  type              DisputeType
  description       String
  claimantIds       String[]      @map("claimant_ids")
  evidenceUrls      String[]      @map("evidence_urls")
  raisedByUserId    String?       @map("raised_by_user_id")
  assignedOfficerId String?       @map("assigned_officer_id")
  status            DisputeStatus @default(OPEN)
  resolution        String?
  resolvedByUserId  String?       @map("resolved_by_user_id")
  resolvedAt        DateTime?     @map("resolved_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  farm          Farm?              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  lease         FarmLease?         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  farmingSeason FarmingSeason?     @relation(fields: [farmingSeasonId], references: [id])
  rentalRecord  AmcosRentalRecord? @relation(fields: [rentalRecordId], references: [id])

  @@index([farmId, status])
  @@index([rentalRecordId])
  @@map("disputes")
}

