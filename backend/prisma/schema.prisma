// ============================================================
// MAYODE GROUP Integrated System — Prisma Database Schema
// ============================================================
// PostgreSQL. GPS boundaries stored as GeoJSON (Json), so no
// PostGIS extension is required.
// Covers: Users, Farmers, Farms, Plots, MAMCOS, Crop Cycles,
//         Verification, Documents, Notifications,
//         Payments, Inventory, Buyers, M-LAX Marketplace
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// CORE: User & Authentication
// ============================================================

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  language     String    @default("sw") // sw = Swahili, en = English
  pushToken    String?   @map("push_token") // Expo Push Notification Token
  profilePhotoUrl String? @map("profile_photo_url")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roleId String? @map("role_id")

  // Relations
  farmer        Farmer?
  mamcosStaff   MamcosStaff?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  memberships   Membership[]
  dispatches    Dispatch[]
  customRole    Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PartnerApiKey {
  id          String              @id @default(uuid())
  partnerName String              @map("partner_name")
  keyPrefix   String              @unique @map("key_prefix")
  keyHash     String              @map("key_hash")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  lastUsedAt  DateTime?           @map("last_used_at")
  requests    PartnerApiRequest[]

  @@map("partner_api_keys")
}

model PartnerApiRequest {
  id           String        @id @default(uuid())
  apiKeyId     String        @map("api_key_id")
  farmerId     String?       @map("farmer_id")
  endpoint     String
  ipAddress    String?       @map("ip_address")
  responseCode Int           @map("response_code")
  createdAt    DateTime      @default(now()) @map("created_at")
  apiKey       PartnerApiKey @relation(fields: [apiKeyId], references: [id])

  @@index([farmerId, createdAt])
  @@map("partner_api_requests")
}

// ============================================================
// CORE: Farmer Profile
// ============================================================

model Farmer {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  controlNumber String    @unique @map("control_number") // Auto-generated: MYD-00001
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        Gender?
  nationalId    String?   @unique @map("national_id")
  photoUrl      String?   @map("photo_url")
  village       String?
  ward          String?
  district      String?   @default("Mbarali")
  region        String?   @default("Mbeya")
  familySize    Int?      @map("family_size")

  // Extended profile (rice-production platform)
  email                  String?
  residenceLatitude      Float?          @map("residence_latitude")
  residenceLongitude     Float?          @map("residence_longitude")
  educationLevel         EducationLevel? @map("education_level")
  farmingExperienceYears Int?            @map("farming_experience_years")
  dependents             Int?

  // Verification workflow
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedById       String?            @map("verified_by_id")
  verifiedAt         DateTime?          @map("verified_at")

  // Which field officer is responsible for following up on this farmer —
  // loose id reference (no @relation), matching the verifiedById convention
  // above. Powers the "pending tasks per officer" admin view.
  assignedOfficerId String? @map("assigned_officer_id")

  membershipDate   DateTime  @default(now()) @map("membership_date")
  creditScore      Float     @default(0) @map("credit_score")
  dataShareConsent Boolean   @default(false) @map("data_share_consent")
  consentedAt      DateTime? @map("consented_at")
  isBlacklisted    Boolean   @default(false) @map("is_blacklisted")
  blacklistReason  String?   @map("blacklist_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  user                      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mamcosId                  String?                        @map("mamcos_id")
  mamcos                    Mamcos?                        @relation(fields: [mamcosId], references: [id])
  farms                     Farm[]
  cropCycles                CropCycle[]
  payments                  Payment[]                      @relation("FarmerPayments")
  landListings              LandListing[]                  @relation("LandOwner")
  rentals                   LandListing[]                  @relation("LandRenter")
  previousRentals           LandListing[]                  @relation("LandPreviousRenter")
  subLeasesAsOriginalRenter LandListingSubLease[]          @relation("SubLeaseOriginalRenter")
  subLeasesAsNewRenter      LandListingSubLease[]          @relation("SubLeaseNewRenter")
  ownershipTransfersFrom    LandListingOwnershipTransfer[] @relation("TransferFromOwner")
  ownershipTransfersTo      LandListingOwnershipTransfer[] @relation("TransferToOwner")
  escrowPayouts             EscrowPayment[]
  landListingOffers         LandListingOffer[]
  landListingImprovements   LandListingImprovement[]
  tractorBookings           TractorBooking[]
  inventoryRecords          InventoryRecord[]
  loanRecords               LoanRecord[]
  household                 Household?
  documents                 Document[]
  verifications             FarmerVerification[]
  memberships               Membership[]
  farmOwnerships            FarmOwnership[]                @relation("LegalOwner")
  leasesAsOwner             FarmLease[]                    @relation("LeaseOwner")
  leasesAsRenter            FarmLease[]                    @relation("LeaseRenter")
  seasonalAssignments       SeasonalFarmAssignment[]       @relation("ActiveFarmer")
  rewardWins                RewardWinner[]
  activities                Activity[]
  officerVisits             FieldOfficerVisit[]
  saleApportionments        SaleApportionment[]
  voteResponses             VoteResponse[]
  consentRecords            ConsentRecord[]
  questionnaires            FarmerQuestionnaire[]
  insurancePolicies         InsurancePolicy[]

  @@map("farmers")
}

// ============================================================
// CORE: Field Officer
// ============================================================

enum MamcosStaffRole {
  SECRETARY
  FIELD_OFFICER
}

// A staff member belonging to one AMCOS, with a role. Unifies what used to
// be two separate tables (FieldOfficer, MamcosSecretary) so a future staff
// role is just a new enum value, not a new model. "One secretary per AMCOS"
// is enforced via a partial unique index added by raw SQL in the migration
// (mamcos_id WHERE role = 'SECRETARY') — Prisma's schema DSL can't express
// partial indexes, so it isn't declared here, but the DB still enforces it.
model MamcosStaff {
  id             String          @id @default(uuid())
  userId         String          @unique @map("user_id")
  // Nullable: existing officers predate AMCOS scoping.
  mamcosId       String?         @map("mamcos_id")
  role           MamcosStaffRole
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  // Field-officer only.
  employeeCode   String?         @unique @map("employee_code")
  assignedArea   String?         @map("assigned_area")
  // Secretary only.
  stabilityBonus Float           @default(0) @map("stability_bonus")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  mamcos              Mamcos?              @relation(fields: [mamcosId], references: [id])
  farmVerifications   FarmVerification[]
  farmerVerifications FarmerVerification[]
  activityLogs        ActivityLog[]
  visits              FieldOfficerVisit[]
  facilitatedListings LandListing[]

  @@index([mamcosId])
  @@map("mamcos_staff")
}

// ============================================================
// CORE: MAMCOS (Cooperative Schemes)
// ============================================================

model Mamcos {
  id            String   @id @default(uuid())
  name          String   @unique
  location      String?
  district      String?  @default("Mbarali")
  totalHectares Float?   @map("total_hectares")
  chairmanName  String?  @map("chairman_name")
  chairmanPhone String?  @map("chairman_phone")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  staff              MamcosStaff[]
  farmers            Farmer[]
  farms              Farm[]
  farmingSeasons     FarmingSeason[]
  registryRecords    FarmRegistryRecord[]
  riceProtocols      RiceProtocol[]
  irrigationSchemes  IrrigationScheme[]
  aggregationCentres AggregationCentre[]

  @@map("mamcos")
}

model IrrigationScheme {
  id               String   @id @default(uuid())
  mamcosId         String?  @map("mamcos_id")
  name             String
  schemeType       String?  @map("scheme_type")
  coverageHectares Float?   @map("coverage_hectares")
  waterSource      String?  @map("water_source")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  mamcos Mamcos? @relation(fields: [mamcosId], references: [id])

  @@map("irrigation_schemes")
}

model AggregationCentre {
  id            String   @id @default(uuid())
  mamcosId      String?  @map("mamcos_id")
  name          String
  location      String?
  capacityKg    Float?   @map("capacity_kg")
  contactPerson String?  @map("contact_person")
  contactPhone  String?  @map("contact_phone")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  mamcos Mamcos? @relation(fields: [mamcosId], references: [id])

  @@map("aggregation_centres")
}

// ============================================================
// CORE: Farm (Multi-farm per farmer)
// ============================================================

model Farm {
  id             String    @id @default(uuid())
  farmCode       String    @unique @map("farm_code") // e.g., FP-JD-01
  // Official farms are owned by AMCOS. This remains only for legacy records;
  // a verified SeasonalFarmAssignment grants renter operating access.
  farmerId       String?   @map("farmer_id")
  mamcosId       String?   @map("mamcos_id")
  name           String
  plotNumber     String?   @map("plot_number")
  blockNumber    String?   @map("block_number")
  section        String?
  village        String?
  ward           String?
  district       String?
  region         String?
  socialHectares Float     @map("social_hectares") // The "social" unit
  actualAcres    Float?    @map("actual_acres") // GPS-verified actual size
  grade          FarmGrade @default(B)
  vichuguuCount  Int       @default(0) @map("vichuguu_count")
  hasIrrigation  Boolean   @default(false) @map("has_irrigation")
  nearRoad       Boolean   @default(false) @map("near_road")
  soilCondition  String?   @map("soil_condition")
  photoUrls      String[]  @map("photo_urls")

  // Extended farm characteristics
  ownershipType      OwnershipType? @map("ownership_type")
  ownerName          String?        @map("owner_name")
  ownerPhone         String?        @map("owner_phone")
  landTenure         String?        @map("land_tenure")
  soilType           String?        @map("soil_type")
  soilFertility      String?        @map("soil_fertility")
  waterSource        String?        @map("water_source")
  irrigationMethod   String?        @map("irrigation_method")
  accessibility      String?
  previousCrops      String[]       @map("previous_crops")
  isVerified         Boolean        @default(false) @map("is_verified")
  isAvailableForRent Boolean        @default(false) @map("is_available_for_rent")
  isLeased           Boolean        @default(false) @map("is_leased")
  leaseLockedUntil   DateTime?      @map("lease_locked_until")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  // GPS Boundary (stored as GeoJSON polygon via PostGIS)
  // We store coordinates as JSON since Prisma doesn't natively support PostGIS geometry
  boundaryCoordinates Json?  @map("boundary_coordinates")
  centerLatitude      Float? @map("center_latitude")
  centerLongitude     Float? @map("center_longitude")

  // Relations
  farmer               Farmer?                    @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  mamcos               Mamcos?                    @relation(fields: [mamcosId], references: [id])
  plots                Plot[]
  cropCycles           CropCycle[]
  landListings         LandListing[]
  verifications        FarmVerification[]
  inventoryRecords     InventoryRecord[]
  documents            Document[]
  ownerships           FarmOwnership[]
  leases               FarmLease[]
  seasonalAssignments  SeasonalFarmAssignment[]
  alerts               FarmAlert[]
  photos               FarmPhoto[]
  fieldSurveys         FarmFieldSurvey[]
  disputes             Dispute[]
  suggestedUpdates     SuggestedFarmUpdate[]
  dataValues           FarmDataValue[]
  confirmationRequests OwnerConfirmationRequest[]
  officerVisits        FieldOfficerVisit[]
  questionnaires       FarmerQuestionnaire[]
  aiIntegrationRecords AiIntegrationRecord[]
  insurancePolicies    InsurancePolicy[]

  @@map("farms")
}

model FarmVerification {
  id             String   @id @default(uuid())
  farmId         String   @map("farm_id")
  fieldOfficerId String   @map("field_officer_id")
  verifiedAt     DateTime @default(now()) @map("verified_at")
  gpsVerified    Boolean  @default(false) @map("gps_verified")
  neighborLeft   String?  @map("neighbor_left")
  neighborRight  String?  @map("neighbor_right")
  mamcosApproved Boolean  @default(false) @map("mamcos_approved")
  photoProofUrl  String?  @map("photo_proof_url")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  farm         Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  fieldOfficer MamcosStaff @relation(fields: [fieldOfficerId], references: [id])

  @@map("farm_verifications")
}

// ============================================================
// PRODUCTION: Crop Cycle & Activity Tracking
// ============================================================

model CropCycle {
  id               String          @id @default(uuid())
  farmId           String          @map("farm_id")
  plotId           String?         @map("plot_id") // Farm → Plot → CropCycle (Phase 1+)
  farmerId         String          @map("farmer_id")
  season           String // e.g., "2025/2026 Main"
  riceVariety      String?         @map("rice_variety")
  plantingDate     DateTime?       @map("planting_date")
  expectedHarvest  DateTime?       @map("expected_harvest")
  harvestDate      DateTime?       @map("harvest_date")
  estimatedYieldKg Float?          @map("estimated_yield_kg")
  actualYieldKg    Float?          @map("actual_yield_kg")
  status           CropCycleStatus @default(PLANNED)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  farm                 Farm                  @relation(fields: [farmId], references: [id])
  plot                 Plot?                 @relation(fields: [plotId], references: [id])
  farmer               Farmer                @relation(fields: [farmerId], references: [id])
  activities           ActivityLog[]
  costs                InputCost[]
  revenues             Revenue[]
  officerVisits        FieldOfficerVisit[]
  calendarTasks        RiceCalendarTask[]
  harvestQuality       HarvestQualityCheck?
  inventoryRecords     InventoryRecord[]
  aiIntegrationRecords AiIntegrationRecord[]
  insurancePolicies    InsurancePolicy[]

  @@map("crop_cycles")
}

model ActivityLog {
  id               String       @id @default(uuid())
  cropCycleId      String       @map("crop_cycle_id")
  fieldOfficerId   String?      @map("field_officer_id")
  activityType     ActivityType @map("activity_type")
  activityDate     DateTime     @map("activity_date")
  description      String?
  inputsUsed       Json?        @map("inputs_used") // { name, quantity, unit }
  laborWorkers     Int?         @map("labor_workers")
  laborHours       Float?       @map("labor_hours")
  familyLaborCount Int?         @map("family_labor_count")
  hiredLaborCount  Int?         @map("hired_labor_count")
  laborWageTotal   Float?       @map("labor_wage_total")
  photoUrls        String[]     @map("photo_urls")
  gpsLatitude      Float?       @map("gps_latitude")
  gpsLongitude     Float?       @map("gps_longitude")
  createdAt        DateTime     @default(now()) @map("created_at")

  // Relations
  cropCycle    CropCycle    @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  fieldOfficer MamcosStaff? @relation(fields: [fieldOfficerId], references: [id])

  @@map("activity_logs")
}

// Cooperative-owned, versioned rice calendar. Each task is copied onto the
// crop cycle so later protocol edits never rewrite a farmer's historic plan.
model RiceProtocol {
  id              String   @id @default(uuid())
  mamcosId        String   @map("mamcos_id")
  name            String
  version         Int      @default(1)
  isActive        Boolean  @default(true) @map("is_active")
  taskDefinitions Json     @map("task_definitions")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  mamcos Mamcos @relation(fields: [mamcosId], references: [id], onDelete: Cascade)

  @@unique([mamcosId, version])
  @@index([mamcosId, isActive])
  @@map("rice_protocols")
}

model RiceCalendarTask {
  id                   String             @id @default(uuid())
  cropCycleId          String             @map("crop_cycle_id")
  protocolVersion      Int                @map("protocol_version")
  taskKey              String             @map("task_key")
  title                String
  guidance             String
  activityType         ActivityType?      @map("activity_type")
  dueDate              DateTime           @map("due_date")
  requiredMeasurements Json?              @map("required_measurements")
  evidenceRequired     Boolean            @default(false) @map("evidence_required")
  status               CalendarTaskStatus @default(PENDING)
  measurements         Json?
  photoUrls            String[]           @map("photo_urls")
  completedAt          DateTime?          @map("completed_at")
  completedByUserId    String?            @map("completed_by_user_id")
  activityLogId        String?            @map("activity_log_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@unique([cropCycleId, taskKey])
  @@index([cropCycleId, status, dueDate])
  @@map("rice_calendar_tasks")
}

model HarvestQualityCheck {
  id                  String    @id @default(uuid())
  cropCycleId         String    @unique @map("crop_cycle_id")
  harvestMaturityPct  Float?    @map("harvest_maturity_pct")
  panicleMoisturePct  Float?    @map("panicle_moisture_pct")
  dryingMoisturePct   Float?    @map("drying_moisture_pct")
  bagCount            Int?      @map("bag_count")
  bagWeightKg         Float?    @map("bag_weight_kg")
  warehouseLocation   String?   @map("warehouse_location")
  warehouseReceivedAt DateTime? @map("warehouse_received_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@map("harvest_quality_checks")
}

// ============================================================
// FINANCE: Cost & Revenue Tracking
// ============================================================

model InputCost {
  id            String             @id @default(uuid())
  cropCycleId   String             @map("crop_cycle_id")
  category      CostCategory
  itemName      String             @map("item_name")
  quantity      Float?
  unit          String? // kg, liters, bags, etc.
  unitPrice     Float?             @map("unit_price")
  totalCost     Float              @map("total_cost") // In TZS
  supplier      String? // free-text legacy field, kept for backward compat
  supplierId    String?            @map("supplier_id")
  paymentStatus InputPaymentStatus @default(PENDING) @map("payment_status")
  loanRecordId  String?            @map("loan_record_id")
  receiptUrl    String?            @map("receipt_url")
  dateIncurred  DateTime           @map("date_incurred")
  createdAt     DateTime           @default(now()) @map("created_at")

  cropCycle        CropCycle   @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  supplierRecord   Supplier?   @relation(fields: [supplierId], references: [id])
  linkedLoanRecord LoanRecord? @relation(fields: [loanRecordId], references: [id])

  @@map("input_costs")
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?  @map("contact_person")
  contactPhone  String?  @map("contact_phone")
  contactEmail  String?  @map("contact_email")
  itemsSupplied String[] @map("items_supplied")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  inputCosts InputCost[]
  bills      Bill[]

  @@map("suppliers")
}

model Revenue {
  id               String      @id @default(uuid())
  cropCycleId      String      @map("crop_cycle_id")
  revenueType      RevenueType @map("revenue_type")
  quantityKg       Float       @map("quantity_kg")
  pricePerKg       Float       @map("price_per_kg")
  totalRevenue     Float       @map("total_revenue") // In TZS
  fairtradePremium Float?      @map("fairtrade_premium")
  buyerId          String?     @map("buyer_id")
  saleId           String?     @map("sale_id")
  saleDate         DateTime    @map("sale_date")
  createdAt        DateTime    @default(now()) @map("created_at")

  cropCycle         CropCycle          @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  buyer             Buyer?             @relation(fields: [buyerId], references: [id])
  sale              Sale?              @relation(fields: [saleId], references: [id])
  saleApportionment SaleApportionment?

  @@map("revenues")
}

// ============================================================
// FINANCE: Payments & Escrow
// ============================================================

model Payment {
  id                     String        @id @default(uuid())
  farmerId               String        @map("farmer_id")
  membershipId           String?       @map("membership_id")
  saleId                 String?       @map("sale_id")
  amount                 Float // In TZS
  paymentType            PaymentType   @map("payment_type")
  status                 PaymentStatus
  mpesaRef               String?       @map("mpesa_ref")
  orderReference         String?       @map("order_reference") // ClickPesa order reference
  payoutApprovedByUserId String?       @map("payout_approved_by_user_id")
  payoutApprovedAt       DateTime?     @map("payout_approved_at")
  loanDeduction          Float?        @map("loan_deduction")
  netAmount              Float?        @map("net_amount")
  description            String?
  paidAt                 DateTime?     @map("paid_at")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  farmer         Farmer          @relation("FarmerPayments", fields: [farmerId], references: [id])
  membership     Membership?     @relation(fields: [membershipId], references: [id])
  sale           Sale?           @relation(fields: [saleId], references: [id])
  loanDeductions LoanDeduction[]

  @@map("payments")
}

model LoanRecord {
  id                String   @id @default(uuid())
  farmerId          String   @map("farmer_id")
  lenderId          String?  @map("lender_id")
  lenderName        String   @map("lender_name")
  originalAmount    Float    @map("original_amount")
  amountOwed        Float    @map("amount_owed")
  repaymentSchedule String?  @map("repayment_schedule")
  autoDeductPercent Float?   @map("auto_deduct_percent")
  lenderPayoutPhone String?  @map("lender_payout_phone")
  lenderPayoutName  String?  @map("lender_payout_name")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  farmer           Farmer          @relation(fields: [farmerId], references: [id])
  lender           Lender?         @relation(fields: [lenderId], references: [id])
  deductions       LoanDeduction[]
  linkedInputCosts InputCost[]

  @@map("loan_records")
}

model Lender {
  id                  String   @id @default(uuid())
  name                String   @unique
  contactPerson       String?  @map("contact_person")
  contactPhone        String?  @map("contact_phone")
  contactEmail        String?  @map("contact_email")
  payoutPhone         String?  @map("payout_phone")
  payoutName          String?  @map("payout_name")
  interestRatePercent Float?   @map("interest_rate_percent")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  loans LoanRecord[]

  @@map("lenders")
}

model LoanDeduction {
  id                     String       @id @default(uuid())
  loanRecordId           String       @map("loan_record_id")
  sourcePaymentId        String       @map("source_payment_id")
  amount                 Float
  orderReference         String?      @unique @map("order_reference")
  payoutStatus           PayoutStatus @default(PENDING) @map("payout_status")
  payoutApprovedByUserId String?      @map("payout_approved_by_user_id")
  payoutApprovedAt       DateTime?    @map("payout_approved_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  loanRecord    LoanRecord @relation(fields: [loanRecordId], references: [id])
  sourcePayment Payment    @relation(fields: [sourcePaymentId], references: [id])

  @@unique([loanRecordId, sourcePaymentId])
  @@index([sourcePaymentId])
  @@map("loan_deductions")
}

// ============================================================
// INVENTORY: Traceability & Chain of Custody
// ============================================================

model InventoryRecord {
  id                 String          @id @default(uuid())
  farmId             String          @map("farm_id")
  farmerId           String          @map("farmer_id")
  cropCycleId        String?         @map("crop_cycle_id")
  lotNumber          String?         @map("lot_number")
  weightKg           Float           @map("weight_kg")
  qualityGrade       String?         @map("quality_grade")
  moistureContentPct Float?          @map("moisture_content_pct")
  trackingCode       String          @unique @map("tracking_code")
  warehouseLocation  String?         @map("warehouse_location")
  receivedDate       DateTime        @map("received_date")
  status             InventoryStatus @default(RECEIVED)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  farm      Farm       @relation(fields: [farmId], references: [id])
  farmer    Farmer     @relation(fields: [farmerId], references: [id])
  cropCycle CropCycle? @relation(fields: [cropCycleId], references: [id])
  lot       Lot?       @relation(fields: [lotNumber], references: [lotNumber])

  @@map("inventory_records")
}

model Lot {
  id            String   @id @default(uuid())
  lotNumber     String   @unique @map("lot_number") // e.g., LOT-2025-001
  totalWeightKg Float    @map("total_weight_kg")
  riceVariety   String?  @map("rice_variety")
  createdAt     DateTime @default(now()) @map("created_at")

  inventoryRecords     InventoryRecord[]
  sales                Sale[]
  aiIntegrationRecords AiIntegrationRecord[]

  @@map("lots")
}

// ============================================================
// BUYERS & SALES
// ============================================================

model Buyer {
  id                  String   @id @default(uuid())
  name                String
  fairtradeCertNumber String?  @unique @map("fairtrade_cert_number")
  contactPerson       String?  @map("contact_person")
  contactEmail        String?  @map("contact_email")
  contactPhone        String?  @map("contact_phone")
  isCertified         Boolean  @default(false) @map("is_certified")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sales    Sale[]
  revenues Revenue[]
  invoices Invoice[]
  orders   BuyerOrder[]

  @@map("buyers")
}

model BuyerOrder {
  id                  String           @id @default(uuid())
  buyerId             String           @map("buyer_id")
  riceVariety         String?          @map("rice_variety")
  quantityRequiredKg  Float            @map("quantity_required_kg")
  qualityRequirements String?          @map("quality_requirements")
  status              BuyerOrderStatus @default(OPEN)
  requiredByDate      DateTime?        @map("required_by_date")
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  buyer Buyer  @relation(fields: [buyerId], references: [id])
  sales Sale[]

  @@map("buyer_orders")
}

model Sale {
  id                    String    @id @default(uuid())
  invoiceNumber         String    @unique @map("invoice_number")
  buyerId               String    @map("buyer_id")
  lotId                 String    @map("lot_id")
  buyerOrderId          String?   @map("buyer_order_id")
  riceVariety           String?   @map("rice_variety")
  quantityKg            Float     @map("quantity_kg")
  packaging             String?
  pricePerKg            Float     @map("price_per_kg")
  fairtradePremium      Float?    @map("fairtrade_premium")
  totalRevenue          Float     @map("total_revenue")
  paymentReceived       Boolean   @default(false) @map("payment_received")
  paymentDate           DateTime? @map("payment_date")
  buyerOrderReference   String?   @unique @map("buyer_order_reference")
  buyerPaymentReference String?   @map("buyer_payment_reference")
  saleDate              DateTime  @map("sale_date")
  createdAt             DateTime  @default(now()) @map("created_at")

  buyer              Buyer               @relation(fields: [buyerId], references: [id])
  lot                Lot                 @relation(fields: [lotId], references: [id])
  fulfillsOrder      BuyerOrder?         @relation(fields: [buyerOrderId], references: [id])
  revenues           Revenue[]
  payments           Payment[]
  apportionments     SaleApportionment[]
  premiumFundEntries PremiumFundEntry[]
  invoice            Invoice?
  dispatch           Dispatch?

  @@map("sales")
}

// Immutable audit trail of how a cooperative sale was allocated to source farmers.
// Revenue rows are created from these allocations, while this table preserves the
// original inventory-weight calculation for traceability and dispute resolution.
model SaleApportionment {
  id                String   @id @default(uuid())
  saleId            String   @map("sale_id")
  farmerId          String   @map("farmer_id")
  inventoryWeightKg Float    @map("inventory_weight_kg")
  weightShare       Float    @map("weight_share")
  quantityKg        Float    @map("quantity_kg")
  grossAmount       Float    @map("gross_amount")
  fairtradePremium  Float    @default(0) @map("fairtrade_premium")
  revenueId         String?  @unique @map("revenue_id")
  createdAt         DateTime @default(now()) @map("created_at")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  farmer  Farmer   @relation(fields: [farmerId], references: [id])
  revenue Revenue? @relation(fields: [revenueId], references: [id])

  @@unique([saleId, farmerId])
  @@index([farmerId])
  @@map("sale_apportionments")
}

enum DispatchTransportMode {
  BUYER_OWN_VEHICLE
  MAYODE_ARRANGED
}

// Warehouse gate-pass: recorded when a buyer collects goods for a Sale.
// One dispatch per sale today; if partial/staged pickups are ever needed,
// drop the @unique on saleId (additive migration, not a rewrite).
model Dispatch {
  id                 String                @id @default(uuid())
  saleId             String                @unique @map("sale_id")
  transportMode      DispatchTransportMode @map("transport_mode")
  transportFee       Float?                @map("transport_fee")
  vehiclePlateNumber String                @map("vehicle_plate_number")
  driverName         String                @map("driver_name")
  driverPhone        String                @map("driver_phone")
  releasedByUserId   String                @map("released_by_user_id")
  releasedAt         DateTime              @default(now()) @map("released_at")
  notes              String?
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  sale       Sale @relation(fields: [saleId], references: [id])
  releasedBy User @relation(fields: [releasedByUserId], references: [id])

  @@map("dispatches")
}

// Fairtrade premium is deliberately tracked outside ordinary crop revenue so
// members can audit fund income, expenditure and the resulting balance.
model PremiumFundEntry {
  id          String               @id @default(uuid())
  entryType   PremiumFundEntryType @map("entry_type")
  amount      Float
  description String
  saleId      String?              @map("sale_id")
  entryDate   DateTime             @map("entry_date")
  createdAt   DateTime             @default(now()) @map("created_at")

  sale Sale? @relation(fields: [saleId], references: [id])

  @@index([entryDate])
  @@map("premium_fund_entries")
}

model Account {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  type        AccountType
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  entries     LedgerEntry[]
  budgetLines BudgetLine[]

  @@map("accounts")
}

model LedgerEntry {
  id          String   @id @default(uuid())
  entryNumber String   @map("entry_number")
  accountId   String   @map("account_id")
  debit       Float    @default(0)
  credit      Float    @default(0)
  entryDate   DateTime @map("entry_date")
  sourceType  String   @map("source_type")
  sourceId    String   @map("source_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id])

  @@unique([sourceType, sourceId, accountId])
  @@index([entryDate])
  @@map("ledger_entries")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  saleId         String?       @unique @map("sale_id")
  buyerId        String?       @map("buyer_id")
  amount         Float
  dueDate        DateTime      @map("due_date")
  status         InvoiceStatus @default(OPEN)
  paidAt         DateTime?     @map("paid_at")
  lastReminderAt DateTime?     @map("last_reminder_at")
  reminderCount  Int           @default(0) @map("reminder_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  sale           Sale?         @relation(fields: [saleId], references: [id])
  buyer          Buyer?        @relation(fields: [buyerId], references: [id])

  @@index([dueDate, status])
  @@map("invoices")
}

model Bill {
  id          String        @id @default(uuid())
  billNumber  String        @unique @map("bill_number")
  supplier    String
  supplierId  String?       @map("supplier_id")
  amount      Float
  dueDate     DateTime      @map("due_date")
  status      InvoiceStatus @default(OPEN)
  paidAt      DateTime?     @map("paid_at")
  description String?
  createdAt   DateTime      @default(now()) @map("created_at")

  supplierRef Supplier? @relation(fields: [supplierId], references: [id])

  @@index([dueDate, status])
  @@map("bills")
}

model Budget {
  id          String       @id @default(uuid())
  name        String
  fiscalYear  Int?         @map("fiscal_year")
  seasonLabel String?      @map("season_label")
  startDate   DateTime     @map("start_date")
  endDate     DateTime     @map("end_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  lines       BudgetLine[]

  @@map("budgets")
}

model BudgetLine {
  id        String  @id @default(uuid())
  budgetId  String  @map("budget_id")
  accountId String  @map("account_id")
  amount    Float
  budget    Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account   Account @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId])
  @@map("budget_lines")
}

model CommunityProject {
  id            String        @id @default(uuid())
  name          String
  fundingSource String        @map("funding_source")
  budget        Float
  spentAmount   Float         @default(0) @map("spent_amount")
  status        ProjectStatus @default(OPEN)
  milestones    Json?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("community_projects")
}

model MeetingRecord {
  id            String   @id @default(uuid())
  meetingDate   DateTime @map("meeting_date")
  agenda        String
  decisions     String
  attendeeCount Int      @map("attendee_count")
  createdAt     DateTime @default(now()) @map("created_at")
  votes         Vote[]

  @@map("meeting_records")
}

model Vote {
  id          String         @id @default(uuid())
  title       String
  description String?
  opensAt     DateTime       @map("opens_at")
  closesAt    DateTime       @map("closes_at")
  status      VoteStatus     @default(DRAFT)
  meetingId   String?        @map("meeting_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  options     VoteOption[]
  responses   VoteResponse[]
  meeting     MeetingRecord? @relation(fields: [meetingId], references: [id])

  @@map("votes")
}

model VoteOption {
  id        String         @id @default(uuid())
  voteId    String         @map("vote_id")
  label     String
  vote      Vote           @relation(fields: [voteId], references: [id], onDelete: Cascade)
  responses VoteResponse[]

  @@map("vote_options")
}

model VoteResponse {
  id        String     @id @default(uuid())
  voteId    String     @map("vote_id")
  optionId  String     @map("option_id")
  farmerId  String     @map("farmer_id")
  createdAt DateTime   @default(now()) @map("created_at")
  vote      Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  option    VoteOption @relation(fields: [optionId], references: [id])
  farmer    Farmer     @relation(fields: [farmerId], references: [id])

  @@unique([voteId, farmerId])
  @@map("vote_responses")
}

// ============================================================
// M-LAX: Land Listing & Marketplace
// ============================================================

model LandListing {
  id                   String      @id @default(uuid())
  farmId               String      @map("farm_id")
  ownerId              String      @map("owner_id")
  renterId             String?     @map("renter_id")
  askingPrice          Float       @map("asking_price") // In TZS
  suggestedPrice       Float?      @map("suggested_price")
  finalPrice           Float?      @map("final_price")
  dealType             DealType    @default(STANDARD) @map("deal_type")
  commissionRate       Float       @map("commission_rate")
  commissionAmount     Float?      @map("commission_amount")
  leaseStatus          LeaseStatus @default(DRAFT) @map("lease_status")
  leaseDurationMonths  Int         @map("lease_duration_months")
  leaseStartDate       DateTime?   @map("lease_start_date")
  leaseEndDate         DateTime?   @map("lease_end_date")
  isFlashDeal          Boolean     @default(false) @map("is_flash_deal")
  preferredRenterCode  String?     @map("preferred_renter_code")
  isMultiYear          Boolean     @default(false) @map("is_multi_year")
  pricingModel         String?     @map("pricing_model") // "fixed", "step_up", "rice_linked"
  autoDropPrice        Float?      @map("auto_drop_price") // Flexible pricing auto-drop
  autoDropDays         Int?        @map("auto_drop_days")
  lastPriceDropAt      DateTime?   @map("last_price_drop_at") // Flash-deal cron dedup
  previousRenterId     String?     @map("previous_renter_id") // Last completed renter on this farm, for loyalty pricing
  facilitatedByStaffId String?     @map("facilitated_by_staff_id") // Desk officer who gets the agent fee
  agreementPdfUrl      String?     @map("agreement_pdf_url")
  agreementGeneratedAt DateTime?   @map("agreement_generated_at")
  // Multi-year leases (Step-Up / Rice-Linked pricing)
  paymentPlan          String?     @default("PREPAID") @map("payment_plan") // "PREPAID" | "ANNUAL"
  rentScheduleJson     Json?       @map("rent_schedule_json")
  lastInstallmentYear  Int         @default(0) @map("last_installment_year")
  // Reward for Honesty: every M-LAX in-app deal is MAYODE-protected once escrow is secured
  mayodeProtected      Boolean     @default(false) @map("mayode_protected")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  // Relations
  farm               Farm                           @relation(fields: [farmId], references: [id])
  owner              Farmer                         @relation("LandOwner", fields: [ownerId], references: [id])
  renter             Farmer?                        @relation("LandRenter", fields: [renterId], references: [id])
  previousRenter     Farmer?                        @relation("LandPreviousRenter", fields: [previousRenterId], references: [id])
  facilitatedByStaff MamcosStaff?                   @relation(fields: [facilitatedByStaffId], references: [id])
  escrowPayments     EscrowPayment[]
  subLeases          LandListingSubLease[]
  ownershipTransfers LandListingOwnershipTransfer[]
  offers             LandListingOffer[]
  improvements       LandListingImprovement[]

  @@map("land_listings")
}

model LandListingOffer {
  id            String      @id @default(uuid())
  listingId     String      @map("listing_id")
  farmerId      String      @map("farmer_id") // the farmer making the offer
  offerAmount   Float       @map("offer_amount")
  status        OfferStatus @default(PENDING)
  counterAmount Float?      @map("counter_amount")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  listing LandListing @relation(fields: [listingId], references: [id])
  farmer  Farmer      @relation(fields: [farmerId], references: [id])

  @@map("land_listing_offers")
}

model LandListingImprovement {
  id            String   @id @default(uuid())
  listingId     String   @map("listing_id")
  renterId      String   @map("renter_id")
  description   String
  amountTzs     Float    @map("amount_tzs")
  appliedToYear Int?     @map("applied_to_year") // which installment year this credit was deducted from, if any
  createdAt     DateTime @default(now()) @map("created_at")

  listing LandListing @relation(fields: [listingId], references: [id])
  renter  Farmer      @relation(fields: [renterId], references: [id])

  @@map("land_listing_improvements")
}

model LandListingSubLease {
  id                String         @id @default(uuid())
  originalListingId String         @map("original_listing_id")
  originalRenterId  String         @map("original_renter_id")
  status            SubLeaseStatus @default(PENDING)
  newRenterId       String?        @map("new_renter_id")
  newAskingPrice    Float?         @map("new_asking_price")
  approvedByOwnerAt DateTime?      @map("approved_by_owner_at")
  settledAt         DateTime?      @map("settled_at") // Re-listing fee payout to original renter processed
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  originalListing LandListing @relation(fields: [originalListingId], references: [id])
  originalRenter  Farmer      @relation("SubLeaseOriginalRenter", fields: [originalRenterId], references: [id])
  newRenter       Farmer?     @relation("SubLeaseNewRenter", fields: [newRenterId], references: [id])

  @@map("land_listing_sub_leases")
}

model LandListingOwnershipTransfer {
  id             String    @id @default(uuid())
  listingId      String    @map("listing_id")
  fromOwnerId    String    @map("from_owner_id")
  toOwnerPhone   String    @map("to_owner_phone")
  toOwnerId      String?   @map("to_owner_id")
  reason         String?
  transferFeeTzs Float     @default(10000) @map("transfer_fee_tzs")
  feeChargedAt   DateTime? @map("fee_charged_at") // Fixed transfer fee deducted from the next payout
  transferredAt  DateTime  @default(now()) @map("transferred_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  listing   LandListing @relation(fields: [listingId], references: [id])
  fromOwner Farmer      @relation("TransferFromOwner", fields: [fromOwnerId], references: [id])
  toOwner   Farmer?     @relation("TransferToOwner", fields: [toOwnerId], references: [id])

  @@map("land_listing_ownership_transfers")
}

// ============================================================
// M-LAX: Tractor & Equipment Booking
// ============================================================

model TractorOwner {
  id        String   @id @default(uuid())
  name      String
  phone     String
  location  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tractors Tractor[]

  @@map("tractor_owners")
}

model Tractor {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  registrationNo  String   @unique @map("registration_no")
  model           String?
  horsePower      Int?     @map("horse_power")
  isAvailable     Boolean  @default(true) @map("is_available")
  location        String?
  pricePerHectare Float?   @map("price_per_hectare") // Base price in TZS
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner    TractorOwner     @relation(fields: [ownerId], references: [id])
  bookings TractorBooking[]

  @@map("tractors")
}

model TractorBooking {
  id               String        @id @default(uuid())
  tractorId        String        @map("tractor_id")
  farmerId         String        @map("farmer_id")
  hectares         Float
  terrainGrade     FarmGrade     @map("terrain_grade")
  basePrice        Float         @map("base_price")
  terrainSurcharge Float?        @map("terrain_surcharge")
  totalPrice       Float         @map("total_price")
  commissionRate   Float         @map("commission_rate")
  commissionAmount Float         @map("commission_amount")
  status           BookingStatus @default(PENDING)
  scheduledDate    DateTime      @map("scheduled_date")
  completedAt      DateTime?     @map("completed_at")
  farmerConfirmed  Boolean       @default(false) @map("farmer_confirmed")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tractor Tractor @relation(fields: [tractorId], references: [id])
  farmer  Farmer  @relation(fields: [farmerId], references: [id])

  @@map("tractor_bookings")
}

// ============================================================
// ESCROW & TRUST
// ============================================================

model EscrowPayment {
  id                   String        @id @default(uuid())
  listingId            String        @map("listing_id")
  amount               Float
  status               PaymentStatus
  mpesaRef             String?       @map("mpesa_ref")
  // Collection (money in, via ClickPesa USSD push)
  orderReference       String?       @unique @map("order_reference")
  phoneNumber          String?       @map("phone_number")
  // Payout (money out, via ClickPesa Payout API)
  payoutOrderReference String?       @unique @map("payout_order_reference")
  payoutStatus         PayoutStatus? @map("payout_status")
  payoutRecipientId    String?       @map("payout_recipient_id")
  payoutFailureReason  String?       @map("payout_failure_reason")
  depositedAt          DateTime?     @map("deposited_at")
  releasedAt           DateTime?     @map("released_at")
  // Set only for a multi-year ANNUAL-plan installment (year 2, 3, ...) —
  // null means this is the original deposit that activates the lease.
  installmentYear      Int?          @map("installment_year")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  listing         LandListing @relation(fields: [listingId], references: [id])
  payoutRecipient Farmer?     @relation(fields: [payoutRecipientId], references: [id])

  @@map("escrow_payments")
}

// ============================================================
// MARKET DATA
// ============================================================

model MarketPrice {
  id         String   @id @default(uuid())
  commodity  String // e.g., "rice_sack_100kg"
  price      Float // In TZS
  market     String? // e.g., "Mafinga"
  source     String?
  recordedAt DateTime @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("market_prices")
}

// ============================================================
// AGRICULTURAL INSURANCE
// ============================================================

enum InsuranceProductType {
  AREA_YIELD
  WEATHER_INDEX
  MULTI_PERIL
  INPUT_INSURANCE
  CREDIT_LINKED
}

enum PolicyStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

enum ClaimStatus {
  SUBMITTED
  INSPECTING
  APPROVED
  REJECTED
  PAID
}

model InsuranceProvider {
  id            String   @id @default(uuid())
  name          String   @unique
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  policies InsurancePolicy[]

  @@map("insurance_providers")
}

model InsurancePolicy {
  id                  String               @id @default(uuid())
  farmerId            String               @map("farmer_id")
  farmId              String?              @map("farm_id")
  cropCycleId         String?              @map("crop_cycle_id")
  providerId          String               @map("provider_id")
  productType         InsuranceProductType @map("product_type")
  riceVariety         String?              @map("rice_variety")
  insuredAreaHectares Float                @map("insured_area_hectares")
  sumInsured          Float                @map("sum_insured")
  premiumAmount       Float                @map("premium_amount")
  status              PolicyStatus         @default(PENDING)
  startDate           DateTime?            @map("start_date")
  endDate             DateTime?            @map("end_date")
  renewedFromPolicyId String?              @map("renewed_from_policy_id")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  farmer            Farmer            @relation(fields: [farmerId], references: [id])
  farm              Farm?             @relation(fields: [farmId], references: [id])
  cropCycle         CropCycle?        @relation(fields: [cropCycleId], references: [id])
  provider          InsuranceProvider @relation(fields: [providerId], references: [id])
  claims            InsuranceClaim[]
  renewedFromPolicy InsurancePolicy?  @relation("PolicyRenewal", fields: [renewedFromPolicyId], references: [id])
  renewals          InsurancePolicy[] @relation("PolicyRenewal")

  @@map("insurance_policies")
}

model InsuranceClaim {
  id              String      @id @default(uuid())
  policyId        String      @map("policy_id")
  incidentDate    DateTime    @map("incident_date")
  incidentType    String      @map("incident_type") // e.g., flood, drought, pest, disease
  description     String?
  claimedAmount   Float       @map("claimed_amount")
  status          ClaimStatus @default(SUBMITTED)
  // Loose id reference (no @relation), matching Farmer.verifiedById/assignedOfficerId convention.
  inspectedById   String?     @map("inspected_by_id")
  inspectionNotes String?     @map("inspection_notes")
  inspectionDate  DateTime?   @map("inspection_date")
  paidAmount      Float?      @map("paid_amount")
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  policy InsurancePolicy @relation(fields: [policyId], references: [id])

  @@map("insurance_claims")
}

// ============================================================
// WEATHER & EARLY WARNING
// ============================================================

enum WeatherAlertType {
  FLOOD
  DROUGHT
  PEST
  DISEASE
  PLANTING_RECOMMENDATION
  IRRIGATION_RECOMMENDATION
  GENERAL
}

enum WeatherAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model WeatherAlert {
  id           String               @id @default(uuid())
  region       String?
  district     String?
  ward         String?
  alertType    WeatherAlertType     @map("alert_type")
  severity     WeatherAlertSeverity @default(MEDIUM)
  title        String
  message      String
  // Loose id reference (no @relation), matching Farmer.verifiedById convention.
  issuedById   String?              @map("issued_by_id")
  validFrom    DateTime             @default(now()) @map("valid_from")
  validUntil   DateTime?            @map("valid_until")
  smsSentCount Int                  @default(0) @map("sms_sent_count")
  createdAt    DateTime             @default(now()) @map("created_at")

  @@map("weather_alerts")
}

// ============================================================
// AUDIT & SYSTEM
// ============================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String // e.g., "farmer.create", "payment.release"
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SmsLog {
  id        String    @id @default(uuid())
  phone     String
  message   String
  type      String // "payment_confirmation", "alert", "notification"
  status    String    @default("pending")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("sms_logs")
}

model ConsentRecord {
  id                      String    @id @default(uuid())
  farmerId                String    @map("farmer_id")
  scope                   String
  granted                 Boolean   @default(true)
  formVersion             String    @default("MAYODATA_CONSENT_2026_07") @map("form_version")
  language                String    @default("sw")
  explanationReadByUserId String?   @map("explanation_read_by_user_id")
  signatureUrl            String?   @map("signature_url")
  thumbprintUrl           String?   @map("thumbprint_url")
  witnessName             String?   @map("witness_name")
  notes                   String?
  capturedAt              DateTime  @default(now()) @map("captured_at")
  revokedAt               DateTime? @map("revoked_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId, scope, capturedAt])
  @@map("consent_records")
}

model FarmerQuestionnaire {
  id                  String   @id @default(uuid())
  farmerId            String   @map("farmer_id")
  farmId              String?  @map("farm_id")
  fieldOfficerUserId  String?  @map("field_officer_user_id")
  formVersion         String   @default("MAYODATA_FIELD_QUESTIONNAIRE_2026_07") @map("form_version")
  language            String   @default("sw")
  officialUse         Json     @default("{}") @map("official_use")
  farmerSnapshot      Json     @default("{}") @map("farmer_snapshot")
  farmRegistration    Json     @default("{}") @map("farm_registration")
  plantingInputs      Json     @default("{}") @map("planting_inputs")
  midSeasonCosts      Json     @default("{}") @map("mid_season_costs")
  harvestSales        Json     @default("{}") @map("harvest_sales")
  consentAcknowledged Boolean  @default(false) @map("consent_acknowledged")
  signatureUrl        String?  @map("signature_url")
  photoUrls           String[] @map("photo_urls")
  gpsLatitude         Float?   @map("gps_latitude")
  gpsLongitude        Float?   @map("gps_longitude")
  capturedAt          DateTime @default(now()) @map("captured_at")
  createdAt           DateTime @default(now()) @map("created_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm   Farm?  @relation(fields: [farmId], references: [id], onDelete: SetNull)

  @@index([farmerId, capturedAt])
  @@index([farmId])
  @@map("farmer_questionnaires")
}

model AiIntegrationRecord {
  id                String   @id @default(uuid())
  sourceType        String   @map("source_type")
  farmId            String?  @map("farm_id")
  cropCycleId       String?  @map("crop_cycle_id")
  lotId             String?  @map("lot_id")
  externalReference String?  @map("external_reference")
  payload           Json     @default("{}")
  recommendation    Json?
  capturedByUserId  String?  @map("captured_by_user_id")
  capturedAt        DateTime @default(now()) @map("captured_at")
  createdAt         DateTime @default(now()) @map("created_at")

  farm      Farm?      @relation(fields: [farmId], references: [id], onDelete: SetNull)
  cropCycle CropCycle? @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
  lot       Lot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([sourceType, capturedAt])
  @@index([farmId])
  @@index([cropCycleId])
  @@index([lotId])
  @@map("ai_integration_records")
}

// ============================================================
// LOCATION: Tanzania Administrative Hierarchy (seeded from data.xlsx)
// ADM1 = Region, ADM2 = District, ADM3 = Ward
// ============================================================

model Region {
  id        String     @id @default(cuid())
  name      String     @unique
  districts District[]

  @@map("regions")
}

model District {
  id       String @id @default(cuid())
  name     String
  regionId String @map("region_id")
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  wards    Ward[]

  @@unique([name, regionId])
  @@map("districts")
}

model Ward {
  id         String   @id @default(cuid())
  name       String
  districtId String   @map("district_id")
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([name, districtId])
  @@map("wards")
}

// ============================================================
// PRODUCTION PLATFORM: Plots, Verification, Household, Documents
// ============================================================

model Plot {
  id                  String   @id @default(uuid())
  plotCode            String   @unique @map("plot_code") // e.g., FP-JD-01-P1
  farmId              String   @map("farm_id")
  name                String?
  sizeAcres           Float?   @map("size_acres")
  soilCondition       String?  @map("soil_condition")
  irrigationStatus    String?  @map("irrigation_status")
  currentStage        String?  @map("current_stage") // denormalized from active CropCycle
  boundaryCoordinates Json?    @map("boundary_coordinates")
  centerLatitude      Float?   @map("center_latitude")
  centerLongitude     Float?   @map("center_longitude")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  farm       Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  cropCycles CropCycle[]

  @@map("plots")
}

model FarmerVerification {
  id                String             @id @default(uuid())
  farmerId          String             @map("farmer_id")
  fieldOfficerId    String             @map("field_officer_id")
  status            VerificationStatus
  gpsVerified       Boolean            @default(false) @map("gps_verified")
  documentsReviewed Boolean            @default(false) @map("documents_reviewed")
  notes             String?
  rejectionReason   String?            @map("rejection_reason")
  gpsLatitude       Float?             @map("gps_latitude")
  gpsLongitude      Float?             @map("gps_longitude")
  verifiedAt        DateTime           @default(now()) @map("verified_at")

  farmer       Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  fieldOfficer MamcosStaff @relation(fields: [fieldOfficerId], references: [id])

  @@index([farmerId])
  @@map("farmer_verifications")
}

model Household {
  id                  String   @id @default(uuid())
  farmerId            String   @unique @map("farmer_id")
  householdSize       Int?     @map("household_size")
  dependents          Int?
  adultsCount         Int?     @map("adults_count")
  childrenCount       Int?     @map("children_count")
  primaryIncomeSource String?  @map("primary_income_source")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("households")
}

model Document {
  id           String       @id @default(uuid())
  type         DocumentType
  fileUrl      String       @map("file_url")
  fileName     String       @map("file_name")
  mimeType     String?      @map("mime_type")
  sizeBytes    Int?         @map("size_bytes")
  farmerId     String?      @map("farmer_id")
  farmId       String?      @map("farm_id")
  uploadedById String?      @map("uploaded_by_id")
  verified     Boolean      @default(false)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  farmer Farmer? @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm   Farm?   @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmerId])
  @@index([farmId])
  @@map("documents")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String // e.g., "verification.pending", "activity.delayed"
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// Lightweight audit trail of farmer-facing actions, shown as the "Recent
// Activities" feed on the mobile dashboard (farm/plot/document events).
model Activity {
  id        String   @id @default(uuid())
  farmerId  String   @map("farmer_id")
  type      String // e.g., "farm.created", "plot.mapped"
  title     String
  subtitle  String?
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId, createdAt])
  @@map("activities")
}

// A field officer's timestamped record of visiting a farmer (routine check,
// helping with a farming activity, in-person verification, etc.). visitedAt
// is always server-set at submission time — never client-supplied — so it
// stays a trustworthy audit trail even though the officer's own draft may be
// composed earlier (e.g. offline in the field).
enum FieldOfficerVisitPurpose {
  ROUTINE_CHECK
  FARMING_ASSISTANCE
  VERIFICATION
  DISPUTE_FOLLOWUP
  TRAINING
  OTHER
}

model FieldOfficerVisit {
  id             String                   @id @default(uuid())
  fieldOfficerId String                   @map("field_officer_id")
  farmerId       String                   @map("farmer_id")
  farmId         String?                  @map("farm_id")
  cropCycleId    String?                  @map("crop_cycle_id")
  purpose        FieldOfficerVisitPurpose @default(ROUTINE_CHECK)
  notes          String?
  photoUrls      String[]                 @map("photo_urls")
  gpsLatitude    Float?                   @map("gps_latitude")
  gpsLongitude   Float?                   @map("gps_longitude")
  visitedAt      DateTime                 @map("visited_at")
  createdAt      DateTime                 @default(now()) @map("created_at")

  fieldOfficer MamcosStaff @relation(fields: [fieldOfficerId], references: [id], onDelete: Cascade)
  farmer       Farmer      @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farm         Farm?       @relation(fields: [farmId], references: [id])
  cropCycle    CropCycle?  @relation(fields: [cropCycleId], references: [id])

  @@index([fieldOfficerId, visitedAt])
  @@index([farmerId, visitedAt])
  @@map("field_officer_visits")
}

// ============================================================
// SEASONS, OWNERSHIP, LEASES & SEASONAL ASSIGNMENTS
// ============================================================

model FarmingSeason {
  id                    String              @id @default(uuid())
  name                  String              @unique // e.g., "2026/2027 Masika"
  mamcosId              String?             @map("mamcos_id")
  region                String?
  crop                  String?
  startDate             DateTime            @map("start_date")
  endDate               DateTime            @map("end_date")
  registrationOpenDate  DateTime?           @map("registration_open_date")
  registrationCloseDate DateTime?           @map("registration_close_date")
  verificationDeadline  DateTime?           @map("verification_deadline")
  status                FarmingSeasonStatus @default(DRAFT)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  mamcos          Mamcos?                  @relation(fields: [mamcosId], references: [id])
  memberships     Membership[]
  leases          FarmLease[]
  assignments     SeasonalFarmAssignment[]
  rewardCampaigns RewardCampaign[]
  disputes        Dispute[]

  @@map("farming_seasons")
}

// Legal owner record — independent of who farms the land in a season.
model FarmOwnership {
  id                 String             @id @default(uuid())
  farmId             String             @map("farm_id")
  ownerFarmerId      String?            @map("owner_farmer_id")
  ownerName          String?            @map("owner_name")
  ownerPhone         String?            @map("owner_phone")
  source             OwnershipSource    @default(OWNER)
  confirmationStatus VerificationStatus @default(PENDING) @map("confirmation_status")
  confirmedAt        DateTime?          @map("confirmed_at")
  verifiedByUserId   String?            @map("verified_by_user_id")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  farm        Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ownerFarmer Farmer? @relation("LegalOwner", fields: [ownerFarmerId], references: [id])

  @@index([farmId])
  @@map("farm_ownerships")
}

model FarmLease {
  id                        String             @id @default(uuid())
  farmId                    String             @map("farm_id")
  ownerFarmerId             String?            @map("owner_farmer_id")
  renterFarmerId            String?            @map("renter_farmer_id")
  renterName                String?            @map("renter_name")
  renterPhone               String             @map("renter_phone")
  farmingSeasonId           String             @map("farming_season_id")
  leaseStartDate            DateTime           @map("lease_start_date")
  leaseEndDate              DateTime           @map("lease_end_date")
  ownerConfirmationStatus   VerificationStatus @default(PENDING) @map("owner_confirmation_status")
  renterConfirmationStatus  VerificationStatus @default(PENDING) @map("renter_confirmation_status")
  officerConfirmationStatus VerificationStatus @default(PENDING) @map("officer_confirmation_status")
  status                    LeaseStatus        @default(PENDING_VERIFICATION)
  notes                     String?
  agreementDocumentUrl      String?            @map("agreement_document_url")

  // Officer-assisted verification evidence trail (prompt.md §10 / prompt2.md §23).
  officerVerificationMethod OfficerVerificationMethod? @map("officer_verification_method")
  officerContactedName      String?                    @map("officer_contacted_name")
  officerContactedPhone     String?                    @map("officer_contacted_phone")
  officerEvidenceUrls       String[]                   @map("officer_evidence_urls")
  officerDecidedAt          DateTime?                  @map("officer_decided_at")
  officerDecidedByUserId    String?                    @map("officer_decided_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farm          Farm                     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ownerFarmer   Farmer?                  @relation("LeaseOwner", fields: [ownerFarmerId], references: [id])
  renterFarmer  Farmer?                  @relation("LeaseRenter", fields: [renterFarmerId], references: [id])
  farmingSeason FarmingSeason            @relation(fields: [farmingSeasonId], references: [id])
  assignments   SeasonalFarmAssignment[]
  disputes      Dispute[]

  @@index([farmId, farmingSeasonId])
  @@index([renterPhone])
  @@map("farm_leases")
}

// Who actively farms a given farm in a given season (owner or verified renter).
model SeasonalFarmAssignment {
  id              String             @id @default(uuid())
  farmId          String             @map("farm_id")
  farmingSeasonId String             @map("farming_season_id")
  activeFarmerId  String             @map("active_farmer_id")
  leaseId         String?            @map("lease_id")
  assignmentType  AssignmentType     @map("assignment_type")
  status          VerificationStatus @default(PENDING)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  farm          Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmingSeason FarmingSeason @relation(fields: [farmingSeasonId], references: [id])
  activeFarmer  Farmer        @relation("ActiveFarmer", fields: [activeFarmerId], references: [id])
  lease         FarmLease?    @relation(fields: [leaseId], references: [id])

  // One primary seasonal operator per farm and season (data-integrity rule).
  @@unique([farmId, farmingSeasonId])
  @@map("seasonal_farm_assignments")
}

// ============================================================
// MEMBERSHIP (free registration, paid analytics)
// ============================================================

model MembershipPlan {
  id           String                 @id @default(uuid())
  name         String                 @unique
  description  String?
  priceTzs     Float                  @map("price_tzs")
  durationType MembershipDurationType @default(SEASON) @map("duration_type")
  features     String[]
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("membership_plans")
}

model Membership {
  id                   String           @id @default(uuid())
  userId               String           @map("user_id")
  farmerId             String?          @map("farmer_id")
  planId               String           @map("plan_id")
  farmingSeasonId      String?          @map("farming_season_id")
  status               MembershipStatus @default(PAYMENT_PENDING)
  paymentStatus        PaymentStatus    @default(PENDING) @map("payment_status")
  paymentReference     String?          @map("payment_reference")
  orderReference       String?          @unique @map("order_reference") // ClickPesa order reference
  amountTzs            Float?           @map("amount_tzs")
  startDate            DateTime?        @map("start_date")
  endDate              DateTime?        @map("end_date")
  activatedAt          DateTime?        @map("activated_at")
  expiryReminderSentAt DateTime?        @map("expiry_reminder_sent_at")
  approvedByUserId     String?          @map("approved_by_user_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmer        Farmer?        @relation(fields: [farmerId], references: [id])
  plan          MembershipPlan @relation(fields: [planId], references: [id])
  farmingSeason FarmingSeason? @relation(fields: [farmingSeasonId], references: [id])
  payments      Payment[]

  @@index([userId, status])
  @@map("memberships")
}

// ============================================================
// FARM-ACTION ALERTS (free preview, premium recommendation)
// ============================================================

model FarmAlert {
  id                 String        @id @default(uuid())
  farmId             String        @map("farm_id")
  plotId             String?       @map("plot_id")
  farmerId           String?       @map("farmer_id") // active/target farmer
  farmingSeasonId    String?       @map("farming_season_id")
  cropCycleId        String?       @map("crop_cycle_id")
  category           AlertCategory
  urgency            AlertUrgency  @default(MEDIUM)
  title              String
  // Shown to everyone (free preview): what & where, no diagnosis.
  previewMessage     String        @map("preview_message")
  // Premium-only: stripped from API responses for non-members.
  recommendation     String?
  actionDetails      String?       @map("action_details")
  expectedActionDate DateTime?     @map("expected_action_date")
  // Dedupe key so the generator doesn't repeat the same open alert.
  dedupeKey          String?       @map("dedupe_key")
  status             AlertStatus   @default(OPEN)
  completedAt        DateTime?     @map("completed_at")
  completedByUserId  String?       @map("completed_by_user_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([farmId, status])
  @@map("farm_alerts")
}

// ============================================================
// FARMER REWARDS & INCENTIVES (auditable selection)
// ============================================================

model RewardCampaign {
  id                   String               @id @default(uuid())
  name                 String
  description          String?
  sponsor              String?
  rewardType           RewardType           @map("reward_type")
  rewardQuantity       Int                  @default(1) @map("reward_quantity") // per winner
  numberOfWinners      Int                  @default(1) @map("number_of_winners")
  farmingSeasonId      String?              @map("farming_season_id")
  eligibleCooperatives String[]             @map("eligible_cooperatives")
  eligibilityStartDate DateTime?            @map("eligibility_start_date")
  eligibilityEndDate   DateTime?            @map("eligibility_end_date")
  selectionMethod      SelectionMethod      @default(RANDOM) @map("selection_method")
  status               RewardCampaignStatus @default(DRAFT)

  // Auditable selection record (prompt §16): reproducible from seed + snapshot.
  selectionSeed             String?   @map("selection_seed")
  selectionAlgorithmVersion String?   @map("selection_algorithm_version")
  eligibleSnapshot          Json?     @map("eligible_snapshot") // farmer ids considered
  selectedAt                DateTime? @map("selected_at")
  createdByUserId           String?   @map("created_by_user_id")
  approvedByUserId          String?   @map("approved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farmingSeason FarmingSeason? @relation(fields: [farmingSeasonId], references: [id])
  winners       RewardWinner[]

  @@map("reward_campaigns")
}

model RewardWinner {
  id          String             @id @default(uuid())
  campaignId  String             @map("campaign_id")
  farmerId    String             @map("farmer_id")
  farmId      String?            @map("farm_id")
  rewardType  RewardType         @map("reward_type")
  quantity    Int                @default(1)
  status      RewardWinnerStatus @default(SELECTED)
  notifiedAt  DateTime?          @map("notified_at")
  confirmedAt DateTime?          @map("confirmed_at")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  campaign RewardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  farmer   Farmer         @relation(fields: [farmerId], references: [id])

  // One award per farmer per campaign (no duplicate winners).
  @@unique([campaignId, farmerId])
  @@index([farmerId])
  @@map("reward_winners")
}

// ============================================================
// AMCOS-FIRST FARM REGISTRY (pre-registration before owner has an account)
// ============================================================

// A farm pre-registered by a cooperative (prompt2 §2, §22). It exists before the
// owner has an account; when the owner registers and confirms, it is materialized
// into a real Farm (`farmId` links the two).
model FarmRegistryRecord {
  id                String             @id @default(uuid())
  sourceMamcosId    String?            @map("source_mamcos_id")
  sourceOfficerId   String?            @map("source_officer_id") // user id who entered it
  ownerName         String             @map("owner_name")
  ownerPhone        String             @map("owner_phone")
  ownerNationalId   String?            @map("owner_national_id")
  name              String?
  plotNumber        String?            @map("plot_number")
  block             String?
  canal             String?
  scheme            String?
  section           String?
  village           String?
  ward              String?
  district          String?
  region            String?
  farmSizeHectares  Float?             @map("farm_size_hectares")
  status            FarmRegistryStatus @default(OWNER_CONFIRMATION_PENDING)
  notes             String?
  farmId            String?            @unique @map("farm_id") // set once claimed/materialized
  claimedByFarmerId String?            @map("claimed_by_farmer_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  mamcos               Mamcos?                    @relation(fields: [sourceMamcosId], references: [id])
  confirmationRequests OwnerConfirmationRequest[]

  @@index([ownerPhone, status])
  @@map("farm_registry_records")
}

// Expiring, auditable owner-confirmation request sent by SMS/USSD/app
// (prompt2 §5 / prompt.md §10): records the exact message sent, the channel,
// and the eventual response so a stale or repeated request can't be replayed.
model OwnerConfirmationRequest {
  id               String                    @id @default(uuid())
  farmId           String?                   @map("farm_id")
  registryRecordId String?                   @map("registry_record_id")
  phone            String
  channel          ConfirmationChannel       @default(SMS)
  message          String
  status           ConfirmationRequestStatus @default(SENT)
  response         String?
  resendCount      Int                       @default(0) @map("resend_count")
  sentAt           DateTime                  @default(now()) @map("sent_at")
  expiresAt        DateTime                  @map("expires_at")
  respondedAt      DateTime?                 @map("responded_at")
  createdAt        DateTime                  @default(now()) @map("created_at")

  farm           Farm?               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  registryRecord FarmRegistryRecord? @relation(fields: [registryRecordId], references: [id], onDelete: Cascade)

  @@index([phone, status])
  @@index([farmId])
  @@index([registryRecordId])
  @@map("owner_confirmation_requests")
}

// A farmer- or officer-submitted correction to a farm field. Never overwrites
// verified data silently (prompt2 §19) — held for review, then merged.
model SuggestedFarmUpdate {
  id                String                @id @default(uuid())
  farmId            String                @map("farm_id")
  submittedByUserId String?               @map("submitted_by_user_id")
  fieldName         String                @map("field_name")
  currentValue      String?               @map("current_value")
  suggestedValue    String                @map("suggested_value")
  evidenceUrls      String[]              @map("evidence_urls")
  reviewStatus      SuggestedUpdateStatus @default(PENDING) @map("review_status")
  reviewedByUserId  String?               @map("reviewed_by_user_id")
  reviewNotes       String?               @map("review_notes")
  reviewedAt        DateTime?             @map("reviewed_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, reviewStatus])
  @@map("suggested_farm_updates")
}

// Source-tracked value for a single farm attribute (prompt2 §16/§18). Multiple
// sources may report the same field; conflicting values are flagged rather
// than silently overwritten, and an officer picks the approved final value.
model FarmDataValue {
  id                 String             @id @default(uuid())
  farmId             String             @map("farm_id")
  fieldName          String             @map("field_name")
  value              String
  sourceType         FarmDataSource     @map("source_type")
  sourceId           String?            @map("source_id")
  confidenceLevel    Int?               @map("confidence_level") // 0–100
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  hasConflict        Boolean            @default(false) @map("has_conflict")
  recordedAt         DateTime           @default(now()) @map("recorded_at")
  verifiedAt         DateTime?          @map("verified_at")
  supersededById     String?            @map("superseded_by_id")

  farm         Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  supersededBy FarmDataValue?  @relation("FarmDataValueSupersedes", fields: [supersededById], references: [id])
  supersedes   FarmDataValue[] @relation("FarmDataValueSupersedes")

  @@index([farmId, fieldName])
  @@map("farm_data_values")
}

// Ownership/rental/boundary dispute (prompt.md §22). While OPEN, sensitive
// farm access (leasing, ownership confirmation) is restricted until an
// authorized officer resolves it.
model Dispute {
  id                String        @id @default(uuid())
  farmId            String?       @map("farm_id")
  leaseId           String?       @map("lease_id")
  farmingSeasonId   String?       @map("farming_season_id")
  type              DisputeType
  description       String
  claimantIds       String[]      @map("claimant_ids")
  evidenceUrls      String[]      @map("evidence_urls")
  raisedByUserId    String?       @map("raised_by_user_id")
  assignedOfficerId String?       @map("assigned_officer_id")
  status            DisputeStatus @default(OPEN)
  resolution        String?
  resolvedByUserId  String?       @map("resolved_by_user_id")
  resolvedAt        DateTime?     @map("resolved_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  farm          Farm?          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  lease         FarmLease?     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  farmingSeason FarmingSeason? @relation(fields: [farmingSeasonId], references: [id])

  @@index([farmId, status])
  @@map("disputes")
}

// ============================================================
// FARM MEDIA & FIELD DATA (for the printable analytics report)
// ============================================================

model FarmPhoto {
  id           String   @id @default(uuid())
  farmId       String   @map("farm_id")
  url          String
  caption      String?
  latitude     Float?
  longitude    Float?
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@map("farm_photos")
}

// One field visit's data (owner comment §2.6 / prompt2 §15): GPS, soil, road &
// water access, and physical characteristics collected by a MAYODE officer.
model FarmFieldSurvey {
  id           String         @id @default(uuid())
  farmId       String         @map("farm_id")
  surveyedById String?        @map("surveyed_by_id")
  surveyDate   DateTime       @default(now()) @map("survey_date")
  source       FarmDataSource @default(FIELD_OFFICER)

  // Soil
  soilPh            Float?  @map("soil_ph")
  soilTexture       String? @map("soil_texture")
  soilOrganicMatter Float?  @map("soil_organic_matter") // %
  soilNotes         String? @map("soil_notes")

  // Road & water access
  roadDistanceMeters  Int?    @map("road_distance_meters")
  roadAccessQuality   String? @map("road_access_quality") // GOOD | FAIR | POOR
  waterSource         String? @map("water_source")
  waterDistanceMeters Int?    @map("water_distance_meters")
  waterReliability    String? @map("water_reliability")

  // Physical
  slope        String?
  floodRisk    String? @map("flood_risk")
  observations String?
  latitude     Float?
  longitude    Float?

  createdAt DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@map("farm_field_surveys")
}

