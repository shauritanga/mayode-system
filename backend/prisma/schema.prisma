// ============================================================
// WAREHOUSE, STOCK LEDGER, SALE ORDERS & DELIVERY
// Workflow: salesperson reserves stock for a buyer (reference issued) ->
// warehouse keeper confirms and releases against that reference -> transport is
// arranged when the buyer has none. Every step records the acting user and time
// (SaleOrderEvent), and stock only changes through append-only StockMovement rows.
// ============================================================

enum SaleOrderStatus {
  RESERVED
  CONFIRMED
  PARTIALLY_RELEASED
  RELEASED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  IN
  RESERVE
  UNRESERVE
  OUT
  ADJUST
}

