# ============================================================
# MAYODE GROUP Integrated System — Backend .env Template
# Copy this to .env and fill in your values
# ============================================================

PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mayode_db?schema=public"

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

AT_API_KEY=your_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=MAYODE

MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://api.mayodegroup.com/mpesa/callback

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

CONTROL_NUMBER_PREFIX=MYD

# ClickPesa mobile-money payments (https://docs.clickpesa.com)
# Obtain client-id / api-key from the ClickPesa dashboard (API Integration is in beta —
# contact tech@clickpesa.com for access). Leave CLIENT_ID/API_KEY blank to fall back to
# manual admin approval of memberships.
CLICKPESA_BASE_URL=https://api.clickpesa.com
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# Optional: enables HMAC-SHA256 request checksums and lets you validate webhook checksums.
CLICKPESA_CHECKSUM_KEY=
# Configure this public URL as the webhook in your ClickPesa dashboard:
#   https://<your-host>/api/v1/payments/clickpesa/webhook

# Africa's Talking SMS + USSD (feature-phone support; https://africastalking.com)
# Leave AT_USERNAME/AT_API_KEY blank to simulate SMS (logged to SmsLog) in dev/demo.
# Sandbox: AT_USERNAME=sandbox, AT_BASE_URL=https://api.sandbox.africastalking.com
AT_BASE_URL=https://api.africastalking.com
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Configure these callback URLs in the Africa's Talking dashboard:
#   SMS inbound: https://<host>/api/v1/messaging/sms/inbound
#   USSD:        https://<host>/api/v1/messaging/ussd

# Expo push notifications (server-side delivery; only the device token is needed).
# Optional: set an Expo access token for enhanced security. Leave blank to send
# unauthenticated (works for standard Expo push tokens).
# EXPO_ACCESS_TOKEN=

# Farm-alert generation schedule (cron). Default: daily at 06:00. Example every
# 2 seconds for testing: ALERTS_CRON="*/2 * * * * *"
# ALERTS_CRON=0 6 * * *
