{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:admin",
    "build": "npm run build:all-modes",
    "start": "npm run start:admin",
    "lint": "eslint src apps config",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "dev:farmers": "npm run dev --workspace=@mayode/farmers",
    "build:farmers": "npm run build --workspace=@mayode/farmers",
    "start:farmers": "npm run start --workspace=@mayode/farmers",
    "dev:cooperatives": "npm run dev --workspace=@mayode/cooperatives",
    "build:cooperatives": "npm run build --workspace=@mayode/cooperatives",
    "start:cooperatives": "npm run start --workspace=@mayode/cooperatives",
    "dev:admin": "npm run dev --workspace=@mayode/admin",
    "build:admin": "npm run build --workspace=@mayode/admin",
    "start:admin": "npm run start --workspace=@mayode/admin",
    "build:all-modes": "npm run build --workspaces",
    "test:smoke": "node tests/portals.smoke.cjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-query": "^5.101.1",
    "@types/leaflet": "^1.9.22",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "motion": "^13.1.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*"
  ]
}
